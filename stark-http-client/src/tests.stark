// HC8 tests, pure half.
//
// The client is capability-bearing, and `stark test` runs on the HIR interpreter, which has NO
// provider layer — no socket in this process can be opened, at all. So this file covers exactly
// what is decidable without one: URL targeting, configuration, and the request the flow would put
// on the wire. The socket path — connect, write, read, close, timeouts, early close — is covered by
// `stark-http-client-consumer`, which is native-only and requires a real HTTP peer, per the CD-348
// category rule that a resource-shaped package needs observed lifecycle, not just linkage.

use super::default_config;
use super::get;
use super::new_client;
use super::parse_url;
use super::post;
use super::HttpError;
use super::Scheme;
use super::Target;
use super::HttpMethod;

fn expect(condition: Bool, message: &str) {
    if !condition {
        panic(message);
    }
}

fn target_of(url: &str) -> Target {
    let out: Target;
    match parse_url(url) {
        Ok(target) => {
            out = target;
        }
        Err(_error) => {
            panic("a well-formed URL was refused");
        }
    }
    out
}

fn expect_url_rejected(url: &str) {
    match parse_url(url) {
        Ok(_target) => {
            panic("a malformed URL was accepted");
        }
        Err(_error) => {}
    }
}

// -- URL targeting ------------------------------------------------------------------------------

fn test_default_port_is_80() {
    let target = target_of("http://example.com/");
    expect(target.host.as_str() == "example.com", "host wrong");
    expect(target.port == 80u16, "default port must be 80");
    expect(target.path_and_query.as_str() == "/", "path wrong");
}

fn test_explicit_port() {
    let target = target_of("http://example.com:8080/index.html");
    expect(target.port == 8080u16, "explicit port not honoured");
    expect(target.path_and_query.as_str() == "/index.html", "path wrong with a port");
}

fn test_empty_path_becomes_root() {
    let target = target_of("http://example.com");
    expect(target.path_and_query.as_str() == "/", "an absent path must become /");
}

fn test_query_is_kept_with_the_path() {
    let target = target_of("http://example.com/search?q=stark&n=2");
    expect(
        target.path_and_query.as_str() == "/search?q=stark&n=2",
        "query dropped from the request target",
    );
}

fn test_fragment_is_not_sent() {
    // A fragment is client-side only. Sending it is an information leak, so it must be stripped
    // before the request target is formed.
    let target = target_of("http://example.com/page#section");
    expect(target.path_and_query.as_str() == "/page", "a fragment reached the request target");
}

fn test_ipv4_literal_host() {
    let target = target_of("http://127.0.0.1:9000/x");
    expect(target.host.as_str() == "127.0.0.1", "IPv4 literal host wrong");
    expect(target.port == 9000u16, "IPv4 literal port wrong");
}

fn test_https_is_accepted_and_defaults_to_443() {
    // HC10. HC8 refused this, and refusing loudly was right THEN — a client that quietly speaks
    // cleartext where TLS was asked for is a security defect. What changed is that the secure path
    // now exists; the refusal has not been relaxed, it has been satisfied.
    match parse_url("https://example.com/v1/items") {
        Ok(target) => {
            match target.scheme {
                Scheme::Https => {}
                Scheme::Http => {
                    panic("https:// must parse as the secure scheme");
                }
            }
            if target.port != 443u16 {
                panic("https:// must default to port 443");
            }
            if target.host.as_str() != "example.com" {
                panic("https:// host wrong");
            }
            if target.path_and_query.as_str() != "/v1/items" {
                panic("https:// path wrong");
            }
        }
        Err(_error) => {
            panic("https:// must now be accepted");
        }
    }
}

fn test_http_still_defaults_to_80() {
    // The two defaults must not be confused: `Host` omits the port only when it matches the
    // scheme's default, so a wrong default silently changes every request's Host header.
    match parse_url("http://example.com/") {
        Ok(target) => {
            match target.scheme {
                Scheme::Http => {}
                Scheme::Https => {
                    panic("http:// must parse as the plain scheme");
                }
            }
            if target.port != 80u16 {
                panic("http:// must default to port 80");
            }
        }
        Err(_error) => {
            panic("http:// must be accepted");
        }
    }
}

fn test_an_explicit_port_overrides_the_scheme_default() {
    match parse_url("https://example.com:8443/x") {
        Ok(target) => {
            if target.port != 8443u16 {
                panic("an explicit port must win over the scheme default");
            }
        }
        Err(_error) => {
            panic("an explicit https port must parse");
        }
    }
}

fn test_the_scheme_is_matched_exactly() {
    // `httpx://`, `htt://` and a bare `https:/` must not be mistaken for either scheme. A prefix
    // test that stopped at "http" would accept the first of these as cleartext.
    expect_url_rejected("httpx://example.com/");
    expect_url_rejected("htt://example.com/");
    expect_url_rejected("HTTPS://example.com/");
}

fn test_other_schemes_are_refused() {
    expect_url_rejected("ftp://example.com/");
    expect_url_rejected("file:///etc/passwd");
    expect_url_rejected("//example.com/");
    expect_url_rejected("example.com/");
}

fn test_malformed_urls_are_refused() {
    expect_url_rejected("http://");
    expect_url_rejected("http:///path");
    expect_url_rejected("http://example.com:/");
    expect_url_rejected("http://example.com:abc/");
    expect_url_rejected("http://example.com:99999/");
    expect_url_rejected("http://exa mple.com/");
}

fn test_port_zero_is_refused() {
    expect_url_rejected("http://example.com:0/");
}

// -- configuration ------------------------------------------------------------------------------

fn test_default_config_has_finite_budgets() {
    let config = default_config();
    expect(config.connect_timeout.seconds() > 0u64, "connect timeout must be finite and non-zero");
    expect(config.read_timeout.seconds() > 0u64, "read timeout must be non-zero");
    expect(config.write_timeout.seconds() > 0u64, "write timeout must be non-zero");
    expect(
        config.max_response_bytes > 0u64,
        "an unbounded response cap is a memory-exhaustion hole",
    );
    expect(!config.follow_redirects, "v0.1 does not follow redirects, and the default must say so");
}

fn test_client_carries_parser_limits() {
    let client = new_client(default_config());
    expect(client.limits.max_body_bytes > 0u64, "the client must hand bounded limits to the parser");
    expect(client.limits.max_header_count > 0u64, "header count must be bounded");
}

// -- builders -----------------------------------------------------------------------------------

fn test_get_builder_shape() {
    let builder = get("http://example.com/x");
    match builder.method {
        HttpMethod::Get => {}
        _other => {
            panic("get() built a non-GET request");
        }
    }
    expect(builder.body.len() == 0u64, "a GET built with a body");
    expect(builder.headers.entries.len() == 0u64, "a GET built with headers");
}

fn test_post_builder_keeps_the_body() {
    let mut body: Vec<UInt8> = Vec::new();
    body.push(104u8);
    body.push(105u8);
    let builder = post("http://example.com/x", body);
    match builder.method {
        HttpMethod::Post => {}
        _other => {
            panic("post() built a non-POST request");
        }
    }
    expect(builder.body.len() == 2u64, "the POST body was not carried");
}

// --- HC10: the error taxonomy and the scheme -------------------------------------------------

use super::default_port;
use super::error_text;
use super::timeout_phase_text;
use super::HttpTimeoutPhase;

fn test_the_scheme_defaults_differ() {
    // If these were ever equal, `Host` would carry a port for one scheme and not the other and
    // nothing would notice until a vhost stopped matching.
    if default_port(&Scheme::Http) != 80u16 {
        panic("http default port must be 80");
    }
    if default_port(&Scheme::Https) != 443u16 {
        panic("https default port must be 443");
    }
}

fn test_every_timeout_phase_reads_differently() {
    // A bare "timed out" is nearly useless to act on: resolution, connection, handshake, request
    // and response are fixed in different places. Five phases, five distinct descriptions.
    let all = [
        timeout_phase_text(&HttpTimeoutPhase::Resolve),
        timeout_phase_text(&HttpTimeoutPhase::Connect),
        timeout_phase_text(&HttpTimeoutPhase::TlsHandshake),
        timeout_phase_text(&HttpTimeoutPhase::WriteRequest),
        timeout_phase_text(&HttpTimeoutPhase::ReadResponse),
    ];
    let mut i: UInt64 = 0u64;
    while i < 5u64 {
        if all[i].len() == 0u64 {
            panic("every timeout phase must have a description");
        }
        let mut j: UInt64 = i + 1u64;
        while j < 5u64 {
            if all[i].as_str() == all[j].as_str() {
                panic("two timeout phases share a description");
            }
            j = j + 1u64;
        }
        i = i + 1u64;
    }
}

fn test_a_timeout_error_names_its_phase() {
    // The phase must reach the rendered message. An error that says only "timed out" sends an
    // operator looking in the wrong place.
    let rendered = error_text(&HttpError::Timeout(HttpTimeoutPhase::TlsHandshake));
    if rendered.as_str() != "timed out the TLS handshake" {
        panic("a timeout error must name the phase it happened in");
    }
    let reading = error_text(&HttpError::Timeout(HttpTimeoutPhase::ReadResponse));
    if reading.as_str() == rendered.as_str() {
        panic("two phases must not render the same error text");
    }
}

fn test_the_scheme_refusal_names_both_supported_schemes() {
    // The message a caller sees when they pass `ftp://` has to say what IS accepted, or the next
    // thing they try is a guess.
    let rendered = error_text(&HttpError::UnsupportedScheme);
    if rendered.as_str() != "only http:// and https:// are supported" {
        panic("the unsupported-scheme message must name both supported schemes");
    }
}

// --- HC11: the JSON convenience API -----------------------------------------------------------

use super::is_json_content_type;
use super::json_body_error_text;
use super::JsonBodyError;
use super::append_validated;
use super::get_first;
use super::new_header_map;
use super::HttpResponse;
use super::HttpVersion;
use super::encode;
use super::JsonValue;

fn json_response(content_type: &str, body_text: &str) -> HttpResponse {
    let mut headers = new_header_map();
    if content_type.bytes().len() > 0u64 {
        match append_validated(&mut headers, "Content-Type", content_type) {
            Ok(_added) => {}
            Err(_error) => {
                panic("test header must be valid");
            }
        }
    }
    let mut body: Vec<UInt8> = Vec::new();
    let bytes = body_text.bytes();
    let mut i = 0u64;
    while i < bytes.len() {
        body.push(bytes[i]);
        i = i + 1u64;
    }
    HttpResponse {
        version: HttpVersion::Http11,
        status: 200u16,
        reason: String::from("OK"),
        headers: headers,
        body: body,
    }
}

fn test_a_json_body_is_encoded_and_declared() {
    // The request builder must do BOTH things: carry the bytes and say what they are. A body
    // without the header is what a server rejects with 415 and a developer debugs for an hour.
    let value = JsonValue::String(String::from("hi"));
    match get("http://example.com/x").json(&value) {
        Ok(builder) => {
            if builder.body.len() != 4u64 {
                panic("the encoded body must be the JSON text");
            }
            match get_first(&builder.headers, "content-type") {
                Some(seen) => {
                    if seen.as_str() != "application/json" {
                        panic("json() must declare application/json");
                    }
                }
                None => {
                    panic("json() must set a Content-Type");
                }
            }
        }
        Err(_error) => {
            panic("a JSON body must attach");
        }
    }
}

fn test_a_json_response_parses() {
    let response = json_response("application/json", "{\"a\":1}");
    match response.json() {
        Ok(value) => match value {
            JsonValue::Object(members) => {
                if members.len() != 1u64 {
                    panic("the parsed object must have one member");
                }
            }
            _other => {
                panic("the body is an object");
            }
        }
        Err(_error) => {
            panic("valid JSON must parse");
        }
    }
}

fn test_unicode_survives_the_round_trip() {
    // A four-byte scalar through encode -> bytes -> decode -> parse. This is the path that a
    // Latin-1 shortcut in the decoder would corrupt while every ASCII test still passed.
    let response = json_response("application/json", "{\"emoji\":\"😀\"}");
    match response.json() {
        Ok(value) => match value {
            JsonValue::Object(members) => {
                // Re-ENCODED rather than destructured. Matching `members[0]` by value moves out
                // of an indexed place, and binding the payload through a reference is refused too
                // ("bind by reference or match a Copy field instead"). Comparing the re-encoded
                // value is the stronger assertion anyway: it exercises decode AND encode, so a
                // decoder and an encoder that were wrong in the same direction could not agree
                // their way past it.
                let first = &members[0u64];
                if first.key.as_str() != "emoji" {
                    panic("the member key did not survive");
                }
                if encode(&first.value).as_str() != "\"😀\"" {
                    panic("the four-byte scalar did not survive");
                }
            }
            _other => {
                panic("the body is an object");
            }
        }
        Err(_error) => {
            panic("unicode JSON must parse");
        }
    }
}

fn test_invalid_json_is_reported_as_invalid() {
    let response = json_response("application/json", "{\"a\":");
    match response.json() {
        Ok(_value) => {
            panic("truncated JSON must not parse");
        }
        Err(error) => match error {
            JsonBodyError::Invalid(_why) => {}
            _other => {
                panic("malformed JSON must be reported as Invalid, not as a decode or type error");
            }
        }
    }
}

fn test_an_empty_body_is_not_valid_json() {
    // Empty is valid UTF-8 and is NOT valid JSON. A client that returned Null here would invent a
    // value the server never sent.
    let response = json_response("application/json", "");
    match response.json() {
        Ok(_value) => {
            panic("an empty body must not parse as JSON");
        }
        Err(error) => match error {
            JsonBodyError::Invalid(_why) => {}
            _other => {
                panic("an empty body is a JSON error, not a decode error");
            }
        }
    }
}

fn test_the_content_type_policy_has_two_settings() {
    // Mislabelled JSON: `json()` accepts it, `json_checked()` refuses. Both behaviours are
    // deliberate, so both are pinned — a change to either is a change a reader should see.
    let response = json_response("text/plain", "{\"a\":1}");
    match response.json() {
        Ok(_value) => {}
        Err(_error) => {
            panic("json() must not require a content type");
        }
    }
    match response.json_checked() {
        Ok(_value) => {
            panic("json_checked() must require a JSON content type");
        }
        Err(error) => match error {
            JsonBodyError::UnexpectedContentType(seen) => {
                if seen.as_str() != "text/plain" {
                    panic("the refusal must quote what the server actually said");
                }
            }
            _other => {
                panic("a mislabelled body must be a content-type error");
            }
        }
    }

    // An absent content type is refused by the strict form too, and says so distinctly.
    let bare = json_response("", "{\"a\":1}");
    match bare.json_checked() {
        Ok(_value) => {
            panic("an absent content type must be refused by the strict form");
        }
        Err(_error) => {}
    }
}

fn test_a_charset_parameter_is_still_json() {
    // `application/json; charset=utf-8` is the same media type. A client that refused it would be
    // wrong about a large share of real servers.
    if !is_json_content_type("application/json; charset=utf-8") {
        panic("a charset parameter must not change the media type");
    }
    if !is_json_content_type("APPLICATION/JSON") {
        panic("media types are case-insensitive");
    }
    if !is_json_content_type("  application/json  ") {
        panic("surrounding space must be tolerated");
    }
    if is_json_content_type("application/jsonx") {
        panic("a longer type must not match");
    }
    if is_json_content_type("text/json") {
        panic("text/json is a different media type");
    }
    let checked = json_response("application/json; charset=utf-8", "{\"a\":1}");
    match checked.json_checked() {
        Ok(_value) => {}
        Err(_error) => {
            panic("a charset parameter must not fail the strict form");
        }
    }
}

fn test_a_non_utf8_body_is_a_decode_error_not_a_json_error() {
    // The distinction matters: bad bytes and bad JSON are fixed in different places.
    let mut body: Vec<UInt8> = Vec::new();
    body.push(255u8);
    let response = HttpResponse {
        version: HttpVersion::Http11,
        status: 200u16,
        reason: String::from("OK"),
        headers: new_header_map(),
        body: body,
    };
    match response.json() {
        Ok(_value) => {
            panic("invalid UTF-8 must not parse as JSON");
        }
        Err(error) => {
            // Rendered BEFORE the match: an arm binding a payload moves the error, so `&error`
            // afterwards would be a use of a moved value.
            let rendered = json_body_error_text(&error);
            if rendered.len() == 0u64 {
                panic("a decode error must render");
            }
            match error {
                JsonBodyError::NotUtf8(_why) => {}
                _ => {
                    panic("invalid UTF-8 must be a decode error, not a JSON error");
                }
            }
        }
    }
}
