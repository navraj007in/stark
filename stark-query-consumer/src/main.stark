use stark_query::default_limits;
use stark_query::parse;
use stark_query::serialize;

fn main() {
    let raw = String::from("foo=bar&a=b%20c&plus=+");
    let lims = default_limits();
    match parse(&raw, lims) {
        Ok(pairs) => {
            match serialize(pairs.as_slice(), default_limits()) {
                Ok(out) => {
                    if out.len() > 0u64 {
                        println("QUERY_CONSUMER_OK");
                    }
                }
                Err(_) => panic("serialize failed"),
            }
        }
        Err(_) => panic("parse failed"),
    }
}
