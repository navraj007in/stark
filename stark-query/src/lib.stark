use stark_percent::decode as percent_decode;
use stark_percent::encode as percent_encode;
use stark_percent::PercentEncodeSet;
use stark_percent::PercentError;

pub struct QueryPair {
    pub name: String,
    pub value: String,
}

pub struct QueryLimits {
    pub max_total_bytes: UInt64,
    pub max_pair_count: UInt64,
    pub max_name_bytes: UInt64,
    pub max_value_bytes: UInt64,
}

pub enum QueryError {
    ExceededTotalBytesLimit,
    ExceededPairCountLimit,
    ExceededNameLimit,
    ExceededValueLimit,
    PercentDecodeError(PercentError),
}

pub fn default_limits() -> QueryLimits {
    QueryLimits {
        max_total_bytes: 8192u64,
        max_pair_count: 64u64,
        max_name_bytes: 256u64,
        max_value_bytes: 4096u64,
    }
}

pub fn parse(input: &String, limits: QueryLimits) -> Result<Vec<QueryPair>, QueryError> {
    let bytes = input.bytes();
    let len = bytes.len();
    if len > limits.max_total_bytes {
        return Err(QueryError::ExceededTotalBytesLimit);
    }

    let mut pairs = Vec::new();
    if len == 0u64 {
        return Ok(Vec::new());
    }

    let mut start: UInt64 = 0u64;
    let mut i: UInt64 = 0u64;

    while i <= len {
        if i == len || bytes[i] == 38u8 {
            if pairs.len() >= limits.max_pair_count {
                return Err(QueryError::ExceededPairCountLimit);
            }
            
            let mut eq_idx: UInt64 = i;
            let mut j = start;
            while j < i {
                if bytes[j] == 61u8 {
                    eq_idx = j;
                    break;
                }
                j = j + 1u64;
            }

            let raw_name: String;
            let raw_val: String;

            if eq_idx < i {
                raw_name = slice_to_string(bytes, start, eq_idx);
                raw_val = slice_to_string(bytes, eq_idx + 1u64, i);
            } else {
                raw_name = slice_to_string(bytes, start, i);
                raw_val = String::new();
            }

            match percent_decode(&raw_name) {
                Ok(name_bytes) => {
                    if name_bytes.len() > limits.max_name_bytes {
                        return Err(QueryError::ExceededNameLimit);
                    }
                    match percent_decode(&raw_val) {
                        Ok(val_bytes) => {
                            if val_bytes.len() > limits.max_value_bytes {
                                return Err(QueryError::ExceededValueLimit);
                            }
                            pairs.push(QueryPair {
                                name: bytes_to_string(name_bytes.as_slice()),
                                value: bytes_to_string(val_bytes.as_slice()),
                            });
                        }
                        Err(e) => {
                            return Err(QueryError::PercentDecodeError(e));
                        }
                    }
                }
                Err(e) => {
                    return Err(QueryError::PercentDecodeError(e));
                }
            }

            start = i + 1u64;
        }
        i = i + 1u64;
    }

    Ok(pairs)
}

pub fn serialize(pairs: &[QueryPair], limits: QueryLimits) -> Result<String, QueryError> {
    if pairs.len() > limits.max_pair_count {
        return Err(QueryError::ExceededPairCountLimit);
    }

    let mut out = String::new();
    let mut i: UInt64 = 0u64;

    while i < pairs.len() {
        let pair = &pairs[i];
        let enc_name = percent_encode(pair.name.bytes(), PercentEncodeSet::QueryComponent);
        if enc_name.bytes().len() > limits.max_name_bytes {
            return Err(QueryError::ExceededNameLimit);
        }

        let enc_val = percent_encode(pair.value.bytes(), PercentEncodeSet::QueryComponent);
        if enc_val.bytes().len() > limits.max_value_bytes {
            return Err(QueryError::ExceededValueLimit);
        }

        if i > 0u64 {
            out.push('&');
        }
        out.push_str(enc_name.as_str());
        out.push('=');
        out.push_str(enc_val.as_str());

        if out.bytes().len() > limits.max_total_bytes {
            return Err(QueryError::ExceededTotalBytesLimit);
        }

        i = i + 1u64;
    }

    Ok(out)
}

fn slice_to_string(bytes: &[UInt8], start: UInt64, end: UInt64) -> String {
    let mut s = String::new();
    let mut i = start;
    while i < end {
        s.push(direct_ascii_char(bytes[i]));
        i = i + 1u64;
    }
    s
}

fn bytes_to_string(bytes: &[UInt8]) -> String {
    let mut s = String::new();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        s.push(direct_ascii_char(bytes[i]));
        i = i + 1u64;
    }
    s
}

fn direct_ascii_char(byte: UInt8) -> Char {
    if byte == 32u8 { ' ' }
    else if byte == 33u8 { '!' }
    else if byte == 34u8 { '"' }
    else if byte == 35u8 { '#' }
    else if byte == 36u8 { '$' }
    else if byte == 37u8 { '%' }
    else if byte == 38u8 { '&' }
    else if byte == 39u8 { '\'' }
    else if byte == 40u8 { '(' }
    else if byte == 41u8 { ')' }
    else if byte == 42u8 { '*' }
    else if byte == 43u8 { '+' }
    else if byte == 44u8 { ',' }
    else if byte == 45u8 { '-' }
    else if byte == 46u8 { '.' }
    else if byte == 47u8 { '/' }
    else if byte == 48u8 { '0' }
    else if byte == 49u8 { '1' }
    else if byte == 50u8 { '2' }
    else if byte == 51u8 { '3' }
    else if byte == 52u8 { '4' }
    else if byte == 53u8 { '5' }
    else if byte == 54u8 { '6' }
    else if byte == 55u8 { '7' }
    else if byte == 56u8 { '8' }
    else if byte == 57u8 { '9' }
    else if byte == 58u8 { ':' }
    else if byte == 59u8 { ';' }
    else if byte == 60u8 { '<' }
    else if byte == 61u8 { '=' }
    else if byte == 62u8 { '>' }
    else if byte == 63u8 { '?' }
    else if byte == 64u8 { '@' }
    else if byte == 65u8 { 'A' }
    else if byte == 66u8 { 'B' }
    else if byte == 67u8 { 'C' }
    else if byte == 68u8 { 'D' }
    else if byte == 69u8 { 'E' }
    else if byte == 70u8 { 'F' }
    else if byte == 71u8 { 'G' }
    else if byte == 72u8 { 'H' }
    else if byte == 73u8 { 'I' }
    else if byte == 74u8 { 'J' }
    else if byte == 75u8 { 'K' }
    else if byte == 76u8 { 'L' }
    else if byte == 77u8 { 'M' }
    else if byte == 78u8 { 'N' }
    else if byte == 79u8 { 'O' }
    else if byte == 80u8 { 'P' }
    else if byte == 81u8 { 'Q' }
    else if byte == 82u8 { 'R' }
    else if byte == 83u8 { 'S' }
    else if byte == 84u8 { 'T' }
    else if byte == 85u8 { 'U' }
    else if byte == 86u8 { 'V' }
    else if byte == 87u8 { 'W' }
    else if byte == 88u8 { 'X' }
    else if byte == 89u8 { 'Y' }
    else if byte == 90u8 { 'Z' }
    else if byte == 91u8 { '[' }
    else if byte == 92u8 { '\\' }
    else if byte == 93u8 { ']' }
    else if byte == 94u8 { '^' }
    else if byte == 95u8 { '_' }
    else if byte == 96u8 { '`' }
    else if byte == 97u8 { 'a' }
    else if byte == 98u8 { 'b' }
    else if byte == 99u8 { 'c' }
    else if byte == 100u8 { 'd' }
    else if byte == 101u8 { 'e' }
    else if byte == 102u8 { 'f' }
    else if byte == 103u8 { 'g' }
    else if byte == 104u8 { 'h' }
    else if byte == 105u8 { 'i' }
    else if byte == 106u8 { 'j' }
    else if byte == 107u8 { 'k' }
    else if byte == 108u8 { 'l' }
    else if byte == 109u8 { 'm' }
    else if byte == 110u8 { 'n' }
    else if byte == 111u8 { 'o' }
    else if byte == 112u8 { 'p' }
    else if byte == 113u8 { 'q' }
    else if byte == 114u8 { 'r' }
    else if byte == 115u8 { 's' }
    else if byte == 116u8 { 't' }
    else if byte == 117u8 { 'u' }
    else if byte == 118u8 { 'v' }
    else if byte == 119u8 { 'w' }
    else if byte == 120u8 { 'x' }
    else if byte == 121u8 { 'y' }
    else if byte == 122u8 { 'z' }
    else if byte == 123u8 { '{' }
    else if byte == 124u8 { '|' }
    else if byte == 125u8 { '}' }
    else if byte == 126u8 { '~' }
    else { '?' }
}

mod tests;
