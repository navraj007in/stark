// HC6 — serialize a structured request into exact HTTP/1.1 bytes.
//
// Pure: bytes in, bytes out, no sockets. That is what makes the output independently testable and
// identical across every engine, which is HC6's exit criterion.
//
// The framing headers are the whole difficulty. `Host`, `Content-Length` and `Connection` are all
// things this must emit — and all things a caller may also have set. Emitting both produces a
// request that two peers will read differently, which is the request-smuggling shape. So the rule
// here is: the serializer OWNS framing, and a caller-supplied framing header is REJECTED rather
// than merged, overridden, or silently dropped.

use stark_http_core::ascii_equal_ignore_case;
use stark_http_core::check_body_within;
use stark_http_core::check_headers_within;
use stark_http_core::contains;
use stark_http_core::method_forbids_body;
use stark_http_core::method_text;
use stark_http_core::version_text;
use stark_http_core::append_validated;
use stark_http_core::default_limits;
use stark_http_core::new_header_map;
use stark_http_core::request;
use stark_http_core::HeaderMap;
use stark_http_core::HttpMethod;
use stark_http_core::HttpLimits;
use stark_http_core::HttpRequest;
use stark_http_core::HttpVersion;

pub enum SerializeError {
    HostRequired,
    HostInvalid,
    ConflictingFramingHeader,
    BodyOnBodylessMethod,
    RequestTooLarge,
    Core(String),
}

/// The framing headers this serializer owns. A caller setting any of them is a conflict, not a
/// customisation: each one, emitted twice with different values, changes where a peer believes the
/// message ends.
fn is_reserved_framing_header(name: &str) -> Bool {
    ascii_equal_ignore_case(name, "host") || ascii_equal_ignore_case(name, "content-length") || ascii_equal_ignore_case(
        name,
        "transfer-encoding",
    ) || ascii_equal_ignore_case(name, "connection")
}

pub fn error_text(error: &SerializeError) -> String {
    match *error {
        SerializeError::HostRequired => String::from("HTTP/1.1 requires a Host"),
        SerializeError::HostInvalid => String::from("invalid Host value"),
        SerializeError::ConflictingFramingHeader => {
            String::from("caller set a framing header the serializer owns")
        }
        SerializeError::BodyOnBodylessMethod => {
            String::from("a body was supplied for a method that forbids one")
        }
        SerializeError::RequestTooLarge => String::from("serialized request exceeds its limit"),
        SerializeError::Core(message) => message.clone(),
    }
}

/// The authority for a request: host, and a port that is omitted when it is the scheme default.
///
/// A literal IPv6 host must arrive already bracketed — `[::1]` — because the brackets are part of
/// the `Host` production, not something to be inferred from the presence of colons.
pub struct HostAuthority { pub host: String, pub port: UInt16, pub default_port: UInt16 }

pub fn host_header_value(authority: &HostAuthority) -> Result<String, SerializeError> {
    if authority.host.len() == 0u64 {
        return Err(SerializeError::HostInvalid);
    }
    let bytes = authority.host.bytes();
    let n = bytes.len();
    let mut i = 0u64;
    while i < n {
        let byte = bytes[i];
        // No spaces, no controls, no CR/LF. A `Host` carrying either would terminate the line.
        if byte <= 32u8 || byte == 127u8 {
            return Err(SerializeError::HostInvalid);
        }
        i = i + 1u64;
    }
    let mut out = authority.host.clone();
    if authority.port != authority.default_port {
        out.push(':');
        out.push_str(u16_text(authority.port).as_str());
    }
    Ok(out)
}

fn u16_text(value: UInt16) -> String {
    u64_text(value as UInt64)
}

fn u64_text(value: UInt64) -> String {
    if value == 0u64 {
        return String::from("0");
    }
    let mut digits: Vec<Char> = Vec::new();
    let mut n = value;
    while n > 0u64 {
        let digit = (n % 10u64) as Int32;
        digits.push(Char::from_u32((48 + digit) as UInt32).unwrap());
        n = n / 10u64;
    }
    let mut out = String::new();
    let mut i = digits.len();
    while i > 0u64 {
        i = i - 1u64;
        out.push(digits[i]);
    }
    out
}

// DEV-147: these take an OWNED `Vec<UInt8>` and return it, rather than the `&mut Vec<UInt8>` the
// shape obviously wants. A `&mut Vec<T>` parameter mutated in a loop is accepted by the checker and
// executes correctly under the HIR oracle, but MIR verification refuses it:
//
//   MIR-0007 push_str_bytes@[] bb6: move from possibly-moved place _1[]
//
// Accepted-but-unbuildable. The package's own tests passed on the oracle while the native consumer
// failed to build, which is precisely why the executed-surface rule (CD-348) requires a NATIVE
// consumer: `stark test` alone would have shipped this.
//
// Restore the `&mut` form when DEV-147 is repaired.
fn push_str_bytes(out: Vec<UInt8>, text: &str) -> Vec<UInt8> {
    let mut acc = out;
    let bytes = text.bytes();
    let n = bytes.len();
    let mut i = 0u64;
    while i < n {
        acc.push(bytes[i]);
        i = i + 1u64;
    }
    acc
}

fn push_crlf(out: Vec<UInt8>) -> Vec<UInt8> {
    let mut acc = out;
    acc.push(13u8);
    acc.push(10u8);
    acc
}

fn push_header_line(out: Vec<UInt8>, name: &str, value: &str) -> Vec<UInt8> {
    let mut acc = push_str_bytes(out, name);
    acc.push(58u8);
    acc.push(32u8);
    acc = push_str_bytes(acc, value);
    push_crlf(acc)
}

/// Serialize `request` into exact HTTP/1.1 bytes.
///
/// **Deterministic header order**, which is what makes byte snapshots meaningful: the request line,
/// then `Host`, then the caller's headers in the order they were appended, then framing
/// (`Content-Length` when a body exists, then `Connection`), then the blank line, then the body.
/// Caller order is preserved because duplicate headers are order-significant; framing goes last so
/// it is always in the same place regardless of how many headers the caller set.
pub fn serialize_request(request: &HttpRequest, authority: &HostAuthority, limits: &HttpLimits) -> Result<Vec<UInt8>, SerializeError> {
    match check_headers_within(&request.headers, limits) {
        Ok(_ok) => {}
        Err(error) => {
            return Err(SerializeError::Core(stark_http_core::error_text(&error)));
        }
    }
    match check_body_within(&request.body, limits) {
        Ok(_ok) => {}
        Err(error) => {
            return Err(SerializeError::Core(stark_http_core::error_text(&error)));
        }
    }

    // A caller may not set what this owns.
    let n = request.headers.entries.len();
    let mut i = 0u64;
    while i < n {
        let entry = &request.headers.entries[i];
        if is_reserved_framing_header(entry.name.as_str()) {
            return Err(SerializeError::ConflictingFramingHeader);
        }
        i = i + 1u64;
    }

    // HTTP/1.1 requires `Host`. HTTP/1.0 does not, but sending it is harmless and every real peer
    // expects it, so it is emitted for both rather than making the output depend on the version.
    let host_value = host_header_value(authority)?;

    let body_length = request.body.len();
    if body_length > 0u64 && method_forbids_body(&request.method) {
        return Err(SerializeError::BodyOnBodylessMethod);
    }

    let mut out: Vec<UInt8> = Vec::new();

    out = push_str_bytes(out, method_text(&request.method).as_str());
    out.push(32u8);
    out = push_str_bytes(out, request.target.as_str());
    out.push(32u8);
    out = push_str_bytes(out, version_text(&request.version).as_str());
    out = push_crlf(out);

    out = push_header_line(out, "Host", host_value.as_str());

    let mut k = 0u64;
    while k < n {
        let entry = &request.headers.entries[k];
        out = push_header_line(out, entry.name.as_str(), entry.value.as_str());
        k = k + 1u64;
    }

    // `Content-Length` only when there is a body. A bodyless GET with `Content-Length: 0` is legal
    // but noisy, and omitting it keeps the common request minimal.
    if body_length > 0u64 {
        out = push_header_line(out, "Content-Length", u64_text(body_length).as_str());
    }

    // First release is `Connection: close` — no pooling, so claiming keep-alive would promise
    // reuse the client does not implement.
    out = push_header_line(out, "Connection", "close");
    out = push_crlf(out);

    let mut b = 0u64;
    while b < body_length {
        out.push(request.body[b]);
        b = b + 1u64;
    }

    if out.len() > limits.max_body_bytes + limits.max_header_bytes {
        return Err(SerializeError::RequestTooLarge);
    }
    Ok(out)
}

/// The serialized bytes as text, for tests and diagnostics. Body bytes are not assumed to be
/// UTF-8; a non-ASCII byte renders as `.` rather than failing, because this is a debugging view
/// and never the wire format.
pub fn render_ascii(bytes: &Vec<UInt8>) -> String {
    let n = bytes.len();
    let mut out = String::new();
    let mut i = 0u64;
    while i < n {
        let byte = bytes[i];
        if byte == 13u8 {
            out.push_str("\\r");
        } else {
            if byte == 10u8 {
                out.push_str("\\n");
            } else {
                if byte >= 32u8 && byte <= 126u8 {
                    match Char::from_u32(byte as UInt32) {
                        Some(ch) => {
                            out.push(ch);
                        }
                        None => {
                            out.push('.');
                        }
                    }
                } else {
                    out.push('.');
                }
            }
        }
        i = i + 1u64;
    }
    out
}

pub fn default_host_authority(host: &str) -> HostAuthority {
    HostAuthority { host: String::from(host), port: 80u16, default_port: 80u16 }
}

pub fn requires_host(version: &HttpVersion) -> Bool {
    match *version {
        HttpVersion::Http11 => true,
        HttpVersion::Http10 => false,
    }
}

mod tests;
