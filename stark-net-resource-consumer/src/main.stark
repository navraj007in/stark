// CD-347 — the EXECUTED SURFACE for `stark-net`'s `TcpStream` resource.
//
// The ordinary `stark-net-consumer` covers the address surface and is run under both the
// interpreter and a native build. It cannot cover the resource surface: qualification step 5 is
// `stark run`, and the interpreter has no provider layer, so any program touching a bound resource
// dies with "provider binding not lowered". This consumer is therefore NATIVE-ONLY, and the gate
// runs it without a `stark run` step.
//
// It exists because CD-345 found `stark-net` passing all seven gate steps while `connect`, `read`,
// `write` and `close` had never been called by anything at all — which let DEV-146, a
// build-breaking defect, sit in the package undetected. Every line below is here to make a
// specific step of the resource lifecycle OBSERVED rather than assumed.
//
// It must be deterministic in CI, so it does not depend on a peer. Port 9 (discard) on loopback is
// expected to refuse; what that proves is not that connecting works — that needs a server — but
// that the resource path LOWERS, LINKS against the provider, and EXECUTES. Those are exactly the
// steps that were unobserved, and they are what DEV-146 broke.

use stark_net::close;
use stark_net::connect_no_timeout;
use stark_net::ipv4;
use stark_net::socket_address;
use stark_net::write_all;

// ACQUIRE + CLOSE. The success arm consumes the stream through `close`, which is the affine
// release; the failure arm is the deterministic path in CI.
fn acquire_and_close() {
    let address = socket_address(ipv4(127u8, 0u8, 0u8, 1u8), 9u16);
    match connect_no_timeout(address) {
        Ok(stream) => match close(stream) {
            Ok(_unit) => {}
            Err(_error) => {
                panic("stark-net resource consumer: close failed");
            }
        }
        Err(_error) => {}
    }
}

// USE. `write_all` takes `&mut TcpStream` and forwards to a raw binding whose derived signature
// takes a SHARED borrow. That coercion is DEV-146, and this call is what makes it executable
// evidence rather than a claim: before the repair, this package did not build.
fn acquire_use_and_close() {
    let address = socket_address(ipv4(127u8, 0u8, 0u8, 1u8), 9u16);
    match connect_no_timeout(address) {
        Ok(stream) => {
            let mut owned = stream;
            match write_all(&mut owned, "PING\n".bytes()) {
                Ok(_count) => {}
                Err(_error) => {}
            }
            match close(owned) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("stark-net resource consumer: close after use failed");
                }
            }
        }
        Err(_error) => {}
    }
}

// RELEASE BY DROP. A stream that is never explicitly closed must still be closed exactly once, by
// drop elaboration. Verified at CD-345 in the generated Rust
// (`_N.drop_with(|v| stark_tcp_stream_close(v.as_raw()))`); running the shape keeps the
// elaboration from silently ceasing to be emitted.
fn acquire_and_let_drop_release() {
    let address = socket_address(ipv4(127u8, 0u8, 0u8, 1u8), 9u16);
    match connect_no_timeout(address) {
        Ok(_stream) => {}
        Err(_error) => {}
    }
}

fn main() {
    acquire_and_close();
    acquire_use_and_close();
    acquire_and_let_drop_release();
    println("STARK_NET_RESOURCE_OK");
}
