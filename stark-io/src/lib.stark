// stark-io minimal native file I/O slice.
//
// `NativeFile` is synthesized from starkpkg.json provider_api as an opaque host-resource nominal
// bound to the first-party filesystem provider resource `io_file`.
//
// `io_file`, NOT `file`: `file` is Core-owned — the compiler binds it to `CoreType::File` on the
// legacy path and CD-224 forbids a package from claiming it. `io_file` is this package's own
// resource identity, wholly on the host-resource path, so a `NativeFile` is owned, moved and closed
// exactly once by MIR with no compiler guard weakened. Core `File` is untouched and its own
// migration remains open.

pub enum FileError {
    NotFound,
    PermissionDenied,
    InvalidInput,
    InvalidData,
    IsDirectory,
    AlreadyExists,
    Unsupported,
    LimitExceeded,
    UnexpectedEof,
    WriteZero,
    Other,
}

pub enum SeekFrom {
    Start(UInt64),
    Current(Int64),
    End(Int64),
}

pub enum FileType {
    File,
    Directory,
    Symlink,
    Other,
}

pub struct FileMetadata {
    pub file_type: FileType,
    pub length: UInt64,
    pub readonly: Bool,
    pub modified_seconds: Option<Int64>,
    pub accessed_seconds: Option<Int64>,
    pub created_seconds: Option<Int64>,
}

pub struct DirectoryEntry {
    pub name: String,
    pub path: String,
    pub file_type: FileType,
}

pub struct OpenOptions {
    pub read: Bool,
    pub write: Bool,
    pub append: Bool,
    pub truncate: Bool,
    pub create: Bool,
    pub create_new: Bool,
}

const READ_TO_END_CHUNK_SIZE: UInt64 = 8192u64;
const U64_MAX: UInt64 = 18446744073709551615u64;

pub fn default_open_options() -> OpenOptions {
    OpenOptions {
        read: false,
        write: false,
        append: false,
        truncate: false,
        create: false,
        create_new: false,
    }
}

pub fn open_options_are_valid(options: &OpenOptions) -> Bool {
    let can_access = options.read || options.write || options.append;
    if !can_access {
        return false;
    }
    if options.truncate && !options.write {
        return false;
    }
    if options.create && !options.write && !options.append {
        return false;
    }
    if options.create_new && !options.write && !options.append {
        return false;
    }
    true
}

pub fn path_is_valid(path: &str) -> Bool {
    if path.len() == 0u64 {
        return false;
    }
    let bytes = path.bytes();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        if bytes[i] == 0u8 {
            return false;
        }
        i = i + 1u64;
    }
    true
}

pub fn path_is_absolute(path: &str) -> Bool {
    if path.len() == 0u64 {
        return false;
    }
    let bytes = path.bytes();
    if bytes[0u64] == 47u8 {
        return true;
    }
    if path.len() >= 3u64 && bytes[1u64] == 58u8 && (bytes[2u64] == 47u8 || bytes[2u64] == 92u8) {
        return true;
    }
    false
}

fn map_io_error(error: RawFileError) -> FileError {
    match error {
        RawFileError::NotFound => FileError::NotFound,
        RawFileError::PermissionDenied => FileError::PermissionDenied,
        RawFileError::InvalidInput => FileError::InvalidInput,
        RawFileError::InvalidData => FileError::InvalidData,
        RawFileError::IsDirectory => FileError::IsDirectory,
        RawFileError::AlreadyExists => FileError::AlreadyExists,
        RawFileError::Unsupported => FileError::Unsupported,
        RawFileError::Other => FileError::Other,
    }
}

fn is_continuation(byte: UInt8) -> Bool {
    byte >= 0x80u8 && byte <= 0xBFu8
}

fn codepoint_char(codepoint: UInt32) -> Result<Char, FileError> {
    if codepoint > 0x10FFFFu32 {
        return Err(FileError::InvalidData);
    }
    if codepoint >= 0xD800u32 && codepoint <= 0xDFFFu32 {
        return Err(FileError::InvalidData);
    }
    match Char::from_u32(codepoint) {
        Some(ch) => Ok(ch),
        None => Err(FileError::InvalidData),
    }
}

fn decode_valid_utf8(bytes: &Vec<UInt8>) -> Result<String, FileError> {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        let b0 = bytes[i];
        if b0 < 0x80u8 {
            out.push(codepoint_char(b0 as UInt32)?);
            i = i + 1u64;
        } else if b0 >= 0xC2u8 && b0 <= 0xDFu8 {
            if i + 1u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x1Fu32) << 6u32) | (bytes[i + 1u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 2u64;
        } else if b0 == 0xE0u8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0xA0u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 >= 0xE1u8 && b0 <= 0xECu8 {
            if i + 2u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 == 0xEDu8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x9Fu8 || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 >= 0xEEu8 && b0 <= 0xEFu8 {
            if i + 2u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 == 0xF0u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x90u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x07u32) << 18u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 12u32) | ((bytes[i + 2u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 3u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 4u64;
        } else if b0 >= 0xF1u8 && b0 <= 0xF3u8 {
            if i + 3u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x07u32) << 18u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 12u32) | ((bytes[i + 2u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 3u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 4u64;
        } else if b0 == 0xF4u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x8Fu8 || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x07u32) << 18u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 12u32) | ((bytes[i + 2u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 3u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 4u64;
        } else {
            return Err(FileError::InvalidData);
        }
    }
    Ok(out)
}

pub fn open_file(path: &str) -> Result<NativeFile, FileError> {
    match file_open_raw(path.bytes()) {
        Ok(file) => Ok(file),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn create_file(path: &str) -> Result<NativeFile, FileError> {
    match file_create_raw(path.bytes()) {
        Ok(file) => Ok(file),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn file_read(file: &NativeFile, buffer: &mut [UInt8]) -> Result<UInt64, FileError> {
    match file_read_raw(file, buffer) {
        Ok(result) => Ok(result.0),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn file_write(file: &NativeFile, data: &[UInt8]) -> Result<UInt64, FileError> {
    match file_write_raw(file, data) {
        Ok(count) => Ok(count),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn file_flush(file: &NativeFile) -> Result<(), FileError> {
    match file_flush_raw(file) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

// Taking `file` BY VALUE is the close. `NativeFile` is a host resource, so MIR owns its only
// destruction path (A11 §5 rule 4): the handle is owned by this function, nothing moves it out, and
// drop elaboration emits the provider close exactly once when it goes out of scope. Calling the
// close symbol directly is rejected as a second destruction path — correctly, because both would
// run.
//
// The consequence for this signature: a close error is not observable. A destructor has nowhere to
// put a `Result`, which is why this returns `Ok` unconditionally rather than pretending to report
// one. A program that must observe flush failure should call `file_flush` before dropping, where the
// error IS returned.
pub fn file_close(file: NativeFile) -> Result<(), FileError> {
    Ok(())
}

pub fn file_write_all(file: &NativeFile, data: &[UInt8]) -> Result<(), FileError> {
    let mut written: UInt64 = 0u64;
    while written < data.len() {
        let remaining = &data[written..data.len()];
        let count = file_write(file, remaining)?;
        if count == 0u64 {
            return Err(FileError::WriteZero);
        }
        written = written + count;
    }
    Ok(())
}

pub fn file_write_str(file: &NativeFile, text: &str) -> Result<UInt64, FileError> {
    file_write(file, text.bytes())
}

pub fn file_read_to_end(file: &NativeFile, max_bytes: UInt64) -> Result<Vec<UInt8>, FileError> {
    let mut out: Vec<UInt8> = Vec::new();
    let mut out_len: UInt64 = 0u64;
    let mut scratch: [UInt8; 8192] = [0u8; 8192];
    let mut done = false;
    while !done {
        let read_count: UInt64;
        {
            let buffer = &mut scratch[0u64..READ_TO_END_CHUNK_SIZE];
            read_count = file_read(file, buffer)?;
        }
        if read_count == 0u64 {
            done = true;
        } else if out_len > max_bytes || read_count > max_bytes - out_len {
            return Err(FileError::LimitExceeded);
        } else {
            let mut i: UInt64 = 0u64;
            while i < read_count {
                out.push(scratch[i]);
                i = i + 1u64;
            }
            out_len = out_len + read_count;
        }
    }
    Ok(out)
}

pub fn file_read_to_string(file: &NativeFile, max_bytes: UInt64) -> Result<String, FileError> {
    let bytes = file_read_to_end(file, max_bytes)?;
    decode_valid_utf8(&bytes)
}

pub fn read(path: &str, max_bytes: UInt64) -> Result<Vec<UInt8>, FileError> {
    let file = open_file(path)?;
    let result = file_read_to_end(&file, max_bytes);
    match result {
        Ok(bytes) => {
            file_close(file)?;
            Ok(bytes)
        }
        Err(error) => {
            let _close_result = file_close(file);
            Err(error)
        }
    }
}

pub fn read_text(path: &str, max_bytes: UInt64) -> Result<String, FileError> {
    let file = open_file(path)?;
    let result = file_read_to_string(&file, max_bytes);
    match result {
        Ok(text) => {
            file_close(file)?;
            Ok(text)
        }
        Err(error) => {
            let _close_result = file_close(file);
            Err(error)
        }
    }
}

pub fn write(path: &str, data: &[UInt8]) -> Result<(), FileError> {
    let file = create_file(path)?;
    let result = file_write_all(&file, data);
    match result {
        Ok(_) => {
            file_close(file)?;
            Ok(())
        }
        Err(error) => {
            let _close_result = file_close(file);
            Err(error)
        }
    }
}

pub fn write_text(path: &str, text: &str) -> Result<(), FileError> {
    write(path, text.bytes())
}

// ------------------------------------------------------------------- open options --
//
// The ABI admits no aggregate parameter, so an `OpenOptions` crosses as a bitmask. The bit order
// matches the struct's field order and the provider's constants; all three must agree, and the
// provider rejects an unknown bit rather than ignoring it.

const OPEN_READ: UInt32 = 1u32;
const OPEN_WRITE: UInt32 = 2u32;
const OPEN_APPEND: UInt32 = 4u32;
const OPEN_TRUNCATE: UInt32 = 8u32;
const OPEN_CREATE: UInt32 = 16u32;
const OPEN_CREATE_NEW: UInt32 = 32u32;

fn open_flags(options: &OpenOptions) -> UInt32 {
    let mut flags: UInt32 = 0u32;
    if options.read {
        flags = flags | OPEN_READ;
    }
    if options.write {
        flags = flags | OPEN_WRITE;
    }
    if options.append {
        flags = flags | OPEN_APPEND;
    }
    if options.truncate {
        flags = flags | OPEN_TRUNCATE;
    }
    if options.create {
        flags = flags | OPEN_CREATE;
    }
    if options.create_new {
        flags = flags | OPEN_CREATE_NEW;
    }
    flags
}

/// Open with an explicit mode set. Validated here as well as in the provider: this returns the
/// package's own `InvalidInput` without a call, and the provider's check is what makes the answer
/// identical on every platform rather than an OS error whose kind varies.
pub fn open_with_options(path: &str, options: &OpenOptions) -> Result<NativeFile, FileError> {
    if !open_options_are_valid(options) {
        return Err(FileError::InvalidInput);
    }
    match file_open_options_raw(path.bytes(), open_flags(options)) {
        Ok(file) => Ok(file),
        Err(error) => Err(map_io_error(error)),
    }
}

// ------------------------------------------------------------------------- seek --

const SEEK_START: UInt8 = 0u8;
const SEEK_CURRENT: UInt8 = 1u8;
const SEEK_END: UInt8 = 2u8;
const INT64_MAX_AS_UINT64: UInt64 = 9223372036854775807u64;

/// Reposition the cursor, returning the resulting absolute position.
///
/// A `Start` offset above `Int64::MAX` is rejected rather than cast: a failing `as` traps in every
/// build mode, and a seek past the representable range is a caller error, not a crash.
pub fn file_seek(file: &NativeFile, from: SeekFrom) -> Result<UInt64, FileError> {
    let whence: UInt8;
    let offset: Int64;
    match from {
        SeekFrom::Start(position) => {
            if position > INT64_MAX_AS_UINT64 {
                return Err(FileError::InvalidInput);
            }
            whence = SEEK_START;
            offset = position as Int64;
        }
        SeekFrom::Current(delta) => {
            whence = SEEK_CURRENT;
            offset = delta;
        }
        SeekFrom::End(delta) => {
            whence = SEEK_END;
            offset = delta;
        }
    }
    match file_seek_raw(file, whence, offset) {
        Ok(position) => Ok(position),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Durable sync: data and metadata to the device, not merely to the OS.
///
/// Distinct from `file_flush`, which only pushes buffered bytes into the kernel. Only this one
/// survives power loss.
pub fn file_sync(file: &NativeFile) -> Result<(), FileError> {
    match file_sync_raw(file) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Truncate or extend. Extending fills with zeroes — the platform contract, not a choice here.
pub fn file_set_length(file: &NativeFile, length: UInt64) -> Result<(), FileError> {
    match file_set_len_raw(file, length) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

// --------------------------------------------------------------------- metadata --

fn file_type_of(kind: UInt8) -> FileType {
    if kind == 0u8 {
        FileType::File
    } else if kind == 1u8 {
        FileType::Directory
    } else if kind == 2u8 {
        FileType::Symlink
    } else {
        FileType::Other
    }
}

/// A timestamp arrives as a (seconds, valid) pair and becomes an `Option`.
///
/// There is no sentinel second that could mean "absent": every `Int64` is a real instant, including
/// zero and negatives. The pair is what keeps "the epoch" distinguishable from "unavailable".
fn optional_seconds(seconds: Int64, valid: Bool) -> Option<Int64> {
    if valid {
        Some(seconds)
    } else {
        None
    }
}

pub fn file_metadata(file: &NativeFile) -> Result<FileMetadata, FileError> {
    match file_metadata_raw(file) {
        Ok(m) => Ok(FileMetadata {
            file_type: file_type_of(m.0),
            length: m.1,
            readonly: m.2,
            modified_seconds: optional_seconds(m.3, m.4),
            accessed_seconds: optional_seconds(m.5, m.6),
            created_seconds: optional_seconds(m.7, m.8),
        }),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Metadata for a path, **without following a symlink**.
///
/// A followed link reports its target's kind, which would make `FileType::Symlink` unobservable.
/// To ask about the target instead, open the path and call `file_metadata`.
pub fn path_metadata(path: &str) -> Result<FileMetadata, FileError> {
    match path_metadata_raw(path.bytes()) {
        Ok(m) => Ok(FileMetadata {
            file_type: file_type_of(m.0),
            length: m.1,
            readonly: m.2,
            modified_seconds: optional_seconds(m.3, m.4),
            accessed_seconds: optional_seconds(m.5, m.6),
            created_seconds: optional_seconds(m.7, m.8),
        }),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Whether the path exists. A missing path is `Ok(false)`, not an error — absence is an answer.
/// Genuine failures (a permission-denied parent, say) still surface as `Err`.
pub fn path_exists(path: &str) -> Result<Bool, FileError> {
    match path_exists_raw(path.bytes()) {
        Ok(result) => Ok(result.0),
        Err(error) => Err(map_io_error(error)),
    }
}

// ------------------------------------------------------------ path manipulation --

const PATH_SEPARATOR: UInt8 = 47u8;
const WINDOWS_SEPARATOR: UInt8 = 92u8;

fn is_separator(byte: UInt8) -> Bool {
    byte == PATH_SEPARATOR || byte == WINDOWS_SEPARATOR
}

fn join_bytes(base: &str, name: &Vec<UInt8>) -> Vec<UInt8> {
    let mut out: Vec<UInt8> = Vec::new();
    let base_bytes = base.bytes();
    let mut i: UInt64 = 0u64;
    while i < base_bytes.len() {
        out.push(base_bytes[i]);
        i = i + 1u64;
    }
    // The separator test is lifted into a local deliberately. Written as
    // `if out.len() > 0 && !is_separator(out[out.len() - 1]) { out.push(..) }` the index in the
    // condition holds a borrow of `out` that is still live across the `push`, and E0101 rejects it.
    // Reading the byte out first ends that borrow before the mutation begins.
    let mut needs_separator = false;
    if out.len() > 0u64 {
        let last = out[out.len() - 1u64];
        needs_separator = !is_separator(last);
    }
    if needs_separator {
        out.push(PATH_SEPARATOR);
    }
    let mut j: UInt64 = 0u64;
    while j < name.len() {
        out.push(name[j]);
        j = j + 1u64;
    }
    out
}

/// Join a child onto a base path.
///
/// **An absolute child is rejected, not silently allowed to replace the base.** The convention
/// where joining an absolute path discards everything to its left is a well-known source of path
/// traversal: a caller that joins user input onto a trusted prefix loses the prefix without any
/// diagnostic. Here it is `InvalidInput`.
pub fn path_join(base: &str, child: &str) -> Result<String, FileError> {
    if !path_is_valid(child) {
        return Err(FileError::InvalidInput);
    }
    if path_is_absolute(child) {
        return Err(FileError::InvalidInput);
    }
    let child_bytes = child.bytes();
    let mut name: Vec<UInt8> = Vec::new();
    let mut i: UInt64 = 0u64;
    while i < child_bytes.len() {
        name.push(child_bytes[i]);
        i = i + 1u64;
    }
    decode_valid_utf8(&join_bytes(base, &name))
}

// ----------------------------------------------------------- whole-path effects --

pub fn remove_file(path: &str) -> Result<(), FileError> {
    match file_remove_raw(path.bytes()) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn rename(from: &str, to: &str) -> Result<(), FileError> {
    match file_rename_raw(from.bytes(), to.bytes()) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Copy, returning bytes written. An existing destination is OVERWRITTEN. A caller that must not
/// overwrite checks `path_exists` first and owns the race that check leaves open.
pub fn copy_file(from: &str, to: &str) -> Result<UInt64, FileError> {
    match file_copy_raw(from.bytes(), to.bytes()) {
        Ok(copied) => Ok(copied),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Create ONE directory. Not recursive: creating an unbounded number of directories from a single
/// call is exactly the kind of unbounded effect the capability model exists to keep visible.
pub fn create_dir(path: &str) -> Result<(), FileError> {
    match dir_create_raw(path.bytes()) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

/// Remove ONE EMPTY directory. There is deliberately no recursive delete in this package: it is the
/// most destructive filesystem primitive there is, and an unbounded one. Walk with `read_dir` and
/// remove what you have actually seen.
pub fn remove_dir(path: &str) -> Result<(), FileError> {
    match dir_remove_raw(path.bytes()) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

// ------------------------------------------------------------ directory listing --

const DIR_LIST_BUFFER_SIZE: UInt64 = 8192u64;

/// List a directory, bounded twice: by `max_entries` and by the snapshot buffer.
///
/// **A truncated listing is an error, never a short answer.** Returning the entries that happened
/// to fit would be indistinguishable from a directory that really has that many, and a caller
/// deleting "everything it listed" would silently miss the rest.
///
/// Each entry's `file_type` costs one metadata call, and symlinks are reported as symlinks rather
/// than as what they point at.
pub fn read_dir(path: &str, max_entries: UInt64) -> Result<Vec<DirectoryEntry>, FileError> {
    let mut scratch: [UInt8; 8192] = [0u8; 8192];
    let written: UInt64;
    let truncated: Bool;
    {
        let buffer = &mut scratch[0u64..DIR_LIST_BUFFER_SIZE];
        match dir_list_raw(path.bytes(), buffer) {
            Ok(result) => {
                written = result.0;
                truncated = result.2;
            }
            Err(error) => {
                return Err(map_io_error(error));
            }
        }
    }
    if truncated {
        return Err(FileError::LimitExceeded);
    }
    let mut out: Vec<DirectoryEntry> = Vec::new();
    let mut start: UInt64 = 0u64;
    let mut i: UInt64 = 0u64;
    while i < written {
        if scratch[i] == 0u8 {
            let mut name_bytes: Vec<UInt8> = Vec::new();
            let mut j: UInt64 = start;
            while j < i {
                name_bytes.push(scratch[j]);
                j = j + 1u64;
            }
            if out.len() >= max_entries {
                return Err(FileError::LimitExceeded);
            }
            let name = decode_valid_utf8(&name_bytes)?;
            let joined = join_bytes(path, &name_bytes);
            let child_path = decode_valid_utf8(&joined)?;
            let kind: FileType;
            match path_metadata_raw(&joined[0u64..joined.len()]) {
                Ok(m) => {
                    kind = file_type_of(m.0);
                }
                Err(error) => {
                    return Err(map_io_error(error));
                }
            }
            out.push(DirectoryEntry {
                name: name,
                path: child_path,
                file_type: kind,
            });
            start = i + 1u64;
        }
        i = i + 1u64;
    }
    Ok(out)
}

// Package unit tests, run by `stark test`. See `src/tests.stark`.
mod tests;
