// stark-io minimal native file I/O slice.
//
// `NativeFile` is synthesized from starkpkg.json provider_api as an opaque host-resource nominal
// bound to the first-party filesystem provider resource `io_file`.
//
// `io_file`, NOT `file`: `file` is Core-owned — the compiler binds it to `CoreType::File` on the
// legacy path and CD-224 forbids a package from claiming it. `io_file` is this package's own
// resource identity, wholly on the host-resource path, so a `NativeFile` is owned, moved and closed
// exactly once by MIR with no compiler guard weakened. Core `File` is untouched and its own
// migration remains open.

pub enum FileError {
    NotFound,
    PermissionDenied,
    InvalidInput,
    InvalidData,
    IsDirectory,
    AlreadyExists,
    Unsupported,
    LimitExceeded,
    UnexpectedEof,
    WriteZero,
    Other,
}

pub enum SeekFrom {
    Start(UInt64),
    Current(Int64),
    End(Int64),
}

pub enum FileType {
    File,
    Directory,
    Symlink,
    Other,
}

pub struct FileMetadata {
    pub file_type: FileType,
    pub length: UInt64,
    pub readonly: Bool,
    pub modified_seconds: Option<Int64>,
    pub accessed_seconds: Option<Int64>,
    pub created_seconds: Option<Int64>,
}

pub struct DirectoryEntry {
    pub name: String,
    pub path: String,
    pub file_type: FileType,
}

pub struct OpenOptions {
    pub read: Bool,
    pub write: Bool,
    pub append: Bool,
    pub truncate: Bool,
    pub create: Bool,
    pub create_new: Bool,
}

const READ_TO_END_CHUNK_SIZE: UInt64 = 8192u64;
const U64_MAX: UInt64 = 18446744073709551615u64;

pub fn default_open_options() -> OpenOptions {
    OpenOptions {
        read: false,
        write: false,
        append: false,
        truncate: false,
        create: false,
        create_new: false,
    }
}

pub fn open_options_are_valid(options: &OpenOptions) -> Bool {
    let can_access = options.read || options.write || options.append;
    if !can_access {
        return false;
    }
    if options.truncate && !options.write {
        return false;
    }
    if options.create && !options.write && !options.append {
        return false;
    }
    if options.create_new && !options.write && !options.append {
        return false;
    }
    true
}

pub fn path_is_valid(path: &str) -> Bool {
    if path.len() == 0u64 {
        return false;
    }
    let bytes = path.bytes();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        if bytes[i] == 0u8 {
            return false;
        }
        i = i + 1u64;
    }
    true
}

pub fn path_is_absolute(path: &str) -> Bool {
    if path.len() == 0u64 {
        return false;
    }
    let bytes = path.bytes();
    if bytes[0u64] == 47u8 {
        return true;
    }
    if path.len() >= 3u64 && bytes[1u64] == 58u8 && (bytes[2u64] == 47u8 || bytes[2u64] == 92u8) {
        return true;
    }
    false
}

fn map_io_error(error: RawFileError) -> FileError {
    match error {
        RawFileError::NotFound => FileError::NotFound,
        RawFileError::PermissionDenied => FileError::PermissionDenied,
        RawFileError::InvalidInput => FileError::InvalidInput,
        RawFileError::InvalidData => FileError::InvalidData,
        RawFileError::IsDirectory => FileError::IsDirectory,
        RawFileError::AlreadyExists => FileError::AlreadyExists,
        RawFileError::Unsupported => FileError::Unsupported,
        RawFileError::Other => FileError::Other,
    }
}

fn is_continuation(byte: UInt8) -> Bool {
    byte >= 0x80u8 && byte <= 0xBFu8
}

fn codepoint_char(codepoint: UInt32) -> Result<Char, FileError> {
    if codepoint > 0x10FFFFu32 {
        return Err(FileError::InvalidData);
    }
    if codepoint >= 0xD800u32 && codepoint <= 0xDFFFu32 {
        return Err(FileError::InvalidData);
    }
    match Char::from_u32(codepoint) {
        Some(ch) => Ok(ch),
        None => Err(FileError::InvalidData),
    }
}

fn decode_valid_utf8(bytes: &Vec<UInt8>) -> Result<String, FileError> {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        let b0 = bytes[i];
        if b0 < 0x80u8 {
            out.push(codepoint_char(b0 as UInt32)?);
            i = i + 1u64;
        } else if b0 >= 0xC2u8 && b0 <= 0xDFu8 {
            if i + 1u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x1Fu32) << 6u32) | (bytes[i + 1u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 2u64;
        } else if b0 == 0xE0u8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0xA0u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 >= 0xE1u8 && b0 <= 0xECu8 {
            if i + 2u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 == 0xEDu8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x9Fu8 || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 >= 0xEEu8 && b0 <= 0xEFu8 {
            if i + 2u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x0Fu32) << 12u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 2u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 3u64;
        } else if b0 == 0xF0u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x90u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x07u32) << 18u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 12u32) | ((bytes[i + 2u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 3u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 4u64;
        } else if b0 >= 0xF1u8 && b0 <= 0xF3u8 {
            if i + 3u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x07u32) << 18u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 12u32) | ((bytes[i + 2u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 3u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 4u64;
        } else if b0 == 0xF4u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x8Fu8 || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(FileError::InvalidData);
            }
            let code = ((b0 as UInt32 & 0x07u32) << 18u32) | ((bytes[i + 1u64] as UInt32 & 0x3Fu32) << 12u32) | ((bytes[i + 2u64] as UInt32 & 0x3Fu32) << 6u32) | (bytes[i + 3u64] as UInt32 & 0x3Fu32);
            out.push(codepoint_char(code)?);
            i = i + 4u64;
        } else {
            return Err(FileError::InvalidData);
        }
    }
    Ok(out)
}

pub fn open_file(path: &str) -> Result<NativeFile, FileError> {
    match file_open_raw(path.bytes()) {
        Ok(file) => Ok(file),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn create_file(path: &str) -> Result<NativeFile, FileError> {
    match file_create_raw(path.bytes()) {
        Ok(file) => Ok(file),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn file_read(file: &NativeFile, buffer: &mut [UInt8]) -> Result<UInt64, FileError> {
    match file_read_raw(file, buffer) {
        Ok(result) => Ok(result.0),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn file_write(file: &NativeFile, data: &[UInt8]) -> Result<UInt64, FileError> {
    match file_write_raw(file, data) {
        Ok(count) => Ok(count),
        Err(error) => Err(map_io_error(error)),
    }
}

pub fn file_flush(file: &NativeFile) -> Result<(), FileError> {
    match file_flush_raw(file) {
        Ok(_) => Ok(()),
        Err(error) => Err(map_io_error(error)),
    }
}

// Taking `file` BY VALUE is the close. `NativeFile` is a host resource, so MIR owns its only
// destruction path (A11 §5 rule 4): the handle is owned by this function, nothing moves it out, and
// drop elaboration emits the provider close exactly once when it goes out of scope. Calling the
// close symbol directly is rejected as a second destruction path — correctly, because both would
// run.
//
// The consequence for this signature: a close error is not observable. A destructor has nowhere to
// put a `Result`, which is why this returns `Ok` unconditionally rather than pretending to report
// one. A program that must observe flush failure should call `file_flush` before dropping, where the
// error IS returned.
pub fn file_close(file: NativeFile) -> Result<(), FileError> {
    Ok(())
}

pub fn file_write_all(file: &NativeFile, data: &[UInt8]) -> Result<(), FileError> {
    let mut written: UInt64 = 0u64;
    while written < data.len() {
        let remaining = &data[written..data.len()];
        let count = file_write(file, remaining)?;
        if count == 0u64 {
            return Err(FileError::WriteZero);
        }
        written = written + count;
    }
    Ok(())
}

pub fn file_write_str(file: &NativeFile, text: &str) -> Result<UInt64, FileError> {
    file_write(file, text.bytes())
}

pub fn file_read_to_end(file: &NativeFile, max_bytes: UInt64) -> Result<Vec<UInt8>, FileError> {
    let mut out: Vec<UInt8> = Vec::new();
    let mut out_len: UInt64 = 0u64;
    let mut scratch: [UInt8; 8192] = [0u8; 8192];
    let mut done = false;
    while !done {
        let read_count: UInt64;
        {
            let buffer = &mut scratch[0u64..READ_TO_END_CHUNK_SIZE];
            read_count = file_read(file, buffer)?;
        }
        if read_count == 0u64 {
            done = true;
        } else if out_len > max_bytes || read_count > max_bytes - out_len {
            return Err(FileError::LimitExceeded);
        } else {
            let mut i: UInt64 = 0u64;
            while i < read_count {
                out.push(scratch[i]);
                i = i + 1u64;
            }
            out_len = out_len + read_count;
        }
    }
    Ok(out)
}

pub fn file_read_to_string(file: &NativeFile, max_bytes: UInt64) -> Result<String, FileError> {
    let bytes = file_read_to_end(file, max_bytes)?;
    decode_valid_utf8(&bytes)
}

pub fn read(path: &str, max_bytes: UInt64) -> Result<Vec<UInt8>, FileError> {
    let file = open_file(path)?;
    let result = file_read_to_end(&file, max_bytes);
    match result {
        Ok(bytes) => {
            file_close(file)?;
            Ok(bytes)
        }
        Err(error) => {
            let _close_result = file_close(file);
            Err(error)
        }
    }
}

pub fn read_text(path: &str, max_bytes: UInt64) -> Result<String, FileError> {
    let file = open_file(path)?;
    let result = file_read_to_string(&file, max_bytes);
    match result {
        Ok(text) => {
            file_close(file)?;
            Ok(text)
        }
        Err(error) => {
            let _close_result = file_close(file);
            Err(error)
        }
    }
}

pub fn write(path: &str, data: &[UInt8]) -> Result<(), FileError> {
    let file = create_file(path)?;
    let result = file_write_all(&file, data);
    match result {
        Ok(_) => {
            file_close(file)?;
            Ok(())
        }
        Err(error) => {
            let _close_result = file_close(file);
            Err(error)
        }
    }
}

pub fn write_text(path: &str, text: &str) -> Result<(), FileError> {
    write(path, text.bytes())
}
