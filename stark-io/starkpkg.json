{
  "name": "stark-io",
  "version": "0.1.0",
  "entry": "src/lib.stark",
  "capabilities": ["filesystem"],
  "dependencies": {},
  "provider_api": {
    "errors": {
      "filesystem": "RawFileError"
    },
    "resources": {
      "NativeFile": {
        "capability": "filesystem",
        "resource": "io_file"
      }
    },
    "functions": {
      "file_open_raw": {
        "capability": "filesystem",
        "symbol": "stark_iofile_open"
      },
      "file_create_raw": {
        "capability": "filesystem",
        "symbol": "stark_iofile_create"
      },
      "file_read_raw": {
        "capability": "filesystem",
        "symbol": "stark_iofile_read"
      },
      "file_write_raw": {
        "capability": "filesystem",
        "symbol": "stark_iofile_write"
      },
      "file_flush_raw": {
        "capability": "filesystem",
        "symbol": "stark_iofile_complete"
      },
      "file_close_raw": {
        "capability": "filesystem",
        "symbol": "stark_iofile_close"
      }
    }
  }
}
