trait Score {
    fn score(&self) -> Int32;
}
struct Alpha { v: Int32 }
struct Beta { v: Int32 }
impl Score for Alpha {
    fn score(&self) -> Int32 { 31 }
}
impl Score for Beta {
    fn score(&self) -> Int32 { 44 }
}
fn main() {
    let a: Alpha = Alpha { v: 0 };
    let b: Beta = Beta { v: 0 };
    assert_eq(a.score(), 31);
    assert_eq(b.score(), 44);
    print(a.score());
    print(b.score());
}
