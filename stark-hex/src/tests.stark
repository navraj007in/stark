use super::decode;
use super::encode_lower;
use super::encode_upper;
use super::HexError;

const FULL_LOWER: &str = "";
const FULL_UPPER: &str = "";

fn assert_encode(bytes: &[UInt8], lower: &str, upper: &str) {
    if encode_lower(bytes).as_str() != lower {
        panic("lower encode mismatch");
    }
    if encode_upper(bytes).as_str() != upper {
        panic("upper encode mismatch");
    }
}

fn assert_decode(text: &str, expected: &[UInt8]) {
    match decode(text) {
        Ok(actual) => {
            assert_vec_matches_slice(&actual, expected);
        }
        Err(_) => {
            panic("expected decode success");
        }
    }
}

fn assert_vec_matches_slice(actual: &Vec<UInt8>, expected: &[UInt8]) {
    if actual.len() != expected.len() {
        panic("byte vector length mismatch");
    }
    let mut i: UInt64 = 0u64;
    while i < expected.len() {
        if actual[i] != expected[i] {
            panic("byte vector content mismatch");
        }
        i = i + 1u64;
    }
}

fn assert_invalid_length(text: &str) {
    match decode(text) {
        Err(HexError::InvalidLength) => {}
        Err(_) => {
            panic("expected invalid length");
        }
        Ok(_) => {
            panic("expected decode failure");
        }
    }
}

fn assert_invalid_character(text: &str, index: UInt64, value: UInt8) {
    match decode(text) {
        Err(HexError::InvalidCharacter(actual_index, actual_value)) => {
            if actual_index != index || actual_value != value {
                panic("invalid character payload mismatch");
            }
        }
        Err(_) => {
            panic("expected invalid character");
        }
        Ok(_) => {
            panic("expected decode failure");
        }
    }
}

fn assert_invalid_character_from_string(text: &String, index: UInt64, value: UInt8) {
    match decode(text.as_str()) {
        Err(HexError::InvalidCharacter(actual_index, actual_value)) => {
            if actual_index != index || actual_value != value {
                panic("invalid character payload mismatch");
            }
        }
        Err(_) => {
            panic("expected invalid character");
        }
        Ok(_) => {
            panic("expected decode failure");
        }
    }
}

fn is_hex_ascii(byte: UInt8) -> Bool {
    byte >= 48u8 && byte <= 57u8 || byte >= 65u8 && byte <= 70u8 || byte >= 97u8 && byte <= 102u8
}

