pub enum HexError {
    InvalidLength,
    InvalidCharacter(UInt64, UInt8),
}

pub fn encode_lower(input: &[UInt8]) -> String {
    encode_with_case(input, false)
}

pub fn encode_upper(input: &[UInt8]) -> String {
    encode_with_case(input, true)
}

pub fn decode(input: &str) -> Result<Vec<UInt8>, HexError> {
    let bytes = input.bytes();
    let len = bytes.len();
    let mut scan: UInt64 = 0u64;

    while scan < len {
        match hex_value(bytes[scan]) {
            Some(_) => {}
            None => {
                return Err(HexError::InvalidCharacter(scan, bytes[scan]));
            }
        }
        scan = scan + 1u64;
    }

    if len % 2u64 != 0u64 {
        return Err(HexError::InvalidLength);
    }

    let mut out: Vec<UInt8> = Vec::new();
    let mut i: UInt64 = 0u64;
    while i < len {
        let high = hex_value(bytes[i]).unwrap();
        let low = hex_value(bytes[i + 1u64]).unwrap();
        out.push(high << 4u8 | low);
        i = i + 2u64;
    }

    Ok(out)
}

fn encode_with_case(input: &[UInt8], upper: Bool) -> String {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;
    while i < input.len() {
        let byte = input[i];
        let high = byte >> 4u8 & 0x0Fu8;
        let low = byte & 0x0Fu8;
        if upper {
            out.push(upper_hex_char(high));
            out.push(upper_hex_char(low));
        } else {
            out.push(lower_hex_char(high));
            out.push(lower_hex_char(low));
        }
        i = i + 1u64;
    }
    out
}

fn hex_value(byte: UInt8) -> Option<UInt8> {
    if byte >= 48u8 && byte <= 57u8 {
        Some(byte - 48u8)
    } else if byte >= 97u8 && byte <= 102u8 {
        Some(byte - 97u8 + 10u8)
    } else if byte >= 65u8 && byte <= 70u8 {
        Some(byte - 65u8 + 10u8)
    } else {
        None
    }
}

fn lower_hex_char(nibble: UInt8) -> Char {
    if nibble < 10u8 {
        digit_char(nibble)
    } else if nibble == 10u8 {
        'a'
    } else if nibble == 11u8 {
        'b'
    } else if nibble == 12u8 {
        'c'
    } else if nibble == 13u8 {
        'd'
    } else if nibble == 14u8 {
        'e'
    } else {
        'f'
    }
}

fn upper_hex_char(nibble: UInt8) -> Char {
    if nibble < 10u8 {
        digit_char(nibble)
    } else if nibble == 10u8 {
        'A'
    } else if nibble == 11u8 {
        'B'
    } else if nibble == 12u8 {
        'C'
    } else if nibble == 13u8 {
        'D'
    } else if nibble == 14u8 {
        'E'
    } else {
        'F'
    }
}

fn digit_char(nibble: UInt8) -> Char {
    if nibble == 0u8 {
        '0'
    } else if nibble == 1u8 {
        '1'
    } else if nibble == 2u8 {
        '2'
    } else if nibble == 3u8 {
        '3'
    } else if nibble == 4u8 {
        '4'
    } else if nibble == 5u8 {
        '5'
    } else if nibble == 6u8 {
        '6'
    } else if nibble == 7u8 {
        '7'
    } else if nibble == 8u8 {
        '8'
    } else {
        '9'
    }
}

mod tests;
