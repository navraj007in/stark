use stark_ascii::is_tchar;
use stark_ascii::string_eq_ignore_ascii_case;

pub struct MediaTypeParameter {
    pub name: String,
    pub value: String,
}

pub struct MediaType {
    pub type_name: String,
    pub subtype: String,
    pub parameters: Vec<MediaTypeParameter>,
}

pub struct MediaTypeLimits {
    pub max_total_bytes: UInt64,
    pub max_parameter_count: UInt64,
    pub max_parameter_name_bytes: UInt64,
    pub max_parameter_value_bytes: UInt64,
}

pub enum MediaTypeError {
    EmptyType,
    EmptySubtype,
    MissingSlash,
    InvalidTokenByte(UInt64, UInt8),
    MalformedQuote(UInt64),
    ExceededTotalBytesLimit,
    ExceededParameterCountLimit,
    ExceededParameterNameLimit,
    ExceededParameterValueLimit,
}

pub fn default_limits() -> MediaTypeLimits {
    MediaTypeLimits {
        max_total_bytes: 4096u64,
        max_parameter_count: 32u64,
        max_parameter_name_bytes: 128u64,
        max_parameter_value_bytes: 1024u64,
    }
}

pub fn parse_media_type(input: &String, limits: MediaTypeLimits) -> Result<MediaType, MediaTypeError> {
    let bytes = input.bytes();
    let len = bytes.len();

    if len > limits.max_total_bytes {
        return Err(MediaTypeError::ExceededTotalBytesLimit);
    }

    let mut idx: UInt64 = 0u64;

    while idx < len && is_ws(bytes[idx]) {
        idx = idx + 1u64;
    }

    let type_start = idx;
    while idx < len && is_tchar(bytes[idx]) {
        idx = idx + 1u64;
    }
    if idx == type_start {
        return Err(MediaTypeError::EmptyType);
    }
    let type_name = slice_to_string(bytes, type_start, idx);

    if idx >= len || bytes[idx] != 47u8 {
        return Err(MediaTypeError::MissingSlash);
    }
    idx = idx + 1u64;

    let subtype_start = idx;
    while idx < len && is_tchar(bytes[idx]) {
        idx = idx + 1u64;
    }
    if idx == subtype_start {
        return Err(MediaTypeError::EmptySubtype);
    }
    let subtype = slice_to_string(bytes, subtype_start, idx);

    let mut params = Vec::new();

    while idx < len {
        while idx < len && is_ws(bytes[idx]) {
            idx = idx + 1u64;
        }
        if idx >= len {
            break;
        }

        if bytes[idx] != 59u8 {
            return Err(MediaTypeError::InvalidTokenByte(idx, bytes[idx]));
        }
        idx = idx + 1u64;

        while idx < len && is_ws(bytes[idx]) {
            idx = idx + 1u64;
        }
        if idx >= len {
            break;
        }

        if params.len() >= limits.max_parameter_count {
            return Err(MediaTypeError::ExceededParameterCountLimit);
        }

        let name_start = idx;
        while idx < len && is_tchar(bytes[idx]) {
            idx = idx + 1u64;
        }
        if idx == name_start {
            return Err(MediaTypeError::InvalidTokenByte(idx, if idx < len { bytes[idx] } else { 0u8 }));
        }
        let name_len = idx - name_start;
        if name_len > limits.max_parameter_name_bytes {
            return Err(MediaTypeError::ExceededParameterNameLimit);
        }
        let param_name = slice_to_string(bytes, name_start, idx);

        while idx < len && is_ws(bytes[idx]) {
            idx = idx + 1u64;
        }
        if idx >= len || bytes[idx] != 61u8 {
            return Err(MediaTypeError::InvalidTokenByte(idx, if idx < len { bytes[idx] } else { 0u8 }));
        }
        idx = idx + 1u64;

        while idx < len && is_ws(bytes[idx]) {
            idx = idx + 1u64;
        }
        if idx >= len {
            return Err(MediaTypeError::InvalidTokenByte(idx, 0u8));
        }

        let mut param_val = String::new();
        if bytes[idx] == 34u8 {
            let quote_start = idx;
            idx = idx + 1u64;
            let mut val_str = String::new();
            let mut closed = false;
            while idx < len {
                let b = bytes[idx];
                if b == 92u8 {
                    if idx + 1u64 >= len {
                        return Err(MediaTypeError::MalformedQuote(quote_start));
                    }
                    idx = idx + 1u64;
                    val_str.push(direct_ascii_char(bytes[idx]));
                } else if b == 34u8 {
                    closed = true;
                    idx = idx + 1u64;
                    break;
                } else {
                    val_str.push(direct_ascii_char(b));
                }
                idx = idx + 1u64;
            }
            if !closed {
                return Err(MediaTypeError::MalformedQuote(quote_start));
            }
            if val_str.len() > limits.max_parameter_value_bytes {
                return Err(MediaTypeError::ExceededParameterValueLimit);
            }
            param_val = val_str;
        } else {
            let val_start = idx;
            while idx < len && is_tchar(bytes[idx]) {
                idx = idx + 1u64;
            }
            let val_len = idx - val_start;
            if val_len > limits.max_parameter_value_bytes {
                return Err(MediaTypeError::ExceededParameterValueLimit);
            }
            param_val = slice_to_string(bytes, val_start, idx);
        }

        params.push(MediaTypeParameter {
            name: param_name,
            value: param_val,
        });
    }

    Ok(MediaType {
        type_name,
        subtype,
        parameters: params,
    })
}

pub fn format_media_type(media_type: &MediaType) -> String {
    let mut out = String::new();
    out.push_str(media_type.type_name.as_str());
    out.push('/');
    out.push_str(media_type.subtype.as_str());

    let mut i: UInt64 = 0u64;
    while i < media_type.parameters.len() {
        let p = &media_type.parameters[i];
        out.push_str("; ");
        out.push_str(p.name.as_str());
        out.push('=');
        let val_ref = p.value.as_str();
        if needs_quotes(val_ref.bytes()) {
            out.push('"');
            let vb = val_ref.bytes();
            let mut j: UInt64 = 0u64;
            while j < vb.len() {
                let b = vb[j];
                if b == 34u8 || b == 92u8 {
                    out.push('\\');
                }
                out.push(direct_ascii_char(b));
                j = j + 1u64;
            }
            out.push('"');
        } else {
            out.push_str(p.value.as_str());
        }
        i = i + 1u64;
    }
    out
}

pub fn media_type_is(media_type: &MediaType, type_name: &String, subtype: &String) -> Bool {
    string_eq_ignore_ascii_case(&media_type.type_name, type_name) && string_eq_ignore_ascii_case(&media_type.subtype, subtype)
}

pub fn media_type_parameter(media_type: &MediaType, name: &String) -> Option<String> {
    let mut i: UInt64 = 0u64;
    while i < media_type.parameters.len() {
        if string_eq_ignore_ascii_case(&media_type.parameters[i].name, name) {
            return Some(String::from(media_type.parameters[i].value.as_str()));
        }
        i = i + 1u64;
    }
    None
}

impl MediaType {
    pub fn parse(input: &String, limits: MediaTypeLimits) -> Result<MediaType, MediaTypeError> {
        parse_media_type(input, limits)
    }

    pub fn format(&self) -> String {
        format_media_type(self)
    }

    pub fn is_type(&self, type_name: &String, subtype: &String) -> Bool {
        media_type_is(self, type_name, subtype)
    }

    pub fn parameter(&self, name: &String) -> Option<String> {
        media_type_parameter(self, name)
    }
}

fn needs_quotes(bytes: &[UInt8]) -> Bool {
    if bytes.len() == 0u64 {
        return true;
    }
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        if !is_tchar(bytes[i]) {
            return true;
        }
        i = i + 1u64;
    }
    false
}

fn is_ws(b: UInt8) -> Bool {
    b == 32u8 || b == 9u8
}

fn slice_to_string(bytes: &[UInt8], start: UInt64, end: UInt64) -> String {
    let mut s = String::new();
    let mut i = start;
    while i < end {
        s.push(direct_ascii_char(bytes[i]));
        i = i + 1u64;
    }
    s
}

fn direct_ascii_char(byte: UInt8) -> Char {
    if byte == 32u8 { ' ' }
    else if byte == 33u8 { '!' }
    else if byte == 34u8 { '"' }
    else if byte == 35u8 { '#' }
    else if byte == 36u8 { '$' }
    else if byte == 37u8 { '%' }
    else if byte == 38u8 { '&' }
    else if byte == 39u8 { '\'' }
    else if byte == 40u8 { '(' }
    else if byte == 41u8 { ')' }
    else if byte == 42u8 { '*' }
    else if byte == 43u8 { '+' }
    else if byte == 44u8 { ',' }
    else if byte == 45u8 { '-' }
    else if byte == 46u8 { '.' }
    else if byte == 47u8 { '/' }
    else if byte == 48u8 { '0' }
    else if byte == 49u8 { '1' }
    else if byte == 50u8 { '2' }
    else if byte == 51u8 { '3' }
    else if byte == 52u8 { '4' }
    else if byte == 53u8 { '5' }
    else if byte == 54u8 { '6' }
    else if byte == 55u8 { '7' }
    else if byte == 56u8 { '8' }
    else if byte == 57u8 { '9' }
    else if byte == 58u8 { ':' }
    else if byte == 59u8 { ';' }
    else if byte == 60u8 { '<' }
    else if byte == 61u8 { '=' }
    else if byte == 62u8 { '>' }
    else if byte == 63u8 { '?' }
    else if byte == 64u8 { '@' }
    else if byte == 65u8 { 'A' }
    else if byte == 66u8 { 'B' }
    else if byte == 67u8 { 'C' }
    else if byte == 68u8 { 'D' }
    else if byte == 69u8 { 'E' }
    else if byte == 70u8 { 'F' }
    else if byte == 71u8 { 'G' }
    else if byte == 72u8 { 'H' }
    else if byte == 73u8 { 'I' }
    else if byte == 74u8 { 'J' }
    else if byte == 75u8 { 'K' }
    else if byte == 76u8 { 'L' }
    else if byte == 77u8 { 'M' }
    else if byte == 78u8 { 'N' }
    else if byte == 79u8 { 'O' }
    else if byte == 80u8 { 'P' }
    else if byte == 81u8 { 'Q' }
    else if byte == 82u8 { 'R' }
    else if byte == 83u8 { 'S' }
    else if byte == 84u8 { 'T' }
    else if byte == 85u8 { 'U' }
    else if byte == 86u8 { 'V' }
    else if byte == 87u8 { 'W' }
    else if byte == 88u8 { 'X' }
    else if byte == 89u8 { 'Y' }
    else if byte == 90u8 { 'Z' }
    else if byte == 91u8 { '[' }
    else if byte == 92u8 { '\\' }
    else if byte == 93u8 { ']' }
    else if byte == 94u8 { '^' }
    else if byte == 95u8 { '_' }
    else if byte == 96u8 { '`' }
    else if byte == 97u8 { 'a' }
    else if byte == 98u8 { 'b' }
    else if byte == 99u8 { 'c' }
    else if byte == 100u8 { 'd' }
    else if byte == 101u8 { 'e' }
    else if byte == 102u8 { 'f' }
    else if byte == 103u8 { 'g' }
    else if byte == 104u8 { 'h' }
    else if byte == 105u8 { 'i' }
    else if byte == 106u8 { 'j' }
    else if byte == 107u8 { 'k' }
    else if byte == 108u8 { 'l' }
    else if byte == 109u8 { 'm' }
    else if byte == 110u8 { 'n' }
    else if byte == 111u8 { 'o' }
    else if byte == 112u8 { 'p' }
    else if byte == 113u8 { 'q' }
    else if byte == 114u8 { 'r' }
    else if byte == 115u8 { 's' }
    else if byte == 116u8 { 't' }
    else if byte == 117u8 { 'u' }
    else if byte == 118u8 { 'v' }
    else if byte == 119u8 { 'w' }
    else if byte == 120u8 { 'x' }
    else if byte == 121u8 { 'y' }
    else if byte == 122u8 { 'z' }
    else if byte == 123u8 { '{' }
    else if byte == 124u8 { '|' }
    else if byte == 125u8 { '}' }
    else if byte == 126u8 { '~' }
    else { '?' }
}
