pub struct Uuid { bytes: [UInt8; 16] }

/// Why a UUID could not be produced. The first three describe malformed text given to [parse]; the
/// last two describe field values given to [v7_from_parts] that do not fit the layout RFC 9562
/// defines for them.
pub enum UuidError {
    InvalidLength(UInt64),
    InvalidHyphen(UInt64),
    InvalidCharacter(UInt64, UInt8),
    TimestampOutOfRange(UInt64),
    RandomFieldOutOfRange(UInt16),
}

pub enum UuidVariant {
    Ncs,
    Rfc4122,
    Microsoft,
    Future,
}

pub fn nil() -> Uuid {
    Uuid { bytes: [0u8; 16] }
}

pub fn from_bytes(bytes: [UInt8; 16]) -> Uuid {
    Uuid { bytes: bytes }
}

pub fn v4_from_random_bytes(mut bytes: [UInt8; 16]) -> Uuid {
    bytes[6u64] = bytes[6u64] & 0x0Fu8 | 0x40u8;
    bytes[8u64] = bytes[8u64] & 0x3Fu8 | 0x80u8;
    Uuid { bytes: bytes }
}

/// A version 7 UUID from its parts: a 48-bit Unix millisecond timestamp, a 12-bit `rand_a` field,
/// and 64 random bits (the top two of which are replaced by the RFC 4122 variant marker).
///
/// **Values that do not fit are rejected, not truncated.** Both fields used to be masked down
/// silently — `unix_millis & 0x0000_FFFF_FFFF_FFFF` and `rand_a & 0x0FFF` — so a timestamp past
/// year 10889, or a caller passing 16 bits of randomness because `rand_a` is a `UInt16`, produced a
/// perfectly well-formed UUID encoding a different instant or different entropy than was asked for.
/// A UUID's whole job is to be the value you were given; silently returning another one is worse
/// than refusing, because nothing downstream can tell.
pub fn v7_from_parts(unix_millis: UInt64, rand_a: UInt16, random_tail: [UInt8; 8]) -> Result<Uuid, UuidError> {
    if unix_millis > 0x0000_FFFF_FFFF_FFFFu64 {
        return Err(UuidError::TimestampOutOfRange(unix_millis));
    }
    if rand_a > 0x0FFFu16 {
        return Err(UuidError::RandomFieldOutOfRange(rand_a));
    }
    let timestamp = unix_millis;
    let mut bytes: [UInt8; 16] = [0u8; 16];
    bytes[0u64] = (timestamp >> 40u64 & 0xFFu64) as UInt8;
    bytes[1u64] = (timestamp >> 32u64 & 0xFFu64) as UInt8;
    bytes[2u64] = (timestamp >> 24u64 & 0xFFu64) as UInt8;
    bytes[3u64] = (timestamp >> 16u64 & 0xFFu64) as UInt8;
    bytes[4u64] = (timestamp >> 8u64 & 0xFFu64) as UInt8;
    bytes[5u64] = (timestamp & 0xFFu64) as UInt8;
    bytes[6u64] = 0x70u8 | (rand_a >> 8u16 & 0x0Fu16) as UInt8;
    bytes[7u64] = (rand_a & 0xFFu16) as UInt8;
    bytes[8u64] = random_tail[0u64] & 0x3Fu8 | 0x80u8;
    let mut i = 1u64;
    while i < 8u64 {
        bytes[8u64 + i] = random_tail[i];
        i = i + 1u64;
    }
    Ok(Uuid { bytes: bytes })
}

pub fn as_bytes(uuid: &Uuid) -> [UInt8; 16] {
    uuid.bytes
}

pub fn parse(input: &str) -> Result<Uuid, UuidError> {
    let raw = input.bytes();
    let len = raw.len();
    if len != 36u64 {
        return Err(UuidError::InvalidLength(len));
    }

    let mut bytes: [UInt8; 16] = [0u8; 16];
    let mut i: UInt64 = 0u64;
    let mut out: UInt64 = 0u64;
    while i < len {
        if is_hyphen_position(i) {
            if raw[i] != 45u8 {
                return Err(UuidError::InvalidHyphen(i));
            }
            i = i + 1u64;
        } else {
            if raw[i] == 45u8 {
                return Err(UuidError::InvalidHyphen(i));
            }
            let high_opt = hex_value(raw[i]);
            if !high_opt.is_some() {
                return Err(UuidError::InvalidCharacter(i, raw[i]));
            }
            let high = high_opt.unwrap();
            let low_index = i + 1u64;
            if is_hyphen_position(low_index) {
                return Err(UuidError::InvalidHyphen(low_index));
            }
            let low_opt = hex_value(raw[low_index]);
            if !low_opt.is_some() {
                if raw[low_index] == 45u8 {
                    return Err(UuidError::InvalidHyphen(low_index));
                }
                return Err(UuidError::InvalidCharacter(low_index, raw[low_index]));
            }
            let low = low_opt.unwrap();
            bytes[out] = high << 4u8 | low;
            out = out + 1u64;
            i = i + 2u64;
        }
    }

    Ok(Uuid { bytes: bytes })
}

pub fn format(uuid: &Uuid) -> String {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;
    while i < 16u64 {
        if i == 4u64 || i == 6u64 || i == 8u64 || i == 10u64 {
            out.push('-');
        }
        let byte = uuid.bytes[i];
        out.push(lower_hex_char(byte >> 4u8 & 0x0Fu8));
        out.push(lower_hex_char(byte & 0x0Fu8));
        i = i + 1u64;
    }
    out
}

pub fn version(uuid: &Uuid) -> Option<UInt8> {
    let value = uuid.bytes[6u64] >> 4u8 & 0x0Fu8;
    if value == 0u8 {
        None
    } else {
        Some(value)
    }
}

pub fn variant(uuid: &Uuid) -> UuidVariant {
    let value = uuid.bytes[8u64];
    if value & 0x80u8 == 0u8 {
        UuidVariant::Ncs
    } else if value & 0xC0u8 == 0x80u8 {
        UuidVariant::Rfc4122
    } else if value & 0xE0u8 == 0xC0u8 {
        UuidVariant::Microsoft
    } else {
        UuidVariant::Future
    }
}

pub fn is_nil(uuid: &Uuid) -> Bool {
    let mut i: UInt64 = 0u64;
    while i < 16u64 {
        if uuid.bytes[i] != 0u8 {
            return false;
        }
        i = i + 1u64;
    }
    true
}

pub fn equals(left: &Uuid, right: &Uuid) -> Bool {
    compare(left, right) == 0i32
}

pub fn compare(left: &Uuid, right: &Uuid) -> Int32 {
    let mut i: UInt64 = 0u64;
    while i < 16u64 {
        if left.bytes[i] < right.bytes[i] {
            return -1i32;
        }
        if left.bytes[i] > right.bytes[i] {
            return 1i32;
        }
        i = i + 1u64;
    }
    0i32
}

fn is_hyphen_position(index: UInt64) -> Bool {
    index == 8u64 || index == 13u64 || index == 18u64 || index == 23u64
}

fn hex_value(byte: UInt8) -> Option<UInt8> {
    if byte >= 48u8 && byte <= 57u8 {
        Some(byte - 48u8)
    } else if byte >= 97u8 && byte <= 102u8 {
        Some(byte - 97u8 + 10u8)
    } else if byte >= 65u8 && byte <= 70u8 {
        Some(byte - 65u8 + 10u8)
    } else {
        None
    }
}

fn lower_hex_char(nibble: UInt8) -> Char {
    if nibble < 10u8 {
        digit_char(nibble)
    } else if nibble == 10u8 {
        'a'
    } else if nibble == 11u8 {
        'b'
    } else if nibble == 12u8 {
        'c'
    } else if nibble == 13u8 {
        'd'
    } else if nibble == 14u8 {
        'e'
    } else {
        'f'
    }
}

fn digit_char(nibble: UInt8) -> Char {
    if nibble == 0u8 {
        '0'
    } else if nibble == 1u8 {
        '1'
    } else if nibble == 2u8 {
        '2'
    } else if nibble == 3u8 {
        '3'
    } else if nibble == 4u8 {
        '4'
    } else if nibble == 5u8 {
        '5'
    } else if nibble == 6u8 {
        '6'
    } else if nibble == 7u8 {
        '7'
    } else if nibble == 8u8 {
        '8'
    } else {
        '9'
    }
}

mod tests;
