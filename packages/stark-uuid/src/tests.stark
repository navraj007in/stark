use super::as_bytes;
use super::compare;
use super::equals;
use super::format;
use super::from_bytes;
use super::is_nil;
use super::nil;
use super::parse;
use super::variant;
use super::v4_from_random_bytes;
use super::v7_from_parts;
use super::version;
use super::UuidError;
use super::UuidVariant;

fn assert_parse_format(input: &str, expected: &str) {
    match parse(input) {
        Ok(uuid) => {
            if format(&uuid).as_str() != expected {
                panic("uuid format mismatch");
            }
            match parse(format(&uuid).as_str()) {
                Ok(roundtrip) => {
                    if !equals(&uuid, &roundtrip) {
                        panic("uuid roundtrip mismatch");
                    }
                }
                Err(_) => {
                    panic("uuid roundtrip parse failed");
                }
            }
        }
        Err(_) => {
            panic("uuid parse failed");
        }
    }
}

fn assert_invalid_length(input: &str, len: UInt64) {
    match parse(input) {
        Err(UuidError::InvalidLength(actual)) => {
            if actual != len {
                panic("uuid invalid length payload mismatch");
            }
        }
        Err(_) => {
            panic("expected uuid invalid length");
        }
        Ok(_) => {
            panic("expected uuid parse failure");
        }
    }
}

fn assert_invalid_hyphen(input: &str, index: UInt64) {
    match parse(input) {
        Err(UuidError::InvalidHyphen(actual)) => {
            if actual != index {
                panic("uuid invalid hyphen payload mismatch");
            }
        }
        Err(_) => {
            panic("expected uuid invalid hyphen");
        }
        Ok(_) => {
            panic("expected uuid parse failure");
        }
    }
}

fn assert_invalid_character(input: &str, index: UInt64, value: UInt8) {
    match parse(input) {
        Err(UuidError::InvalidCharacter(actual_index, actual_value)) => {
            if actual_index != index || actual_value != value {
                panic("uuid invalid character payload mismatch");
            }
        }
        Err(_) => {
            panic("expected uuid invalid character");
        }
        Ok(_) => {
            panic("expected uuid parse failure");
        }
    }
}

fn test_rfc_vectors_and_lowercase_formatting() {
    assert_parse_format(
        "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
        "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
    );
    assert_parse_format(
        "F81D4FAE-7DEC-11D0-A765-00A0C91E6BF6",
        "f81d4fae-7dec-11d0-a765-00a0c91e6bf6",
    );
    assert_parse_format(
        "00000000-0000-0000-0000-000000000000",
        "00000000-0000-0000-0000-000000000000",
    );
}

fn test_from_bytes_as_bytes_and_nil() {
    let bytes: [UInt8; 16] = [
        0xf8u8,
        0x1du8,
        0x4fu8,
        0xaeu8,
        0x7du8,
        0xecu8,
        0x11u8,
        0xd0u8,
        0xa7u8,
        0x65u8,
        0x00u8,
        0xa0u8,
        0xc9u8,
        0x1eu8,
        0x6bu8,
        0xf6u8,
    ];
    let uuid = from_bytes(bytes);
    if format(&uuid).as_str() != "f81d4fae-7dec-11d0-a765-00a0c91e6bf6" {
        panic("uuid from bytes format mismatch");
    }
    let actual = as_bytes(&uuid);
    if actual[0u64] != 0xf8u8 || actual[15u64] != 0xf6u8 {
        panic("uuid as bytes mismatch");
    }
    if !is_nil(&nil()) {
        panic("nil uuid expected");
    }
    if is_nil(&uuid) {
        panic("non-nil uuid expected");
    }
}

fn test_version_and_variant() {
    match parse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6") {
        Ok(uuid) => {
            match version(&uuid) {
                Some(value) => {
                    if value != 1u8 {
                        panic("uuid version mismatch");
                    }
                }
                None => {
                    panic("uuid version missing");
                }
            }
            match variant(&uuid) {
                UuidVariant::Rfc4122 => {}
                _ => {
                    panic("uuid variant mismatch");
                }
            }
        }
        Err(_) => {
            panic("uuid parse failed");
        }
    }

    match version(&nil()) {
        None => {}
        Some(_) => {
            panic("nil uuid version expected none");
        }
    }
}

fn test_v4_constructor_sets_version_and_variant_bits() {
    let uuid = v4_from_random_bytes(
        [
            0x00u8,
            0x11u8,
            0x22u8,
            0x33u8,
            0x44u8,
            0x55u8,
            0xffu8,
            0x77u8,
            0xffu8,
            0x99u8,
            0xaau8,
            0xbbu8,
            0xccu8,
            0xddu8,
            0xeeu8,
            0xffu8,
        ],
    );
    if format(&uuid).as_str() != "00112233-4455-4f77-bf99-aabbccddeeff" {
        panic("uuid v4 constructor format mismatch");
    }
    match version(&uuid) {
        Some(v) => {
            if v != 4u8 {
                panic("uuid v4 version mismatch");
            }
        }
        None => panic("uuid v4 version missing"),
    }
    match variant(&uuid) {
        UuidVariant::Rfc4122 => {}
        _ => panic("uuid v4 variant mismatch"),
    }
}

fn test_v7_constructor_orders_by_timestamp_then_random_fields() {
    let tail: [UInt8; 8] = [0x00u8, 0x11u8, 0x22u8, 0x33u8, 0x44u8, 0x55u8, 0x66u8, 0x77u8];
    let a = v7_from_parts(0x0000_018f_f4c0_0000u64, 0x0123u16, tail);
    let b = v7_from_parts(0x0000_018f_f4c0_0001u64, 0x0000u16, tail);
    if format(&a).as_str() != "018ff4c0-0000-7123-8011-223344556677" {
        panic("uuid v7 format mismatch");
    }
    match version(&a) {
        Some(v) => {
            if v != 7u8 {
                panic("uuid v7 version mismatch");
            }
        }
        None => panic("uuid v7 version missing"),
    }
    match variant(&a) {
        UuidVariant::Rfc4122 => {}
        _ => panic("uuid v7 variant mismatch"),
    }
    if compare(&a, &b) != -1i32 {
        panic("uuid v7 timestamp ordering mismatch");
    }
}

fn test_variant_boundaries() {
    let ncs = from_bytes(
        [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0x7fu8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    );
    let rfc = from_bytes(
        [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0x80u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    );
    let ms = from_bytes(
        [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0xc0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    );
    let future = from_bytes(
        [0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0xe0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8],
    );

    match variant(&ncs) {
        UuidVariant::Ncs => {}
        _ => {
            panic("ncs variant mismatch");
        }
    }
    match variant(&rfc) {
        UuidVariant::Rfc4122 => {}
        _ => {
            panic("rfc variant mismatch");
        }
    }
    match variant(&ms) {
        UuidVariant::Microsoft => {}
        _ => {
            panic("microsoft variant mismatch");
        }
    }
    match variant(&future) {
        UuidVariant::Future => {}
        _ => {
            panic("future variant mismatch");
        }
    }
}

fn test_invalid_inputs() {
    assert_invalid_length("", 0u64);
    assert_invalid_length("f81d4fae-7dec-11d0-a765-00a0c91e6bf", 35u64);
    assert_invalid_length("f81d4fae-7dec-11d0-a765-00a0c91e6bf60", 37u64);
    assert_invalid_hyphen("f81d4faeX7dec-11d0-a765-00a0c91e6bf6", 8u64);
    assert_invalid_hyphen("f81d4fae-7decX11d0-a765-00a0c91e6bf6", 13u64);
    assert_invalid_hyphen("f81d4fae-7dec-11d0Xa765-00a0c91e6bf6", 18u64);
    assert_invalid_hyphen("f81d4fae-7dec-11d0-a765X00a0c91e6bf6", 23u64);
    assert_invalid_hyphen("f81d4fae-7dec-11d0-a765-00a0c91e-bf6", 32u64);
    assert_invalid_character("f81d4fae-7dec-11d0-a765-00a0c91e6bfg", 35u64, 103u8);
    assert_invalid_character("{81d4fae-7dec-11d0-a765-00a0c91e6bf6", 0u64, 123u8);
}

fn test_comparison() {
    let a = parse("00000000-0000-0000-0000-000000000001").unwrap();
    let b = parse("00000000-0000-0000-0000-000000000002").unwrap();
    let a2 = parse("00000000-0000-0000-0000-000000000001").unwrap();
    if compare(&a, &b) != -1i32 {
        panic("uuid compare less mismatch");
    }
    if compare(&b, &a) != 1i32 {
        panic("uuid compare greater mismatch");
    }
    if compare(&a, &a2) != 0i32 {
        panic("uuid compare equal mismatch");
    }
    if !equals(&a, &a2) || equals(&a, &b) {
        panic("uuid equals mismatch");
    }
}
