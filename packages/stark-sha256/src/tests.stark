        112u8,
        115u8,
        32u8,
        111u8,
        118u8,
        101u8,
        114u8,
        32u8,
        116u8,
        104u8,
        101u8,
        32u8,
        108u8,
        97u8,
        122u8,
        121u8,
        32u8,
        100u8,
        111u8,
        103u8,
    ];
    assert_hash(fox, "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592");
