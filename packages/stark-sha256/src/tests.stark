        106u8,
        104u8,
        105u8,
        106u8,
        107u8,
        105u8,
        106u8,
        107u8,
        108u8,
        106u8,
        107u8,
        108u8,
        109u8,
        107u8,
        108u8,
        109u8,
        110u8,
        108u8,
        109u8,
        110u8,
        111u8,
        109u8,
        110u8,
        111u8,
        112u8,
        110u8,
        111u8,
        112u8,
        113u8,
    ];
    assert_hash(multi, "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");

    let fox: &[UInt8] = &[
        84u8,
        104u8,
        101u8,
        32u8,
        113u8,
        117u8,
        105u8,
        99u8,
