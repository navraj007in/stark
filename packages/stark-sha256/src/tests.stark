use stark_digest::algorithm;
use stark_digest::bytes_copy;
use stark_digest::to_hex;
use stark_digest::DigestAlgorithm;
use super::hash;
use super::hash_hex;

fn assert_hash(input: &[UInt8], expected: &str) {
    if hash_hex(input).as_str() != expected {
        panic("sha256 vector mismatch");
    }
    let digest = hash(input);
    if to_hex(&digest).as_str() != expected {
        panic("digest hex mismatch");
    }
}

fn repeated_a(count: UInt64) -> Vec<UInt8> {
    let mut out: Vec<UInt8> = Vec::new();
    let mut i: UInt64 = 0u64;
    while i < count {
        out.push(97u8);
        i = i + 1u64;
    }
    out
}

fn bytes_0_to_255() -> Vec<UInt8> {
    let mut out: Vec<UInt8> = Vec::new();
    let mut i: UInt64 = 0u64;
    while i < 256u64 {
        out.push(i as UInt8);
        i = i + 1u64;
    }
    out
}

fn test_known_answer_vectors() {
