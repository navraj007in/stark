fn test_binary_domain_vector() {
    let bytes = bytes_0_to_255();
    assert_hash(
        bytes.as_slice(),
        "40aff2e9d2d8922e47afd4648e6967497158785fbd1da870e7110266bf944880",
    );
}

fn test_padding_boundary_vectors() {
    let a55 = repeated_a(55u64);
    assert_hash(a55.as_slice(), "9f4390f8d30c2dd92ec9f095b65e2b9ae9b0a925a5258e241c9f1e910f734318");

    let a56 = repeated_a(56u64);
    assert_hash(a56.as_slice(), "b35439a4ac6f0948b6d6f9e3c6af0f5f590ce20f1bde7090ef7970686ec6738a");

    let a63 = repeated_a(63u64);
    assert_hash(a63.as_slice(), "7d3e74a05d7db15bce4ad9ec0658ea98e3f06eeecf16b4c6fff2da457ddc2f34");

    let a64 = repeated_a(64u64);
    assert_hash(a64.as_slice(), "ffe054fe7ae0cb6dc65c3af9b61d5209f439851db43d0ba5997337df154668eb");

    let a65 = repeated_a(65u64);
    assert_hash(a65.as_slice(), "635361c48bb9eab14198e76ea8ab7f1a41685d6ad62aa9146d301d4f17eb0ae0");
}

fn test_digest_hex_algorithm_and_length() {
    let abc: &[UInt8] = &[97u8, 98u8, 99u8];
    let digest = hash(abc);
    match algorithm(&digest) {
        DigestAlgorithm::Sha256 => {}
    }
    let bytes = bytes_copy(&digest);
    if bytes.len() != 32u64 {
        panic("digest byte length mismatch");
    }
    let hex = hash_hex(abc);
    if hex.bytes().len() != 64u64 {
        panic("hex length mismatch");
    }
    if hex.as_str() != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" {
        panic("hex lowercase mismatch");
    }
}

fn test_immutability_and_determinism() {
    let mut input: Vec<UInt8> = Vec::new();
    input.push(97u8);
    input.push(98u8);
    input.push(99u8);
    let first = hash_hex(input.as_slice());
    let second = hash_hex(input.as_slice());
    let third = hash_hex(input.as_slice());
    if first.as_str() != second.as_str() || first.as_str() != third.as_str() {
        panic("sha256 determinism mismatch");
    }
    if input.len() != 3u64 || input[0u64] != 97u8 || input[1u64] != 98u8 || input[2u64] != 99u8 {
        panic("input mutated");
    }
}
