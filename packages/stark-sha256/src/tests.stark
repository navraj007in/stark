    assert_hash(empty, "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");

    let abc: &[UInt8] = &[97u8, 98u8, 99u8];
    assert_hash(abc, "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");

    let hello: &[UInt8] = &[
