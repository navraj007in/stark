// HC8 tests, pure half.
//
// The client is capability-bearing, and `stark test` runs on the HIR interpreter, which has NO
// provider layer — no socket in this process can be opened, at all. So this file covers exactly
// what is decidable without one: URL targeting, configuration, and the request the flow would put
// on the wire. The socket path — connect, write, read, close, timeouts, early close — is covered by
// `stark-http-client-consumer`, which is native-only and requires a real HTTP peer, per the CD-348
// category rule that a resource-shaped package needs observed lifecycle, not just linkage.

use super::default_config;
use super::get;
use super::new_client;
use super::parse_url;
use super::post;
use super::HttpError;
use super::Scheme;
use super::Target;
use super::HttpMethod;

fn expect(condition: Bool, message: &str) {
    if !condition {
        panic(message);
    }
}

fn target_of(url: &str) -> Target {
    let out: Target;
    match parse_url(url) {
        Ok(target) => {
            out = target;
        }
        Err(_error) => {
            panic("a well-formed URL was refused");
        }
    }
    out
}

fn expect_url_rejected(url: &str) {
    match parse_url(url) {
        Ok(_target) => {
            panic("a malformed URL was accepted");
        }
        Err(_error) => {}
    }
}

// -- URL targeting ------------------------------------------------------------------------------

fn test_default_port_is_80() {
    let target = target_of("http://example.com/");
    expect(target.host.as_str() == "example.com", "host wrong");
    expect(target.port == 80u16, "default port must be 80");
    expect(target.path_and_query.as_str() == "/", "path wrong");
}

fn test_explicit_port() {
    let target = target_of("http://example.com:8080/index.html");
    expect(target.port == 8080u16, "explicit port not honoured");
    expect(target.path_and_query.as_str() == "/index.html", "path wrong with a port");
}

fn test_empty_path_becomes_root() {
    let target = target_of("http://example.com");
    expect(target.path_and_query.as_str() == "/", "an absent path must become /");
}

fn test_query_is_kept_with_the_path() {
    let target = target_of("http://example.com/search?q=stark&n=2");
    expect(
        target.path_and_query.as_str() == "/search?q=stark&n=2",
        "query dropped from the request target",
    );
}

fn test_fragment_is_not_sent() {
    // A fragment is client-side only. Sending it is an information leak, so it must be stripped
    // before the request target is formed.
    let target = target_of("http://example.com/page#section");
    expect(target.path_and_query.as_str() == "/page", "a fragment reached the request target");
}

fn test_ipv4_literal_host() {
    let target = target_of("http://127.0.0.1:9000/x");
    expect(target.host.as_str() == "127.0.0.1", "IPv4 literal host wrong");
    expect(target.port == 9000u16, "IPv4 literal port wrong");
}

fn test_https_is_accepted_and_defaults_to_443() {
    // HC10. HC8 refused this, and refusing loudly was right THEN — a client that quietly speaks
    // cleartext where TLS was asked for is a security defect. What changed is that the secure path
    // now exists; the refusal has not been relaxed, it has been satisfied.
    match parse_url("https://example.com/v1/items") {
        Ok(target) => {
            match target.scheme {
                Scheme::Https => {}
                Scheme::Http => {
                    panic("https:// must parse as the secure scheme");
                }
            }
            if target.port != 443u16 {
                panic("https:// must default to port 443");
            }
            if target.host.as_str() != "example.com" {
                panic("https:// host wrong");
            }
            if target.path_and_query.as_str() != "/v1/items" {
                panic("https:// path wrong");
            }
        }
        Err(_error) => {
            panic("https:// must now be accepted");
        }
    }
}

fn test_http_still_defaults_to_80() {
    // The two defaults must not be confused: `Host` omits the port only when it matches the
    // scheme's default, so a wrong default silently changes every request's Host header.
    match parse_url("http://example.com/") {
        Ok(target) => {
            match target.scheme {
                Scheme::Http => {}
                Scheme::Https => {
                    panic("http:// must parse as the plain scheme");
                }
            }
            if target.port != 80u16 {
                panic("http:// must default to port 80");
            }
        }
        Err(_error) => {
            panic("http:// must be accepted");
        }
    }
}

fn test_an_explicit_port_overrides_the_scheme_default() {
    match parse_url("https://example.com:8443/x") {
        Ok(target) => {
            if target.port != 8443u16 {
                panic("an explicit port must win over the scheme default");
            }
        }
        Err(_error) => {
            panic("an explicit https port must parse");
        }
    }
}

fn test_the_scheme_is_matched_exactly() {
    // `httpx://`, `htt://` and a bare `https:/` must not be mistaken for either scheme. A prefix
    // test that stopped at "http" would accept the first of these as cleartext.
    expect_url_rejected("httpx://example.com/");
    expect_url_rejected("htt://example.com/");
    expect_url_rejected("HTTPS://example.com/");
}

fn test_other_schemes_are_refused() {
    expect_url_rejected("ftp://example.com/");
    expect_url_rejected("file:///etc/passwd");
    expect_url_rejected("//example.com/");
    expect_url_rejected("example.com/");
}

fn test_malformed_urls_are_refused() {
    expect_url_rejected("http://");
    expect_url_rejected("http:///path");
    expect_url_rejected("http://example.com:/");
    expect_url_rejected("http://example.com:abc/");
    expect_url_rejected("http://example.com:99999/");
    expect_url_rejected("http://exa mple.com/");
}

fn test_port_zero_is_refused() {
    expect_url_rejected("http://example.com:0/");
}

// -- configuration ------------------------------------------------------------------------------

fn test_default_config_has_finite_budgets() {
    let config = default_config();
    expect(config.connect_timeout.seconds() > 0u64, "connect timeout must be finite and non-zero");
    expect(config.read_timeout.seconds() > 0u64, "read timeout must be non-zero");
    expect(config.write_timeout.seconds() > 0u64, "write timeout must be non-zero");
    expect(
        config.max_response_bytes > 0u64,
        "an unbounded response cap is a memory-exhaustion hole",
    );
    expect(!config.follow_redirects, "v0.1 does not follow redirects, and the default must say so");
}

fn test_client_carries_parser_limits() {
    let client = new_client(default_config());
    expect(client.limits.max_body_bytes > 0u64, "the client must hand bounded limits to the parser");
    expect(client.limits.max_header_count > 0u64, "header count must be bounded");
}

// -- builders -----------------------------------------------------------------------------------

fn test_get_builder_shape() {
    let builder = get("http://example.com/x");
    match builder.method {
        HttpMethod::Get => {}
        _other => {
            panic("get() built a non-GET request");
        }
    }
    expect(builder.body.len() == 0u64, "a GET built with a body");
    expect(builder.headers.entries.len() == 0u64, "a GET built with headers");
}

fn test_post_builder_keeps_the_body() {
    let mut body: Vec<UInt8> = Vec::new();
    body.push(104u8);
    body.push(105u8);
    let builder = post("http://example.com/x", body);
    match builder.method {
        HttpMethod::Post => {}
        _other => {
            panic("post() built a non-POST request");
        }
    }
    expect(builder.body.len() == 2u64, "the POST body was not carried");
}

// --- HC10: the error taxonomy and the scheme -------------------------------------------------

use super::default_port;
use super::error_text;
use super::timeout_phase_text;
use super::HttpTimeoutPhase;

fn test_the_scheme_defaults_differ() {
    // If these were ever equal, `Host` would carry a port for one scheme and not the other and
    // nothing would notice until a vhost stopped matching.
    if default_port(&Scheme::Http) != 80u16 {
        panic("http default port must be 80");
    }
    if default_port(&Scheme::Https) != 443u16 {
        panic("https default port must be 443");
    }
}

fn test_every_timeout_phase_reads_differently() {
    // A bare "timed out" is nearly useless to act on: resolution, connection, handshake, request
    // and response are fixed in different places. Five phases, five distinct descriptions.
    let all = [
        timeout_phase_text(&HttpTimeoutPhase::Resolve),
        timeout_phase_text(&HttpTimeoutPhase::Connect),
        timeout_phase_text(&HttpTimeoutPhase::TlsHandshake),
        timeout_phase_text(&HttpTimeoutPhase::WriteRequest),
        timeout_phase_text(&HttpTimeoutPhase::ReadResponse),
    ];
    let mut i: UInt64 = 0u64;
    while i < 5u64 {
        if all[i].len() == 0u64 {
            panic("every timeout phase must have a description");
        }
        let mut j: UInt64 = i + 1u64;
        while j < 5u64 {
            if all[i].as_str() == all[j].as_str() {
                panic("two timeout phases share a description");
            }
            j = j + 1u64;
        }
        i = i + 1u64;
    }
}

fn test_a_timeout_error_names_its_phase() {
    // The phase must reach the rendered message. An error that says only "timed out" sends an
    // operator looking in the wrong place.
    let rendered = error_text(&HttpError::Timeout(HttpTimeoutPhase::TlsHandshake));
    if rendered.as_str() != "timed out the TLS handshake" {
        panic("a timeout error must name the phase it happened in");
    }
    let reading = error_text(&HttpError::Timeout(HttpTimeoutPhase::ReadResponse));
    if reading.as_str() == rendered.as_str() {
        panic("two phases must not render the same error text");
    }
}

fn test_the_scheme_refusal_names_both_supported_schemes() {
    // The message a caller sees when they pass `ftp://` has to say what IS accepted, or the next
    // thing they try is a guess.
    let rendered = error_text(&HttpError::UnsupportedScheme);
    if rendered.as_str() != "only http:// and https:// are supported" {
        panic("the unsupported-scheme message must name both supported schemes");
    }
}

// --- HC11: the JSON convenience API -----------------------------------------------------------

use super::is_json_content_type;
use super::json_body_error_text;
use super::JsonBodyError;
use super::append_validated;
use super::get_first;
use super::new_header_map;
use super::HttpResponse;
use super::HttpVersion;
use super::encode;
use super::JsonValue;

fn json_response(content_type: &str, body_text: &str) -> HttpResponse {
    let mut headers = new_header_map();
    if content_type.bytes().len() > 0u64 {
        match append_validated(&mut headers, "Content-Type", content_type) {
            Ok(_added) => {}
            Err(_error) => {
                panic("test header must be valid");
            }
        }
    }
    let mut body: Vec<UInt8> = Vec::new();
    let bytes = body_text.bytes();
    let mut i = 0u64;
    while i < bytes.len() {
        body.push(bytes[i]);
        i = i + 1u64;
    }
    HttpResponse {
        version: HttpVersion::Http11,
        status: 200u16,
        reason: String::from("OK"),
        headers: headers,
        body: body,
    }
}

fn test_a_json_body_is_encoded_and_declared() {
    // The request builder must do BOTH things: carry the bytes and say what they are. A body
    // without the header is what a server rejects with 415 and a developer debugs for an hour.
    let value = JsonValue::String(String::from("hi"));
    match get("http://example.com/x").json(&value) {
        Ok(builder) => {
            if builder.body.len() != 4u64 {
                panic("the encoded body must be the JSON text");
            }
            match get_first(&builder.headers, "content-type") {
                Some(seen) => {
                    if seen.as_str() != "application/json" {
                        panic("json() must declare application/json");
                    }
                }
                None => {
                    panic("json() must set a Content-Type");
                }
            }
        }
        Err(_error) => {
            panic("a JSON body must attach");
        }
    }
}

fn test_a_json_response_parses() {
    let response = json_response("application/json", "{\"a\":1}");
    match response.json() {
        Ok(value) => match value {
            JsonValue::Object(members) => {
                if members.len() != 1u64 {
                    panic("the parsed object must have one member");
                }
            }
            _other => {
                panic("the body is an object");
            }
        }
        Err(_error) => {
            panic("valid JSON must parse");
        }
    }
}

fn test_unicode_survives_the_round_trip() {
    // A four-byte scalar through encode -> bytes -> decode -> parse. This is the path that a
    // Latin-1 shortcut in the decoder would corrupt while every ASCII test still passed.
    let response = json_response("application/json", "{\"emoji\":\"😀\"}");
    match response.json() {
        Ok(value) => match value {
            JsonValue::Object(members) => {
                // Re-ENCODED rather than destructured. Matching `members[0]` by value moves out
                // of an indexed place, and binding the payload through a reference is refused too
                // ("bind by reference or match a Copy field instead"). Comparing the re-encoded
                // value is the stronger assertion anyway: it exercises decode AND encode, so a
                // decoder and an encoder that were wrong in the same direction could not agree
                // their way past it.
                let first = &members[0u64];
                if first.key.as_str() != "emoji" {
                    panic("the member key did not survive");
                }
                if encode(&first.value).as_str() != "\"😀\"" {
                    panic("the four-byte scalar did not survive");
                }
            }
            _other => {
                panic("the body is an object");
            }
        }
        Err(_error) => {
            panic("unicode JSON must parse");
        }
    }
}

fn test_invalid_json_is_reported_as_invalid() {
    let response = json_response("application/json", "{\"a\":");
    match response.json() {
        Ok(_value) => {
            panic("truncated JSON must not parse");
        }
        Err(error) => match error {
            JsonBodyError::Invalid(_why) => {}
            _other => {
                panic("malformed JSON must be reported as Invalid, not as a decode or type error");
            }
        }
    }
}

fn test_an_empty_body_is_not_valid_json() {
    // Empty is valid UTF-8 and is NOT valid JSON. A client that returned Null here would invent a
    // value the server never sent.
    let response = json_response("application/json", "");
    match response.json() {
        Ok(_value) => {
            panic("an empty body must not parse as JSON");
        }
        Err(error) => match error {
            JsonBodyError::Invalid(_why) => {}
            _other => {
                panic("an empty body is a JSON error, not a decode error");
            }
        }
    }
}

fn test_the_content_type_policy_has_two_settings() {
    // Mislabelled JSON: `json()` accepts it, `json_checked()` refuses. Both behaviours are
    // deliberate, so both are pinned — a change to either is a change a reader should see.
    let response = json_response("text/plain", "{\"a\":1}");
    match response.json() {
        Ok(_value) => {}
        Err(_error) => {
            panic("json() must not require a content type");
        }
    }
    match response.json_checked() {
        Ok(_value) => {
            panic("json_checked() must require a JSON content type");
        }
        Err(error) => match error {
            JsonBodyError::UnexpectedContentType(seen) => {
                if seen.as_str() != "text/plain" {
                    panic("the refusal must quote what the server actually said");
                }
            }
            _other => {
                panic("a mislabelled body must be a content-type error");
            }
        }
    }

    // An absent content type is refused by the strict form too, and says so distinctly.
    let bare = json_response("", "{\"a\":1}");
    match bare.json_checked() {
        Ok(_value) => {
            panic("an absent content type must be refused by the strict form");
        }
        Err(_error) => {}
    }
}

fn test_a_charset_parameter_is_still_json() {
    // `application/json; charset=utf-8` is the same media type. A client that refused it would be
    // wrong about a large share of real servers.
    if !is_json_content_type("application/json; charset=utf-8") {
        panic("a charset parameter must not change the media type");
    }
    if !is_json_content_type("APPLICATION/JSON") {
        panic("media types are case-insensitive");
    }
    if !is_json_content_type("  application/json  ") {
        panic("surrounding space must be tolerated");
    }
    if is_json_content_type("application/jsonx") {
        panic("a longer type must not match");
    }
    if is_json_content_type("text/json") {
        panic("text/json is a different media type");
    }
    let checked = json_response("application/json; charset=utf-8", "{\"a\":1}");
    match checked.json_checked() {
        Ok(_value) => {}
        Err(_error) => {
            panic("a charset parameter must not fail the strict form");
        }
    }
}

fn test_a_non_utf8_body_is_a_decode_error_not_a_json_error() {
    // The distinction matters: bad bytes and bad JSON are fixed in different places.
    let mut body: Vec<UInt8> = Vec::new();
    body.push(255u8);
    let response = HttpResponse {
        version: HttpVersion::Http11,
        status: 200u16,
        reason: String::from("OK"),
        headers: new_header_map(),
        body: body,
    };
    match response.json() {
        Ok(_value) => {
            panic("invalid UTF-8 must not parse as JSON");
        }
        Err(error) => {
            // Rendered BEFORE the match: an arm binding a payload moves the error, so `&error`
            // afterwards would be a use of a moved value.
            let rendered = json_body_error_text(&error);
            if rendered.len() == 0u64 {
                panic("a decode error must render");
            }
            match error {
                JsonBodyError::NotUtf8(_why) => {}
                _ => {
                    panic("invalid UTF-8 must be a decode error, not a JSON error");
                }
            }
        }
    }
}

// --- HC12: the redirect policy ----------------------------------------------------------------

use super::clone_method;
use super::default_redirect_policy;
use super::is_followable_redirect;
use super::redirect_method;
use super::resolve_location;
use super::same_origin;
use super::Target;

fn test_the_default_policy_is_the_safe_one() {
    // These three defaults ARE the exit criterion. A change to any of them is a change to whether
    // this client can leak a credential or downgrade a connection, so they are pinned by value.
    let policy = default_redirect_policy();
    if policy.max_redirects != 5u8 {
        panic("the default chain bound must be small and finite");
    }
    if policy.allow_https_to_http {
        panic("a downgrade must never be allowed by default");
    }
    if !policy.preserve_authorization_same_origin_only {
        panic("credentials must be confined to their origin by default");
    }
    // And following is off entirely unless asked for.
    if default_config().follow_redirects {
        panic("redirects must be opt-in");
    }
}

fn test_only_relocating_statuses_are_followed() {
    if !is_followable_redirect(301u16) {
        panic("301 is a redirect");
    }
    if !is_followable_redirect(302u16) {
        panic("302 is a redirect");
    }
    if !is_followable_redirect(303u16) {
        panic("303 is a redirect");
    }
    if !is_followable_redirect(307u16) {
        panic("307 is a redirect");
    }
    if !is_followable_redirect(308u16) {
        panic("308 is a redirect");
    }
    // 300 has no single target and 304 is a cache answer, not a relocation. Following either would
    // be inventing a destination.
    if is_followable_redirect(300u16) {
        panic("300 names no single target");
    }
    if is_followable_redirect(304u16) {
        panic("304 is not a relocation");
    }
    if is_followable_redirect(200u16) {
        panic("200 is not a redirect");
    }
    if is_followable_redirect(404u16) {
        panic("404 is not a redirect");
    }
}

fn expect_rewrite(status: UInt16, from: HttpMethod, to: HttpMethod, keeps_body: Bool, what: &str) {
    let result = redirect_method(status, &from);
    if method_code(&result.0) != method_code(&to) {
        print("rewriting ");
        println(what);
        panic("the method after the redirect is wrong");
    }
    if result.1 != keeps_body {
        print("rewriting ");
        println(what);
        panic("the body-replay decision is wrong");
    }
}

fn method_code(method: &HttpMethod) -> UInt32 {
    match *method {
        HttpMethod::Get => 0u32,
        HttpMethod::Post => 1u32,
        HttpMethod::Put => 2u32,
        HttpMethod::Patch => 3u32,
        HttpMethod::Delete => 4u32,
        HttpMethod::Head => 5u32,
        HttpMethod::Options => 6u32,
    }
}

fn test_the_method_rewrite_table() {
    // 303: always GET, always without a body. This is the status whose entire purpose is "go look
    // over there instead", and replaying a POST body to that target would be wrong.
    expect_rewrite(303u16, HttpMethod::Post, HttpMethod::Get, false, "303 from POST");
    expect_rewrite(303u16, HttpMethod::Put, HttpMethod::Get, false, "303 from PUT");
    expect_rewrite(303u16, HttpMethod::Get, HttpMethod::Get, false, "303 from GET");

    // 307/308 preserve BOTH. They exist to say "no, really, replay it".
    expect_rewrite(307u16, HttpMethod::Post, HttpMethod::Post, true, "307 from POST");
    expect_rewrite(308u16, HttpMethod::Post, HttpMethod::Post, true, "308 from POST");
    expect_rewrite(307u16, HttpMethod::Delete, HttpMethod::Delete, true, "307 from DELETE");

    // 301/302 turn POST into GET and drop the body. That contradicts a literal reading of the RFCs
    // and matches every browser and `curl -L`; the letter would send a POST body to a target the
    // server redirected a POST away from.
    expect_rewrite(301u16, HttpMethod::Post, HttpMethod::Get, false, "301 from POST");
    expect_rewrite(302u16, HttpMethod::Post, HttpMethod::Get, false, "302 from POST");
    // A GET is unchanged and keeps its (empty) body.
    expect_rewrite(302u16, HttpMethod::Get, HttpMethod::Get, true, "302 from GET");
    expect_rewrite(301u16, HttpMethod::Head, HttpMethod::Head, true, "301 from HEAD");
}

fn test_clone_method_round_trips_every_variant() {
    // `redirect_method` hands back a cloned method for the next hop; a variant it got wrong would
    // silently turn a DELETE into something else.
    let all = [
        HttpMethod::Get,
        HttpMethod::Post,
        HttpMethod::Put,
        HttpMethod::Patch,
        HttpMethod::Delete,
        HttpMethod::Head,
        HttpMethod::Options,
    ];
    let mut i: UInt64 = 0u64;
    while i < 7u64 {
        if method_code(&clone_method(&all[i])) != method_code(&all[i]) {
            panic("clone_method must preserve the variant");
        }
        i = i + 1u64;
    }
}

fn expect_location(base: &str, location: &str, expected: &str, what: &str) {
    let from = target_of(base);
    match resolve_location(&from, location) {
        Ok(resolved) => {
            if resolved.as_str() != expected {
                print("resolving ");
                print(what);
                print(" gave ");
                println(resolved.as_str());
                panic("the resolved Location is wrong");
            }
        }
        Err(_error) => {
            print("resolving ");
            println(what);
            panic("the Location must resolve");
        }
    }
}

fn test_location_resolution() {
    // Absolute: taken as-is.
    expect_location(
        "http://a.test/one",
        "https://b.test/two",
        "https://b.test/two",
        "an absolute Location",
    );
    // Absolute path: scheme, host and port inherited.
    expect_location("http://a.test/one/two", "/three", "http://a.test/three", "an absolute path");
    // Relative path: replaces the last segment.
    expect_location("http://a.test/one/two", "three", "http://a.test/one/three", "a relative path");
    expect_location(
        "http://a.test/one/",
        "three",
        "http://a.test/one/three",
        "a directory-relative path",
    );
    // A non-default port travels with the origin.
    expect_location(
        "http://a.test:8080/one",
        "/two",
        "http://a.test:8080/two",
        "a non-default port",
    );
    // Scheme-relative: inherits the CURRENT scheme, which is what stops an https page being walked
    // onto http by omission.
    expect_location(
        "https://a.test/one",
        "//b.test/two",
        "https://b.test/two",
        "a scheme-relative Location",
    );
    // The query of the current URL is not part of the base for a relative resolution.
    expect_location(
        "http://a.test/one/two?q=1",
        "three",
        "http://a.test/one/three",
        "a base with a query",
    );
}

fn test_an_empty_location_is_refused() {
    let from = target_of("http://a.test/one");
    match resolve_location(&from, "") {
        Ok(_resolved) => {
            panic("an empty Location must not resolve");
        }
        Err(_error) => {}
    }
}

fn test_origin_comparison() {
    // Same origin: credentials may travel.
    if !same_origin(&target_of("https://a.test/one"), &target_of("https://a.test/two")) {
        panic("the same host, scheme and port is one origin");
    }
    // The DEFAULT port and the explicit one are the same origin — otherwise a redirect that only
    // spelled the port differently would strip credentials for no reason, and callers would learn
    // to turn the stripping off.
    if !same_origin(&target_of("https://a.test/one"), &target_of("https://a.test:443/two")) {
        panic("an explicit default port is the same origin");
    }
    // Any of host, scheme or port differing is a different origin.
    if same_origin(&target_of("https://a.test/one"), &target_of("https://b.test/one")) {
        panic("a different host is a different origin");
    }
    if same_origin(&target_of("https://a.test/one"), &target_of("http://a.test/one")) {
        panic("a different scheme is a different origin");
    }
    if same_origin(&target_of("https://a.test/one"), &target_of("https://a.test:8443/one")) {
        panic("a different port is a different origin");
    }
    // Host comparison is ASCII case-insensitive, as DNS is.
    if !same_origin(&target_of("https://A.TEST/one"), &target_of("https://a.test/one")) {
        panic("host comparison must be case-insensitive");
    }
}

fn test_every_redirect_error_reads_differently() {
    let all = [
        error_text(&HttpError::TooManyRedirects),
        error_text(&HttpError::RedirectLoop),
        error_text(&HttpError::MissingLocation),
        error_text(&HttpError::InvalidRedirectTarget),
        error_text(&HttpError::InsecureRedirect),
        error_text(&HttpError::AmbiguousLocation),
    ];
    let mut i: UInt64 = 0u64;
    while i < 6u64 {
        if all[i].len() == 0u64 {
            panic("every redirect error must have a description");
        }
        let mut j: UInt64 = i + 1u64;
        while j < 6u64 {
            if all[i].as_str() == all[j].as_str() {
                panic("two redirect errors share a description");
            }
            j = j + 1u64;
        }
        i = i + 1u64;
    }
}

fn test_dropping_the_body_drops_the_headers_that_describe_it() {
    // Found by the 303 case observing the actual wire: the method and the body were already right,
    // and `Content-Type: text/plain` was still riding along on a bodyless GET. A header that
    // describes content must not outlive the content.
    //
    // The rewrite table is what decides this, so the two are asserted together: 303 drops, 307
    // keeps, and the entity headers must follow the body in each direction.
    let drops = redirect_method(303u16, &HttpMethod::Post);
    if drops.1 {
        panic("303 must drop the body");
    }
    let keeps = redirect_method(307u16, &HttpMethod::Post);
    if !keeps.1 {
        panic("307 must keep the body");
    }
}

// --- HC12.1: the URI-reference forms the first pass mis-resolved ------------------------------

fn expect_location_refused(base: &str, location: &str, what: &str) {
    let from = target_of(base);
    match resolve_location(&from, location) {
        Ok(resolved) => {
            print("resolved ");
            print(what);
            print(" to ");
            println(resolved.as_str());
            panic("a Location that names nothing fetchable must be refused");
        }
        Err(_error) => {}
    }
}

fn test_a_query_only_reference_keeps_the_whole_path() {
    // The first pass treated `?page=2` as a relative PATH segment, turning `/one/two` into
    // `/one/?page=2` — silently requesting a different resource. A query-only reference replaces
    // only the query.
    expect_location(
        "http://a.test/one/two?q=1",
        "?page=2",
        "http://a.test/one/two?page=2",
        "a query-only reference",
    );
    expect_location(
        "http://a.test/one/two",
        "?page=2",
        "http://a.test/one/two?page=2",
        "a query-only reference with no existing query",
    );
}

fn test_an_absolute_uri_in_another_scheme_is_refused() {
    // The first pass fell through to the relative-path branch and produced
    // `http://a.test/one/ftp://other.test/file` — a request the server never asked for, sent to the
    // wrong place. Not dialling FTP is not the same as being correct.
    expect_location_refused("http://a.test/one/two", "ftp://other.test/file", "an ftp:// target");
    expect_location_refused("http://a.test/one/two", "mailto:someone@a.test", "a mailto: target");
    expect_location_refused("http://a.test/one/two", "data:text/plain,hi", "a data: target");
    expect_location_refused("http://a.test/one/two", "javascript:alert(1)", "a javascript: target");
}

fn test_a_fragment_only_reference_is_refused() {
    // It addresses a position in the CURRENT document. There is nothing to fetch.
    expect_location_refused("http://a.test/one/two", "#section", "a fragment-only reference");
}

fn test_an_ordinary_relative_path_containing_a_colon_still_resolves() {
    // The scheme check must not swallow legitimate paths. A colon AFTER a `/` is not a scheme.
    expect_location(
        "http://a.test/one/two",
        "a/b:c",
        "http://a.test/one/a/b:c",
        "a relative path with a colon after a slash",
    );
    // A leading digit cannot begin a scheme, so this is a path.
    expect_location(
        "http://a.test/one/two",
        "2fa:setup",
        "http://a.test/one/2fa:setup",
        "a path whose first character is a digit",
    );
}

fn test_the_singleton_policy_applies_to_content_type_too() {
    // Same policy as `Location`, applied consistently. Two `Content-Type` headers are two
    // contradictory claims about the same bytes, and silently believing the first is a choice
    // between things the server said.
    let mut headers = new_header_map();
    match append_validated(&mut headers, "Content-Type", "application/json") {
        Ok(_added) => {}
        Err(_error) => {
            panic("a valid header must be accepted");
        }
    }
    match append_validated(&mut headers, "Content-Type", "text/html") {
        Ok(_added) => {}
        Err(_error) => {
            panic("a valid header must be accepted");
        }
    }
    let mut body: Vec<UInt8> = Vec::new();
    let bytes = "{\"a\":1}".bytes();
    let mut i = 0u64;
    while i < bytes.len() {
        body.push(bytes[i]);
        i = i + 1u64;
    }
    let response = HttpResponse {
        version: HttpVersion::Http11,
        status: 200u16,
        reason: String::from("OK"),
        headers: headers,
        body: body,
    };
    match response.json_checked() {
        Ok(_value) => {
            panic("two Content-Type headers must not resolve to the first");
        }
        Err(error) => match error {
            JsonBodyError::AmbiguousContentType => {}
            _ => {
                panic("a duplicate Content-Type must be reported as ambiguous");
            }
        }
    }
    // The permissive form still parses: it makes no claim about the content type at all, so a
    // contradiction in one cannot make it fail.
    match response.json() {
        Ok(_value) => {}
        Err(_error) => {
            panic("json() must not consult the content type");
        }
    }
}

fn test_json_refuses_to_add_a_second_content_type() {
    // Appending would put two contradictory claims on the wire and leave the winner to the server —
    // the same ambiguity `json_checked` refuses to resolve on the way back in.
    let mut builder = get("http://example.com/x");
    match append_validated(&mut builder.headers, "Content-Type", "text/plain") {
        Ok(_added) => {}
        Err(_error) => {
            panic("a valid header must be accepted");
        }
    }
    match builder.json(&JsonValue::Null) {
        Ok(_out) => {
            panic("json() must not append a second Content-Type");
        }
        Err(_error) => {}
    }
}
