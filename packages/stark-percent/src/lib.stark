    } else if byte == 59u8 {
        ';'
    } else if byte == 60u8 {
        '<'
    } else if byte == 61u8 {
        '='
    } else if byte == 62u8 {
        '>'
    } else if byte == 63u8 {
        '?'
    } else if byte == 64u8 {
        '@'
    } else if byte == 65u8 {
        'A'
    } else if byte == 66u8 {
        'B'
    } else if byte == 67u8 {
        'C'
    } else if byte == 68u8 {
        'D'
    } else if byte == 69u8 {
        'E'
    } else if byte == 70u8 {
        'F'
    } else if byte == 71u8 {
        'G'
    } else if byte == 72u8 {
        'H'
    } else if byte == 73u8 {
        'I'
    } else if byte == 74u8 {
        'J'
    } else if byte == 75u8 {
        'K'
    } else if byte == 76u8 {
        'L'
    } else if byte == 77u8 {
        'M'
    } else if byte == 78u8 {
        'N'
    } else if byte == 79u8 {
        'O'
    } else if byte == 80u8 {
        'P'
    } else if byte == 81u8 {
        'Q'
    } else if byte == 82u8 {
        'R'
    } else if byte == 83u8 {
        'S'
    } else if byte == 84u8 {
        'T'
    } else if byte == 85u8 {
        'U'
    } else if byte == 86u8 {
        'V'
    } else if byte == 87u8 {
        'W'
    } else if byte == 88u8 {
        'X'
    } else if byte == 89u8 {
        'Y'
    } else if byte == 90u8 {
        'Z'
    } else if byte == 91u8 {
        '['
    } else if byte == 92u8 {
        '\\'
    } else if byte == 93u8 {
        ']'
    } else if byte == 94u8 {
        '^'
    } else if byte == 95u8 {
        '_'
    } else if byte == 96u8 {
        '`'
    } else if byte == 97u8 {
        'a'
    } else if byte == 98u8 {
        'b'
    } else if byte == 99u8 {
        'c'
    } else if byte == 100u8 {
        'd'
    } else if byte == 101u8 {
        'e'
    } else if byte == 102u8 {
        'f'
    } else if byte == 103u8 {
        'g'
    } else if byte == 104u8 {
        'h'
    } else if byte == 105u8 {
        'i'
    } else if byte == 106u8 {
        'j'
    } else if byte == 107u8 {
        'k'
    } else if byte == 108u8 {
        'l'
    } else if byte == 109u8 {
        'm'
    } else if byte == 110u8 {
        'n'
    } else if byte == 111u8 {
        'o'
    } else if byte == 112u8 {
        'p'
    } else if byte == 113u8 {
        'q'
    } else if byte == 114u8 {
        'r'
    } else if byte == 115u8 {
        's'
    } else if byte == 116u8 {
        't'
    } else if byte == 117u8 {
