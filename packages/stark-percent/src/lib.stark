use stark_ascii::char_from_ascii;
use stark_ascii::is_ascii_alpha;
use stark_ascii::is_ascii_digit;
use stark_ascii::is_ascii_hex_digit;

pub enum PercentEncodeSet {
    PathSegment,
    Path,
    QueryComponent,
}

pub enum PercentError {
    IncompleteEscape(UInt64),
    InvalidHexDigit(UInt64, UInt8),
    OutputTooLarge,
}

pub fn encode(input: &[UInt8], set: PercentEncodeSet) -> String {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;
    while i < input.len() {
        let byte = input[i];
        if should_encode(byte, &set) {
            out.push('%');
            out.push(upper_hex_char(byte >> 4u8 & 0x0Fu8));
            out.push(upper_hex_char(byte & 0x0Fu8));
        } else {
            out.push(direct_ascii_char(byte));
        }
        i = i + 1u64;
    }
    out
}

pub fn decode(input: &str) -> Result<Vec<UInt8>, PercentError> {
    let bytes = input.bytes();
    let len = bytes.len();
    let mut out = Vec::new();
    let mut i: UInt64 = 0u64;
    let max_bytes: UInt64 = 10485760u64;

    while i < len {
        let byte = bytes[i];
        if byte == 37u8 {
            if i + 2u64 >= len {
                return Err(PercentError::IncompleteEscape(i));
            }
            let h1 = bytes[i + 1u64];
            if !is_ascii_hex_digit(h1) {
                return Err(PercentError::InvalidHexDigit(i + 1u64, h1));
            }
            let h2 = bytes[i + 2u64];
            if !is_ascii_hex_digit(h2) {
                return Err(PercentError::InvalidHexDigit(i + 2u64, h2));
            }
            let v1 = hex_val(h1);
            let v2 = hex_val(h2);
            let decoded_byte = v1 << 4u8 | v2;
            out.push(decoded_byte);
            i = i + 3u64;
        } else {
            out.push(byte);
            i = i + 1u64;
        }
        if out.len() > max_bytes {
            return Err(PercentError::OutputTooLarge);
        }
    }

    Ok(out)
}

fn should_encode(byte: UInt8, set: &PercentEncodeSet) -> Bool {
    let unreserved = is_ascii_alpha(byte) || is_ascii_digit(byte) || byte == 45u8 || byte == 46u8 || byte == 95u8 || byte == 126u8;
    if unreserved {
        return false;
    }
    match *set {
        PercentEncodeSet::PathSegment => true,
        PercentEncodeSet::Path => {
            if byte == 47u8 {
                false
            } else {
                true
            }
        }
        PercentEncodeSet::QueryComponent => {
            if byte == 33u8 || byte == 36u8 || byte == 39u8 || byte == 40u8 || byte == 41u8 || byte == 42u8 || byte == 43u8 || byte == 44u8 || byte == 59u8 || byte == 58u8 || byte == 64u8 {
                false
            } else {
                true
            }
        }
    }
}

fn hex_val(byte: UInt8) -> UInt8 {
    if byte >= 48u8 && byte <= 57u8 {
        byte - 48u8
    } else if byte >= 65u8 && byte <= 70u8 {
        byte - 65u8 + 10u8
    } else if byte >= 97u8 && byte <= 102u8 {
        byte - 97u8 + 10u8
    } else {
        0u8
    }
}

fn upper_hex_char(nibble: UInt8) -> Char {
    if nibble < 10u8 {
        digit_char(nibble)
    } else if nibble == 10u8 {
        'A'
    } else if nibble == 11u8 {
        'B'
    } else if nibble == 12u8 {
        'C'
    } else if nibble == 13u8 {
        'D'
    } else if nibble == 14u8 {
        'E'
    } else {
        'F'
    }
}

fn digit_char(nibble: UInt8) -> Char {
    if nibble == 0u8 {
        '0'
    } else if nibble == 1u8 {
        '1'
    } else if nibble == 2u8 {
        '2'
    } else if nibble == 3u8 {
        '3'
    } else if nibble == 4u8 {
        '4'
    } else if nibble == 5u8 {
        '5'
    } else if nibble == 6u8 {
        '6'
    } else if nibble == 7u8 {
        '7'
    } else if nibble == 8u8 {
        '8'
    } else {
        '9'
    }
}

fn direct_ascii_char(byte: UInt8) -> Char {
    match char_from_ascii(byte) {
        Some(ch) => ch,
        None => '?',
    }
}

// Package unit tests live in `src/tests.stark`, discovered by `stark test` via the `test_`
// name prefix. They were duplicated INLINE here as well, and only this copy ever ran:
// without `mod tests;` the file was never compiled, so the two drifted with no way to
// notice. One copy, in the conventional place, matching `stark-ascii`.
mod tests;
