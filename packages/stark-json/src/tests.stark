use super::parse;
use super::parse_with_limits;
use super::encode;
use super::member_key;
use super::number_raw;
use super::JsonLimits;
use super::JsonValue;

fn assert_ok(input: &str) {
    match parse(input) {
        Ok(_) => {}
        Err(_) => {
            panic("expected parse success");
        }
    }
}

fn assert_error_position(input: &str, offset: UInt64, line: UInt64, column: UInt64) {
    match parse(input) {
        Ok(_) => {
            panic("expected parse error");
        }
        Err(err) => {
            if err.offset != offset || err.line != line || err.column != column {
                panic("error position mismatch");
            }
        }
    }
}

fn assert_number(input: &str, expected: &str) {
    match parse(input) {
        Ok(value) => {
            match value {
                JsonValue::Number(number) => {
                    if number_raw(&number) != expected {
                        panic("number lexeme mismatch");
                    }
                }
                _ => {
                    panic("expected number");
                }
            }
        }
        Err(_) => {
            panic("expected number parse success");
        }
    }
}

fn assert_string(input: &str, expected: &str) {
    match parse(input) {
        Ok(value) => {
            match value {
                JsonValue::String(text) => {
                    if text.as_str() != expected {
                        panic("string content mismatch");
                    }
                }
                _ => {
                    panic("expected string");
                }
            }
        }
        Err(_) => {
            panic("expected string parse success");
        }
    }
}

fn test_primitives_numbers_arrays_objects() {
    assert_ok("null");
    assert_ok("true");
    assert_ok("false");
    assert_ok("0");
    assert_ok("-12.34e+56");
    assert_ok("[]");
    assert_ok("{}");
    assert_ok("[1,true,null]");
    assert_ok("{\"a\":1}");
}

fn test_valid_number_forms() {
    assert_number("0", "0");
    assert_number("-0", "-0");
    assert_number("1", "1");
    assert_number("-1", "-1");
    assert_number("1234567890", "1234567890");
    assert_number("0.0", "0.0");
    assert_number("-0.0", "-0.0");
    assert_number("1.25", "1.25");
    assert_number("1e10", "1e10");
    assert_number("1E10", "1E10");
    assert_number("1e+10", "1e+10");
    assert_number("1e-10", "1e-10");
}

fn test_valid_string_forms() {
    assert_string("\"\"", "");
    assert_string("\"hello\"", "hello");
    assert_string("\"\\\"\"", "\"");
    assert_string("\"\\\\\"", "\\");
    assert_string("\"\\/\"", "/");
    assert_string("\"\\n\"", "\n");
    assert_string("\"\\r\"", "\r");
    assert_string("\"\\t\"", "\t");
    assert_string("\"\\u0061\"", "a");
    assert_string("\"caf\u{00e9}\"", "caf\u{00e9}");
}

fn test_invalid_positions() {
    assert_error_position("01", 1u64, 1u64, 2u64);
    assert_error_position("1.", 2u64, 1u64, 3u64);
    assert_error_position("true false", 5u64, 1u64, 6u64);
    assert_error_position("[1,]", 3u64, 1u64, 4u64);
    assert_error_position("{\"a\" 1}", 5u64, 1u64, 6u64);
    assert_error_position("+1", 0u64, 1u64, 1u64);
    assert_error_position("--1", 1u64, 1u64, 2u64);
    assert_error_position("1a", 1u64, 1u64, 2u64);
    assert_error_position("nullx", 4u64, 1u64, 5u64);
    assert_error_position("{a:1}", 1u64, 1u64, 2u64);
}

fn test_unicode_and_duplicates_are_checked() {
    assert_ok("\"\\u0061\"");
    assert_string("\"\\u00E9\"", "\u{00e9}");
    assert_string("\"\\u20AC\"", "\u{20ac}");
    assert_string("\"\\uD83D\\uDE00\"", "\u{1f600}");
    assert_error_position("\"\\uD800\"", 1u64, 1u64, 2u64);
    assert_error_position("\"\\uDC00\"", 1u64, 1u64, 2u64);
    assert_error_position("{\"a\":1,\"a\":2}", 7u64, 1u64, 8u64);
    assert_error_position("{\"a\":1,\"\\u0061\":2}", 7u64, 1u64, 8u64);
}

fn assert_encode(input: &str, expected: &str) {
    match parse(input) {
        Ok(value) => {
            let first = encode(&value);
            let second = encode(&value);
            if first.as_str() != expected {
                panic("encoded content mismatch");
            }
            if second.as_str() != expected {
                panic("repeated encoding mismatch");
            }
        }
        Err(_) => {
            panic("expected parse success before encode");
        }
    }
}

fn test_encoder_outputs_canonical_json() {
    assert_encode("null", "null");
    assert_encode("true", "true");
    assert_encode("false", "false");
    assert_encode("-0.125e+2", "-0.125e+2");
    assert_encode("\"a\\n\\t\\\"\\\\\"", "\"a\\n\\t\\\"\\\\\"");
    assert_encode("\"\\u00E9\"", "\"\u{00e9}\"");
    assert_encode("[1, true, null]", "[1,true,null]");
    assert_encode("{\"b\":2,\"a\":[true,\"x\"]}", "{\"b\":2,\"a\":[true,\"x\"]}");
}

fn test_object_key_content_is_preserved_for_duplicate_detection() {
    assert_ok("{\"a\":1,\"b\":2}");
    match parse("{\"abc\":1}") {
        Ok(value) => {
            match value {
                JsonValue::Object(members) => {
                    if members.len() != 1u64 {
                        panic("member count mismatch");
                    }
                    if member_key(&members[0u64]) != "abc" {
                        panic("member key mismatch");
                    }
                }
                _ => {
                    panic("expected object");
                }
            }
        }
        Err(_) => {
            panic("expected object parse success");
        }
    }
}

fn test_input_limit() {
    let limits = JsonLimits {
        max_input_bytes: 2u64,
        max_depth: 1u32,
        max_string_bytes: 1u64,
        max_array_items: 1u64,
        max_object_members: 1u64,
        max_number_bytes: 1u64,
    };

    match parse_with_limits("123", limits) {
        Err(_) => {}
        Ok(_) => {
            panic("expected input limit error");
        }
    }
}

fn tiny_limits() -> JsonLimits {
    JsonLimits {
        max_input_bytes: 100u64,
        max_depth: 1u32,
        max_string_bytes: 1u64,
        max_array_items: 1u64,
        max_object_members: 1u64,
        max_number_bytes: 1u64,
    }
}

fn test_container_and_token_limits() {
    match parse_with_limits("[[0]]", tiny_limits()) {
        Err(_) => {}
        Ok(_) => {
            panic("expected depth limit error");
        }
    }

    match parse_with_limits("[1,2]", tiny_limits()) {
        Err(_) => {}
        Ok(_) => {
            panic("expected array item limit error");
        }
    }

    match parse_with_limits("{\"a\":1,\"b\":2}", tiny_limits()) {
        Err(_) => {}
        Ok(_) => {
            panic("expected object member limit error");
        }
    }

    match parse_with_limits("12", tiny_limits()) {
        Err(_) => {}
        Ok(_) => {
            panic("expected number length limit error");
        }
    }
}

fn test_no_hang_inputs() {
    assert_error_position("[", 1u64, 1u64, 2u64);
    assert_error_position("{", 1u64, 1u64, 2u64);
    assert_error_position("\"", 1u64, 1u64, 2u64);
    assert_error_position("\\", 0u64, 1u64, 1u64);
    assert_error_position("-", 1u64, 1u64, 2u64);
    assert_error_position("1e", 2u64, 1u64, 3u64);
    assert_error_position("{\"a\"", 4u64, 1u64, 5u64);
}
