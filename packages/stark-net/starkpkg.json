{
  "name": "stark-net",
  "version": "0.1.0",
  "entry": "src/lib.stark",
  "distribution": { "toolchain": true },
  "capability_vocabulary": 1,
  "capabilities": ["clock", "network-client"],
  "dependencies": {
    "stark_time": {
      "package": "stark-time",
      "path": "../stark-time",
      "version": "0.1.0"
    }
  },
  "provider_api": {
    "errors": {
      "network-client": "RawNetworkError"
    },
    "resources": {
      "TcpStream": {
        "capability": "network-client",
        "resource": "tcp_stream"
      }
    },
    "functions": {
      "tcp_stream_connect_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_connect"
      },
      "tcp_stream_connect_timeout_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_connect_timeout"
      },
      "tcp_stream_read_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_read"
      },
      "tcp_stream_write_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_write"
      },
      "tcp_stream_close_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_close"
      },
      "dns_resolve_len_raw": {
        "capability": "network-client",
        "symbol": "stark_dns_resolve_len"
      },
      "dns_resolve_fill_raw": {
        "capability": "network-client",
        "symbol": "stark_dns_resolve_fill"
      },
      "tcp_stream_set_read_timeout_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_set_read_timeout"
      },
      "tcp_stream_set_write_timeout_raw": {
        "capability": "network-client",
        "symbol": "stark_tcp_stream_set_write_timeout"
      }
    }
  }
}
