use stark_time::Duration;

pub enum IpAddress {
    V4(Ipv4Address),
    V6(Ipv6Address),
}

pub struct Ipv4Address { pub a: UInt8, pub b: UInt8, pub c: UInt8, pub d: UInt8 }

pub struct Ipv6Address { pub segments: [UInt16; 8] }

pub struct SocketAddress { pub address: IpAddress, pub port: UInt16 }

pub struct ResolvedAddress { pub address: IpAddress, pub port: UInt16 }

pub struct ResolveLimits { pub max_host_bytes: UInt64, pub max_results: UInt64 }

pub enum NetworkError {
    InvalidAddress,
    AddressNotAvailable,
    ConnectionRefused,
    ConnectionReset,
    TimedOut,
    EndOfStream,
    Interrupted,
    PermissionDenied,
    Unsupported,
    ResourceExhausted,
    ProviderFailure(UInt32),
}

pub enum DnsError {
    InvalidHost,
    NotFound,
    TemporaryFailure,
    TooManyResults,
    UnsupportedAddressFamily,
    Unsupported,
    Other(UInt32),
}

const ZERO: UInt8 = 48u8;
const A_LOWER: UInt8 = 97u8;
const PROVIDER_STATUS_OTHER: UInt32 = 11u32;
const DNS_STATUS_OTHER: UInt32 = 107u32;
const DNS_RECORD_WIDTH: UInt64 = 22u64;
const DNS_MAX_HOST_BYTES: UInt64 = 253u64;
const DNS_MAX_RESULTS: UInt64 = 32u64;
const DNS_MAX_RECORD_BYTES: UInt64 = 704u64;
const DNS_FAMILY_IPV4: UInt8 = 4u8;
const DNS_FAMILY_IPV6: UInt8 = 6u8;

pub fn ipv4(a: UInt8, b: UInt8, c: UInt8, d: UInt8) -> IpAddress {
    IpAddress::V4(Ipv4Address { a: a, b: b, c: c, d: d })
}

pub fn ipv6(segments: [UInt16; 8]) -> IpAddress {
    IpAddress::V6(Ipv6Address { segments: segments })
}

pub fn socket_address(address: IpAddress, port: UInt16) -> SocketAddress {
    SocketAddress { address: address, port: port }
}

pub fn default_resolve_limits() -> ResolveLimits {
    ResolveLimits { max_host_bytes: DNS_MAX_HOST_BYTES, max_results: DNS_MAX_RESULTS }
}

impl TcpStream {
    pub fn connect(address: SocketAddress, timeout: Duration) -> Result<TcpStream, NetworkError> {
        connect(address, timeout)
    }
    pub fn read(&mut self, output: &mut [UInt8]) -> Result<UInt64, NetworkError> {
        read(self, output)
    }
    pub fn write(&mut self, input: &[UInt8]) -> Result<UInt64, NetworkError> {
        write(self, input)
    }
    pub fn write_all(&mut self, input: &[UInt8]) -> Result<(), NetworkError> {
        write_all(self, input)
    }
    pub fn set_read_timeout(&mut self, timeout: Option<Duration>) -> Result<(), NetworkError> {
        // HC4: socket timeouts.
        //
        // `None` means "no timeout" — an unbounded, blocking socket. `Some(duration)` is a bound, and
        // a ZERO duration is rejected rather than silently meaning "unbounded": zero is the one value
        // where the caller's intent is genuinely ambiguous, and guessing it wrong turns a bound into
        // its opposite. `Duration::as_nanos` returns `None` on overflow, which becomes
        // `InvalidAddress`-free `Unsupported` rather than a silent truncation.

        let nanos = timeout_nanos(timeout)?;
        match tcp_stream_set_read_timeout_raw(self, nanos) {
            Ok(_unit) => Ok(()),
            Err(error) => Err(map_network_error(error)),
        }
    }
    pub fn set_write_timeout(&mut self, timeout: Option<Duration>) -> Result<(), NetworkError> {
        let nanos = timeout_nanos(timeout)?;
        match tcp_stream_set_write_timeout_raw(self, nanos) {
            Ok(_unit) => Ok(()),
            Err(error) => Err(map_network_error(error)),
        }
    }
    pub fn shutdown_write(&mut self) -> Result<(), NetworkError> {
        Err(NetworkError::Unsupported)
    }
}

// DEV-165: this used to REFUSE every non-zero timeout with `Unsupported`, so the one connect API
// that takes a deadline had never connected to anything — it succeeded only for a zero duration,
// which reads as "no timeout" and is the opposite of what passing a `Duration` means. An HTTP
// client could carry a `connect_timeout`, pass it, and get no bound at all.
//
// A ZERO duration is rejected here rather than silently meaning "unbounded", which is the rule
// `timeout_nanos` already applies to the read and write setters: zero is the one value where the
// caller's intent is genuinely ambiguous, and guessing it wrong turns a bound into its opposite.
// A caller that wants no bound says so by name, with `connect_no_timeout`.
pub fn connect(address: SocketAddress, timeout: Duration) -> Result<TcpStream, NetworkError> {
    let nanos = timeout_nanos(Some(timeout))?;
    let text = socket_address_text(&address);
    match tcp_stream_connect_timeout_raw(text.as_str().bytes(), nanos) {
        Ok(stream) => Ok(stream),
        Err(error) => Err(map_network_error(error)),
    }
}

pub fn connect_no_timeout(address: SocketAddress) -> Result<TcpStream, NetworkError> {
    connect_socket_address(&address)
}

fn connect_socket_address(address: &SocketAddress) -> Result<TcpStream, NetworkError> {
    match tcp_stream_connect_raw(socket_address_text(address).as_str().bytes()) {
        Ok(stream) => Ok(stream),
        Err(error) => Err(map_network_error(error)),
    }
}

// RULING (CD-346): a resource-mutating operation takes `&mut`, and the compiler weakens it to the
// shared borrow the ABI wants.
//
// `AbiParam::HandleBorrowed` derives a SHARED reference, because a borrowed handle leaves ownership
// with the caller — that is an ABI fact and does not change. The question this settles is what the
// PACKAGE surface should say, and the answer is that the two need not match: `weaken_ref_to` now
// coerces `&mut R` to `&R` at the provider-call boundary (DEV-146), so a package may declare the
// stricter signature its semantics deserve.
//
// `read`, `write` and `write_all` take `&mut` because they are NOT observations: each consumes or
// produces bytes and moves the stream's position. A shared borrow would let a caller hold two
// readers of one stream, making byte-consumption order non-local and unreviewable. `&mut` makes
// the aliasing question answerable at the call site, which is the whole reason Core v1 has the
// distinction.
//
// Purely observational operations on a resource stay `&`. Nothing here is one yet.
pub fn read(stream: &mut TcpStream, output: &mut [UInt8]) -> Result<UInt64, NetworkError> {
    match tcp_stream_read_raw(stream, output) {
        Ok(count) => Ok(count),
        Err(error) => Err(map_network_error(error)),
    }
}

pub fn write(stream: &mut TcpStream, input: &[UInt8]) -> Result<UInt64, NetworkError> {
    match tcp_stream_write_raw(stream, input) {
        Ok(count) => Ok(count),
        Err(error) => Err(map_network_error(error)),
    }
}

pub fn write_all(stream: &mut TcpStream, input: &[UInt8]) -> Result<(), NetworkError> {
    let mut written: UInt64 = 0u64;
    while written < input.len() {
        let remaining = &input[written..input.len()];
        let count = write(stream, remaining)?;
        if count == 0u64 {
            return Err(NetworkError::EndOfStream);
        }
        written = written + count;
    }
    Ok(())
}

pub fn close(stream: TcpStream) -> Result<(), NetworkError> {
    // Consuming the affine resource is the close operation. MIR drop elaboration emits
    // `stark_tcp_stream_close` exactly once for this owned `TcpStream`; the raw close binding is not
    // callable from package code without creating a second destruction path.
    let _owned = stream;
    Ok(())
}

pub fn resolve(host: &String, port: UInt16, limits: ResolveLimits) -> Result<Vec<ResolvedAddress>, DnsError> {
    if host.len() == 0u64 || host.len() > limits.max_host_bytes || host.len() > DNS_MAX_HOST_BYTES {
        return Err(DnsError::InvalidHost);
    }
    if limits.max_results == 0u64 || limits.max_results > DNS_MAX_RESULTS {
        return Err(DnsError::TooManyResults);
    }
    if contains_nul(host.as_str()) {
        return Err(DnsError::InvalidHost);
    }

    let required: UInt64;
    let provider_count: UInt64;
    match dns_resolve_len_raw(host.as_str().bytes()) {
        Ok(value) => {
            required = value.0;
            provider_count = value.1;
        }
        Err(error) => {
            return Err(map_dns_error(error));
        }
    }
    if provider_count == 0u64 {
        return Err(DnsError::NotFound);
    }
    if provider_count > limits.max_results || required > DNS_MAX_RECORD_BYTES {
        return Err(DnsError::TooManyResults);
    }
    if required != provider_count * DNS_RECORD_WIDTH {
        return Err(DnsError::Other(DNS_STATUS_OTHER));
    }

    let mut buffer: [UInt8; 704] = [0u8; 704];
    let written: UInt64;
    let filled_count: UInt64;
    {
        let out = &mut buffer[0u64..required];
        match dns_resolve_fill_raw(host.as_str().bytes(), out) {
            Ok(value) => {
                written = value.0;
                filled_count = value.1;
            }
            Err(error) => {
                return Err(map_dns_error(error));
            }
        }
    }
    if written != required || filled_count != provider_count {
        return Err(DnsError::Other(DNS_STATUS_OTHER));
    }

    decode_resolved_addresses(&buffer[0u64..written], filled_count, port)
}

/// HC4: the three timeouts a client configures, kept together so a caller sets a coherent policy
/// rather than three unrelated values.
pub struct SocketTimeouts { pub connect: Duration, pub read: Duration, pub write: Duration }

/// HC4: `Option<Duration>` to the provider's nanosecond encoding.
///
/// `None` -> 0, which the provider reads as "no timeout". A zero `Some` is REFUSED: it is the only
/// value whose meaning cannot be inferred — a caller writing `Some(Duration::from_nanos(0))` may
/// mean "never wait" or may have computed zero by accident, and mapping it to "wait forever" is
/// the worst of the available guesses. Overflow converting the duration fails cleanly as
/// `Unsupported` rather than truncating.
fn timeout_nanos(timeout: Option<Duration>) -> Result<UInt64, NetworkError> {
    match timeout {
        None => Ok(0u64),
        Some(duration) => {
            if duration.is_zero() {
                return Err(NetworkError::InvalidAddress);
            }
            match duration.as_nanos() {
                Some(nanos) => {
                    if nanos == 0u64 {
                        return Err(NetworkError::InvalidAddress);
                    }
                    Ok(nanos)
                }
                None => Err(NetworkError::Unsupported),
            }
        }
    }
}

pub fn socket_address_text(address: &SocketAddress) -> String {
    let mut out = String::new();
    match address.address {
        IpAddress::V4(v4) => {
            out.push_str(u8_decimal(v4.a).as_str());
            out.push('.');
            out.push_str(u8_decimal(v4.b).as_str());
            out.push('.');
            out.push_str(u8_decimal(v4.c).as_str());
            out.push('.');
            out.push_str(u8_decimal(v4.d).as_str());
        }
        IpAddress::V6(v6) => {
            out.push('[');
            let mut i: UInt64 = 0u64;
            while i < 8u64 {
                if i > 0u64 {
                    out.push(':');
                }
                out.push_str(u16_hex(v6.segments[i]).as_str());
                i = i + 1u64;
            }
            out.push(']');
        }
    }
    out.push(':');
    out.push_str(u16_decimal(address.port).as_str());
    out
}

fn map_network_error(error: RawNetworkError) -> NetworkError {
    match error {
        RawNetworkError::ConnectionRefused => NetworkError::ConnectionRefused,
        RawNetworkError::TimedOut => NetworkError::TimedOut,
        RawNetworkError::NotFound => NetworkError::AddressNotAvailable,
        RawNetworkError::PermissionDenied => NetworkError::PermissionDenied,
        RawNetworkError::AddressInUse => NetworkError::AddressNotAvailable,
        RawNetworkError::InvalidInput => NetworkError::InvalidAddress,
        RawNetworkError::ConnectionReset => NetworkError::ConnectionReset,
        RawNetworkError::BrokenPipe => NetworkError::ConnectionReset,
        RawNetworkError::WouldBlock => NetworkError::Interrupted,
        RawNetworkError::Unsupported => NetworkError::Unsupported,
        RawNetworkError::Other => NetworkError::ProviderFailure(PROVIDER_STATUS_OTHER),
        RawNetworkError::DnsInvalidHost => NetworkError::ProviderFailure(101u32),
        RawNetworkError::DnsNotFound => NetworkError::ProviderFailure(102u32),
        RawNetworkError::DnsTemporaryFailure => NetworkError::ProviderFailure(103u32),
        RawNetworkError::DnsTooManyResults => NetworkError::ProviderFailure(104u32),
        RawNetworkError::DnsUnsupportedAddressFamily => NetworkError::ProviderFailure(105u32),
        RawNetworkError::DnsUnsupported => NetworkError::ProviderFailure(106u32),
        RawNetworkError::DnsOther => NetworkError::ProviderFailure(107u32),
    }
}

fn map_dns_error(error: RawNetworkError) -> DnsError {
    match error {
        RawNetworkError::DnsInvalidHost => DnsError::InvalidHost,
        RawNetworkError::DnsNotFound => DnsError::NotFound,
        RawNetworkError::DnsTemporaryFailure => DnsError::TemporaryFailure,
        RawNetworkError::DnsTooManyResults => DnsError::TooManyResults,
        RawNetworkError::DnsUnsupportedAddressFamily => DnsError::UnsupportedAddressFamily,
        RawNetworkError::DnsUnsupported => DnsError::Unsupported,
        RawNetworkError::DnsOther => DnsError::Other(DNS_STATUS_OTHER),
        RawNetworkError::ConnectionRefused => DnsError::Other(1u32),
        RawNetworkError::TimedOut => DnsError::Other(2u32),
        RawNetworkError::NotFound => DnsError::Other(3u32),
        RawNetworkError::PermissionDenied => DnsError::Other(4u32),
        RawNetworkError::AddressInUse => DnsError::Other(5u32),
        RawNetworkError::InvalidInput => DnsError::Other(6u32),
        RawNetworkError::ConnectionReset => DnsError::Other(7u32),
        RawNetworkError::BrokenPipe => DnsError::Other(8u32),
        RawNetworkError::WouldBlock => DnsError::Other(9u32),
        RawNetworkError::Unsupported => DnsError::Other(10u32),
        RawNetworkError::Other => DnsError::Other(11u32),
    }
}

fn decode_resolved_addresses(records: &[UInt8], count: UInt64, port: UInt16) -> Result<Vec<ResolvedAddress>, DnsError> {
    let mut out: Vec<ResolvedAddress> = Vec::new();
    let mut i: UInt64 = 0u64;
    while i < count {
        let base = i * DNS_RECORD_WIDTH;
        if base + DNS_RECORD_WIDTH > records.len() {
            return Err(DnsError::Other(DNS_STATUS_OTHER));
        }
        let family = records[base];
        let length = records[base + 1u64];
        if family == DNS_FAMILY_IPV4 && length == 4u8 {
            out.push(
                ResolvedAddress {
                    address: IpAddress::V4(
                        Ipv4Address {
                            a: records[base + 2u64],
                            b: records[base + 3u64],
                            c: records[base + 4u64],
                            d: records[base + 5u64],
                        },
                    ),
                    port: port,
                },
            );
        } else if family == DNS_FAMILY_IPV6 && length == 16u8 {
            out.push(
                ResolvedAddress {
                    address: IpAddress::V6(
                        Ipv6Address {
                            segments: [
                                u16_from_be(records[base + 2u64], records[base + 3u64]),
                                u16_from_be(records[base + 4u64], records[base + 5u64]),
                                u16_from_be(records[base + 6u64], records[base + 7u64]),
                                u16_from_be(records[base + 8u64], records[base + 9u64]),
                                u16_from_be(records[base + 10u64], records[base + 11u64]),
                                u16_from_be(records[base + 12u64], records[base + 13u64]),
                                u16_from_be(records[base + 14u64], records[base + 15u64]),
                                u16_from_be(records[base + 16u64], records[base + 17u64]),
                            ],
                        },
                    ),
                    port: port,
                },
            );
        } else {
            return Err(DnsError::UnsupportedAddressFamily);
        }
        i = i + 1u64;
    }
    Ok(out)
}

fn contains_nul(input: &str) -> Bool {
    let bytes = input.bytes();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        if bytes[i] == 0u8 {
            return true;
        }
        i = i + 1u64;
    }
    false
}

fn u16_from_be(hi: UInt8, lo: UInt8) -> UInt16 {
    hi as UInt16 << 8u16 | lo as UInt16
}

fn u8_decimal(value: UInt8) -> String {
    let mut out = String::new();
    let n = value as UInt64;
    if n >= 100u64 {
        out.push(ascii_digit(n / 100u64));
    }
    if n >= 10u64 {
        out.push(ascii_digit(n / 10u64 % 10u64));
    }
    out.push(ascii_digit(n % 10u64));
    out
}

fn u16_decimal(value: UInt16) -> String {
    let mut out = String::new();
    let n = value as UInt64;
    if n >= 10000u64 {
        out.push(ascii_digit(n / 10000u64));
    }
    if n >= 1000u64 {
        out.push(ascii_digit(n / 1000u64 % 10u64));
    }
    if n >= 100u64 {
        out.push(ascii_digit(n / 100u64 % 10u64));
    }
    if n >= 10u64 {
        out.push(ascii_digit(n / 10u64 % 10u64));
    }
    out.push(ascii_digit(n % 10u64));
    out
}

fn u16_hex(value: UInt16) -> String {
    let mut out = String::new();
    let n = value as UInt64;
    let mut started = false;
    let mut shift: Int32 = 12i32;
    while shift >= 0i32 {
        let digit = n >> shift as UInt64 & 0xFu64;
        if digit != 0u64 || started || shift == 0i32 {
            out.push(hex_digit(digit));
            started = true;
        }
        shift = shift - 4i32;
    }
    out
}

fn ascii_digit(value: UInt64) -> Char {
    char_from_ascii(ZERO + value as UInt8)
}

fn hex_digit(value: UInt64) -> Char {
    if value < 10u64 {
        ascii_digit(value)
    } else {
        char_from_ascii(A_LOWER + (value - 10u64) as UInt8)
    }
}

fn char_from_ascii(byte: UInt8) -> Char {
    if byte == 48u8 {
        '0'
    } else if byte == 49u8 {
        '1'
    } else if byte == 50u8 {
        '2'
    } else if byte == 51u8 {
        '3'
    } else if byte == 52u8 {
        '4'
    } else if byte == 53u8 {
        '5'
    } else if byte == 54u8 {
        '6'
    } else if byte == 55u8 {
        '7'
    } else if byte == 56u8 {
        '8'
    } else if byte == 57u8 {
        '9'
    } else if byte == 97u8 {
        'a'
    } else if byte == 98u8 {
        'b'
    } else if byte == 99u8 {
        'c'
    } else if byte == 100u8 {
        'd'
    } else if byte == 101u8 {
        'e'
    } else if byte == 102u8 {
        'f'
    } else {
        '?'
    }
}

mod tests;
