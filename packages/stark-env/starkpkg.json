{
  "name": "stark-env",
  "version": "0.1.0",
  "entry": "src/lib.stark",
  "distribution": { "toolchain": true },
  "capability_vocabulary": 1,
  "capabilities": ["environment-read"],
  "provider_api": {
    "errors": {
      "environment-read": "RawEnvError"
    },
    "functions": {
      "args_len_raw": {
        "capability": "environment-read",
        "symbol": "stark_env_args_len"
      },
      "args_fill_raw": {
        "capability": "environment-read",
        "symbol": "stark_env_args_fill"
      },
      "var_len_raw": {
        "capability": "environment-read",
        "symbol": "stark_env_var_len"
      },
      "var_fill_raw": {
        "capability": "environment-read",
        "symbol": "stark_env_var_fill"
      }
    }
  },
  "dependencies": {}
}
