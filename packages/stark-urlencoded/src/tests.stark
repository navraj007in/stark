use super::default_limits;
use super::parse_form;
use super::parse_query;
use super::serialize_form;
use super::serialize_query;
use super::Limits;
use super::Pair;
use super::UrlEncodedError;

fn permissive_limits() -> Limits {
    Limits {
        max_total_bytes: 8192u64,
        max_pair_count: 64u64,
        max_name_bytes: 256u64,
        max_value_bytes: 4096u64,
    }
}

fn test_query_characterization() {
    let empty = expect_query_ok(&String::from(""));
    assert_eq(empty.len(), 0u64);

    let pairs = expect_query_ok(&String::from("a=b&c=d&a=e"));
    assert_eq(pairs.len(), 3u64);
    assert_eq(pairs[0u64].name.as_str(), "a");
    assert_eq(pairs[0u64].value.as_str(), "b");
    assert_eq(pairs[2u64].value.as_str(), "e");

    let missing = expect_query_ok(&String::from("a"));
    assert_eq(missing[0u64].name.as_str(), "a");
    assert_eq(missing[0u64].value.as_str(), "");

    let empty_name = expect_query_ok(&String::from("=a"));
    assert_eq(empty_name[0u64].name.as_str(), "");
    assert_eq(empty_name[0u64].value.as_str(), "a");

    let plus = expect_query_ok(&String::from("a=b+c&space=%20&plus=%2B"));
    assert_eq(plus[0u64].value.as_str(), "b+c");
    assert_eq(plus[1u64].value.as_str(), " ");
    assert_eq(plus[2u64].value.as_str(), "+");
}

fn test_query_serialize_characterization() {
    let mut pairs = Vec::new();
    pairs.push(Pair { name: String::from("a b"), value: String::from("c&d") });
    pairs.push(Pair { name: String::from("plus"), value: String::from("+") });
    match serialize_query(pairs.as_slice(), default_limits()) {
        Ok(text) => assert_eq(text.as_str(), "a%20b=c%26d&plus=+"),
        Err(_error) => panic("query serialize failed"),
    }
}

fn test_form_characterization() {
    let empty = expect_form_ok(&String::from(""));
    assert_eq(empty.len(), 0u64);

    let pairs = expect_form_ok(&String::from("a+b=c+d&plus=%2B"));
    assert_eq(pairs.len(), 2u64);
    assert_eq(pairs[0u64].name.as_str(), "a b");
    assert_eq(pairs[0u64].value.as_str(), "c d");
    assert_eq(pairs[1u64].value.as_str(), "+");
}

fn test_form_serialize_characterization() {
    let mut pairs = Vec::new();
    pairs.push(Pair { name: String::from("a b"), value: String::from("1+2") });
    match serialize_form(pairs.as_slice(), default_limits()) {
        Ok(text) => assert_eq(text.as_str(), "a+b=1%2B2"),
        Err(_error) => panic("form serialize failed"),
    }
}

fn test_shared_limits_are_enforced() {
    let mut limits_pairs = permissive_limits();
    limits_pairs.max_pair_count = 1u64;
    match parse_query(&String::from("a=1&b=2"), limits_pairs) {
        Ok(_pairs) => panic("query pair-count limit must be enforced"),
        Err(error) => match error {
            UrlEncodedError::ExceededPairCountLimit => {}
            _other => panic("expected query pair-count limit"),
        }
    }

    let mut limits_value = permissive_limits();
    limits_value.max_value_bytes = 1u64;
    match parse_form(&String::from("a=abc"), limits_value) {
        Ok(_pairs) => panic("form value limit must be enforced"),
        Err(error) => match error {
            UrlEncodedError::ExceededValueLimit => {}
            _other => panic("expected form value limit"),
        }
    }

    match parse_query(&String::from("a=%zz"), default_limits()) {
        Ok(_pairs) => panic("invalid percent must fail"),
        Err(error) => match error {
            UrlEncodedError::PercentDecodeError(_inner) => {}
            _other => panic("expected percent decode error"),
        }
    }
}

fn test_only_the_first_equals_separates() {
    let query = expect_query_ok(&String::from("a=b=c"));
    assert_eq(query.len(), 1u64);
    assert_eq(query[0u64].name.as_str(), "a");
    assert_eq(query[0u64].value.as_str(), "b=c");

    let form = expect_form_ok(&String::from("a=b=c"));
    assert_eq(form.len(), 1u64);
    assert_eq(form[0u64].name.as_str(), "a");
    assert_eq(form[0u64].value.as_str(), "b=c");
}

fn test_empty_segments_are_preserved_as_pairs() {
    let query = expect_query_ok(&String::from("a=1&&b=2"));
    assert_eq(query.len(), 3u64);
    assert_eq(query[1u64].name.as_str(), "");
    assert_eq(query[1u64].value.as_str(), "");

    let trailing = expect_query_ok(&String::from("a=1&"));
    assert_eq(trailing.len(), 2u64);
    assert_eq(trailing[1u64].name.as_str(), "");

    let form = expect_form_ok(&String::from("a=1&&b=2"));
    assert_eq(form.len(), 3u64);
    assert_eq(form[1u64].name.as_str(), "");
}

fn test_each_parse_limit_is_enforced_separately() {
    let mut total = permissive_limits();
    total.max_total_bytes = 4u64;
    match parse_query(&String::from("a=1&b=2"), total) {
        Ok(_pairs) => panic("total-bytes limit must be enforced"),
        Err(error) => match error {
            UrlEncodedError::ExceededTotalBytesLimit => {}
            _other => panic("expected total-bytes limit"),
        }
    }

    let mut pair_count = permissive_limits();
    pair_count.max_pair_count = 1u64;
    match parse_query(&String::from("a=1&b=2"), pair_count) {
        Ok(_pairs) => panic("pair-count limit must be enforced"),
        Err(error) => match error {
            UrlEncodedError::ExceededPairCountLimit => {}
            _other => panic("expected pair-count limit"),
        }
    }

    let mut name = permissive_limits();
    name.max_name_bytes = 2u64;
    match parse_query(&String::from("abc=1"), name) {
        Ok(_pairs) => panic("name limit must be enforced"),
        Err(error) => match error {
            UrlEncodedError::ExceededNameLimit => {}
            _other => panic("expected name limit"),
        }
    }

    let mut value = permissive_limits();
    value.max_value_bytes = 2u64;
    match parse_query(&String::from("a=abc"), value) {
        Ok(_pairs) => panic("value limit must be enforced"),
        Err(error) => match error {
            UrlEncodedError::ExceededValueLimit => {}
            _other => panic("expected value limit"),
        }
    }
}

/// The limits count DECODED bytes, not the escaped input that carried them. `%41%42%43` is nine
/// bytes on the wire and three after decoding, and a `max_name_bytes` of 3 must accept it.
fn test_limits_measure_decoded_length() {
    let mut limits = permissive_limits();
    limits.max_name_bytes = 3u64;
    limits.max_value_bytes = 3u64;

    let pairs = match parse_query(&String::from("%41%42%43=%61%62%63"), limits) {
        Ok(values) => values,
        Err(_error) => panic("decoded length must be under the limit"),
    };
    assert_eq(pairs[0u64].name.as_str(), "ABC");
    assert_eq(pairs[0u64].value.as_str(), "abc");

    let mut tighter = permissive_limits();
    tighter.max_name_bytes = 2u64;
    match parse_query(&String::from("%41%42%43=1"), tighter) {
        Ok(_pairs) => panic("decoded name over the limit must fail"),
        Err(error) => match error {
            UrlEncodedError::ExceededNameLimit => {}
            _other => panic("expected name limit"),
        }
    }
}

fn test_serialize_then_parse_round_trips() {
    let mut pairs = Vec::new();
    pairs.push(Pair { name: String::from("a b"), value: String::from("c&d") });
    pairs.push(Pair { name: String::from("plus"), value: String::from("+") });

    let query_text = match serialize_query(pairs.as_slice(), default_limits()) {
        Ok(text) => text,
        Err(_error) => panic("query serialize failed"),
    };
    let query_back = expect_query_ok(&query_text);
    assert_eq(query_back.len(), 2u64);
    assert_eq(query_back[0u64].name.as_str(), "a b");
    assert_eq(query_back[0u64].value.as_str(), "c&d");
    assert_eq(query_back[1u64].value.as_str(), "+");

    let form_text = match serialize_form(pairs.as_slice(), default_limits()) {
        Ok(text) => text,
        Err(_error) => panic("form serialize failed"),
    };
    let form_back = expect_form_ok(&form_text);
    assert_eq(form_back.len(), 2u64);
    assert_eq(form_back[0u64].name.as_str(), "a b");
    assert_eq(form_back[0u64].value.as_str(), "c&d");
    assert_eq(form_back[1u64].value.as_str(), "+");
}

fn expect_query_ok(input: &String) -> Vec<Pair> {
    match parse_query(input, default_limits()) {
        Ok(pairs) => pairs,
        Err(_error) => panic("expected query parse success"),
    }
}

fn expect_form_ok(input: &String) -> Vec<Pair> {
    match parse_form(input, default_limits()) {
        Ok(pairs) => pairs,
        Err(_error) => panic("expected form parse success"),
    }
}
