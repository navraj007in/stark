// HC5 — `stark-http-core`: protocol-independent HTTP types and their invariants.
//
// Pure. No sockets, no providers, no capabilities. Everything here can be constructed, validated
// and compared without a network, which is the point: HC7's parser and HC6's serializer both need
// a settled vocabulary before either can be written, and a type that can only be tested against a
// live server is a type nobody tests.
//
// The invariants are enforced at CONSTRUCTION rather than at serialization. A `Header` that exists
// is a header that is already valid, so the serializer never has to ask — and a caller cannot
// smuggle a CRLF into a value and have it become two headers on the wire.

use stark_ascii::eq_ignore_ascii_case;
use stark_ascii::is_tchar;

pub enum HttpMethod {
    Get,
    Post,
    Put,
    Patch,
    Delete,
    Head,
    Options,
}

pub enum HttpVersion {
    Http10,
    Http11,
}

pub struct Header { pub name: String, pub value: String }

pub struct HeaderMap { pub entries: Vec<Header> }

pub struct HttpRequest {
    pub method: HttpMethod,
    pub target: String,
    pub version: HttpVersion,
    pub headers: HeaderMap,
    pub body: Vec<UInt8>,
}

pub struct HttpResponse {
    pub version: HttpVersion,
    pub status: UInt16,
    pub reason: String,
    pub headers: HeaderMap,
    pub body: Vec<UInt8>,
}

/// Every bound a caller can hit, in one place. Defaults are deliberately generous enough for real
/// APIs and small enough that a hostile peer cannot exhaust memory.
pub struct HttpLimits {
    pub max_status_line_bytes: UInt64,
    pub max_header_line_bytes: UInt64,
    pub max_header_count: UInt64,
    pub max_header_bytes: UInt64,
    pub max_body_bytes: UInt64,
    pub max_chunk_line_bytes: UInt64,
}

pub enum HttpError {
    InvalidHeaderName,
    InvalidHeaderValue,
    InvalidTarget,
    InvalidStatus,
    InvalidReason,
    DuplicateSingletonHeader,
    TooManyHeaders,
    HeadersTooLarge,
    BodyTooLarge,
}

pub fn default_limits() -> HttpLimits {
    HttpLimits {
        max_status_line_bytes: 8192u64,
        max_header_line_bytes: 8192u64,
        max_header_count: 100u64,
        max_header_bytes: 65536u64,
        max_body_bytes: 16777216u64,
        max_chunk_line_bytes: 1024u64,
    }
}

// -- byte classification -------------------------------------------------------------------

/// A header value may hold visible ASCII, space and horizontal tab. It may NOT hold CR or LF —
/// that is the injection this rejects — and it may not hold other control bytes.
fn is_value_byte(byte: UInt8) -> Bool {
    byte == 9u8 || byte >= 32u8 && byte <= 126u8
}

/// ASCII case-insensitive comparison, which is what header names use. Deliberately NOT a
/// lowercase-and-compare on `String`: `to_uppercase` is Unicode-aware, and a Unicode fold on a
/// header name would make two distinct names compare equal.
pub fn ascii_equal_ignore_case(left: &str, right: &str) -> Bool {
    eq_ignore_ascii_case(left.bytes(), right.bytes())
}

pub fn is_valid_header_name(name: &str) -> Bool {
    let bytes = name.bytes();
    let n = bytes.len();
    if n == 0u64 {
        return false;
    }
    let mut i = 0u64;
    while i < n {
        if !is_tchar(bytes[i]) {
            return false;
        }
        i = i + 1u64;
    }
    true
}

pub fn is_valid_header_value(value: &str) -> Bool {
    let bytes = value.bytes();
    let n = bytes.len();
    let mut i = 0u64;
    while i < n {
        if !is_value_byte(bytes[i]) {
            return false;
        }
        i = i + 1u64;
    }
    // Leading or trailing whitespace is not part of the value; a serializer that emitted it would
    // produce a value a parser then strips, so the two would disagree about equality.
    if n > 0u64 {
        let first = bytes[0u64];
        let last = bytes[n - 1u64];
        if first == 32u8 || first == 9u8 || last == 32u8 || last == 9u8 {
            return false;
        }
    }
    true
}

/// A request target must be a single non-empty run with no spaces and no CR/LF — otherwise it
/// becomes a second request line on the wire.
pub fn is_valid_target(target: &str) -> Bool {
    let bytes = target.bytes();
    let n = bytes.len();
    if n == 0u64 {
        return false;
    }
    let mut i = 0u64;
    while i < n {
        let byte = bytes[i];
        if byte <= 32u8 || byte == 127u8 {
            return false;
        }
        i = i + 1u64;
    }
    true
}

/// A reason phrase may be empty (HTTP/1.1 allows it) but may not carry CR/LF or other controls.
pub fn is_valid_reason(reason: &str) -> Bool {
    let bytes = reason.bytes();
    let n = bytes.len();
    let mut i = 0u64;
    while i < n {
        if !is_value_byte(bytes[i]) {
            return false;
        }
        i = i + 1u64;
    }
    true
}

pub fn is_valid_status(status: UInt16) -> Bool {
    status >= 100u16 && status <= 599u16
}

// -- headers -------------------------------------------------------------------------------

pub fn new_header_map() -> HeaderMap {
    HeaderMap { entries: Vec::new() }
}

/// Construct a validated header. This is the ONLY way to make one, which is what lets every later
/// stage assume validity instead of re-checking it.
pub fn header(name: &str, value: &str) -> Result<Header, HttpError> {
    if !is_valid_header_name(name) {
        return Err(HttpError::InvalidHeaderName);
    }
    if !is_valid_header_value(value) {
        return Err(HttpError::InvalidHeaderValue);
    }
    Ok(Header { name: String::from(name), value: String::from(value) })
}

/// Append, preserving duplicates and order. HTTP allows repeated headers and their order is
/// semantically significant for some of them, so this never de-duplicates.
pub fn append(map: &mut HeaderMap, entry: Header) {
    map.entries.push(entry);
}

pub fn append_validated(map: &mut HeaderMap, name: &str, value: &str) -> Result<Bool, HttpError> {
    let entry = header(name, value)?;
    append(map, entry);
    Ok(true)
}

pub fn header_count(map: &HeaderMap) -> UInt64 {
    map.entries.len()
}

/// Case-insensitive lookup of the FIRST match.
pub fn get_first(map: &HeaderMap, name: &str) -> Option<String> {
    let n = map.entries.len();
    let mut i = 0u64;
    while i < n {
        let entry = &map.entries[i];
        if ascii_equal_ignore_case(entry.name.as_str(), name) {
            return Some(entry.value.clone());
        }
        i = i + 1u64;
    }
    None
}

pub fn count_matching(map: &HeaderMap, name: &str) -> UInt64 {
    let n = map.entries.len();
    let mut found = 0u64;
    let mut i = 0u64;
    while i < n {
        let entry = &map.entries[i];
        if ascii_equal_ignore_case(entry.name.as_str(), name) {
            found = found + 1u64;
        }
        i = i + 1u64;
    }
    found
}

pub fn contains(map: &HeaderMap, name: &str) -> Bool {
    count_matching(map, name) > 0u64
}

/// A SINGLETON header is one where two different values is not a merge but a contradiction —
/// `Content-Length: 5` and `Content-Length: 9` cannot both be true, and a peer that accepts both
/// is a request-smuggling vector. Returning the value only when exactly one is present makes the
/// ambiguity impossible to ignore.
pub fn get_singleton(map: &HeaderMap, name: &str) -> Result<Option<String>, HttpError> {
    let matches = count_matching(map, name);
    if matches > 1u64 {
        return Err(HttpError::DuplicateSingletonHeader);
    }
    Ok(get_first(map, name))
}

/// Total wire size of the header block, used against `max_header_bytes`. Counts the `: ` and the
/// CRLF each line costs, because a limit that ignored framing would under-count by 4 bytes a line.
pub fn header_bytes(map: &HeaderMap) -> UInt64 {
    let n = map.entries.len();
    let mut total = 0u64;
    let mut i = 0u64;
    while i < n {
        let entry = &map.entries[i];
        total = total + entry.name.len() + entry.value.len() + 4u64;
        i = i + 1u64;
    }
    total
}

pub fn check_headers_within(map: &HeaderMap, limits: &HttpLimits) -> Result<Bool, HttpError> {
    if header_count(map) > limits.max_header_count {
        return Err(HttpError::TooManyHeaders);
    }
    if header_bytes(map) > limits.max_header_bytes {
        return Err(HttpError::HeadersTooLarge);
    }
    Ok(true)
}

// -- requests and responses ------------------------------------------------------------------

pub fn method_text(method: &HttpMethod) -> String {
    match *method {
        HttpMethod::Get => String::from("GET"),
        HttpMethod::Post => String::from("POST"),
        HttpMethod::Put => String::from("PUT"),
        HttpMethod::Patch => String::from("PATCH"),
        HttpMethod::Delete => String::from("DELETE"),
        HttpMethod::Head => String::from("HEAD"),
        HttpMethod::Options => String::from("OPTIONS"),
    }
}

pub fn version_text(version: &HttpVersion) -> String {
    match *version {
        HttpVersion::Http10 => String::from("HTTP/1.0"),
        HttpVersion::Http11 => String::from("HTTP/1.1"),
    }
}

/// A method with no request body by definition. The serializer uses this to decide whether a
/// `Content-Length: 0` is appropriate rather than guessing from an empty body.
pub fn method_forbids_body(method: &HttpMethod) -> Bool {
    match *method {
        HttpMethod::Get => true,
        HttpMethod::Head => true,
        HttpMethod::Options => true,
        HttpMethod::Delete => false,
        HttpMethod::Post => false,
        HttpMethod::Put => false,
        HttpMethod::Patch => false,
    }
}

pub fn request(
    method: HttpMethod,
    target: &str,
    version: HttpVersion,
    headers: HeaderMap,
    body: Vec<UInt8>,
) -> Result<HttpRequest, HttpError> {
    if !is_valid_target(target) {
        return Err(HttpError::InvalidTarget);
    }
    Ok(
        HttpRequest {
            method: method,
            target: String::from(target),
            version: version,
            headers: headers,
            body: body,
        },
    )
}

pub fn response(
    version: HttpVersion,
    status: UInt16,
    reason: &str,
    headers: HeaderMap,
    body: Vec<UInt8>,
) -> Result<HttpResponse, HttpError> {
    if !is_valid_status(status) {
        return Err(HttpError::InvalidStatus);
    }
    if !is_valid_reason(reason) {
        return Err(HttpError::InvalidReason);
    }
    Ok(
        HttpResponse {
            version: version,
            status: status,
            reason: String::from(reason),
            headers: headers,
            body: body,
        },
    )
}

pub fn check_body_within(body: &Vec<UInt8>, limits: &HttpLimits) -> Result<Bool, HttpError> {
    if body.len() > limits.max_body_bytes {
        return Err(HttpError::BodyTooLarge);
    }
    Ok(true)
}

pub fn error_text(error: &HttpError) -> String {
    match *error {
        HttpError::InvalidHeaderName => String::from("invalid header name"),
        HttpError::InvalidHeaderValue => String::from("invalid header value"),
        HttpError::InvalidTarget => String::from("invalid request target"),
        HttpError::InvalidStatus => String::from("status code out of range"),
        HttpError::InvalidReason => String::from("invalid reason phrase"),
        HttpError::DuplicateSingletonHeader => String::from("duplicate singleton header"),
        HttpError::TooManyHeaders => String::from("too many headers"),
        HttpError::HeadersTooLarge => String::from("header block too large"),
        HttpError::BodyTooLarge => String::from("body too large"),
    }
}

// --- HC11: response body as text -------------------------------------------------------------
//
// A response body is BYTES. Turning it into a `String` is a decode that can fail, and the failure
// has to be visible: a client that silently substitutes replacement characters hands its caller a
// body that is not what the server sent, and no downstream check can tell.
//
// This lives in `stark-http-core` rather than in the client because `HttpResponse` is declared
// here — a method on your own type has no coherence question. The JSON half cannot live here, since
// `stark-http-core` must not depend on `stark-json` (a package that parses JSON should not be
// pulled in by everything that parses a header).

pub enum TextDecodeError {
    InvalidUtf8(UInt64),
}
/// The byte at this offset begins a sequence that is not valid UTF-8.

pub fn text_decode_error_text(error: &TextDecodeError) -> String {
    match *error {
        TextDecodeError::InvalidUtf8(offset) => {
            let mut out = String::from("body is not valid UTF-8 at byte ");
            out.push_str(u64_decimal(offset).as_str());
            out
        }
    }
}

/// A continuation byte, `10xxxxxx`.
fn is_continuation(byte: UInt8) -> Bool {
    byte >= 128u8 && byte <= 191u8
}

/// **A strict UTF-8 decoder.**
///
/// Strict is the whole point, so the accepted set is written out as explicit ranges rather than as
/// "leading byte, then N continuations". That shorter form accepts three things it must not:
///
///   overlong forms      `C0 80` for NUL, which security checks that scan the decoded text miss
///   surrogates          `ED A0 80`..`ED BF BF`, which are not scalar values
///   out of range        anything above `U+10FFFF`
///
/// Each is a documented source of parser-differential bugs — two components disagreeing about what
/// a byte string means is how a filter gets bypassed — so the ranges below encode the RFC 3629
/// table directly.
/// The shape a leading byte announces: `(width, first-continuation low, high, initial code bits)`.
///
/// A separate function with early `return`s rather than an `if`/`else if` chain assigning four
/// pre-declared locals — definite-assignment analysis does not see through that chain and reports
/// every one of them as possibly-uninitialised.
fn utf8_lead(b0: UInt8) -> Option<(UInt64, UInt8, UInt8, UInt32)> {
    if b0 <= 127u8 {
        return Some((1u64, 0u8, 0u8, b0 as UInt32));
    }
    if b0 >= 194u8 && b0 <= 223u8 {
        return Some((2u64, 128u8, 191u8, (b0 - 192u8) as UInt32));
    }
    if b0 == 224u8 {
        // Bounded BELOW at A0: 80-9F here would be an overlong two-byte form.
        return Some((3u64, 160u8, 191u8, (b0 - 224u8) as UInt32));
    }
    if b0 == 237u8 {
        // Bounded ABOVE at 9F: A0-BF here encodes a surrogate, which is not a scalar value.
        return Some((3u64, 128u8, 159u8, (b0 - 224u8) as UInt32));
    }
    if b0 >= 225u8 && b0 <= 239u8 {
        return Some((3u64, 128u8, 191u8, (b0 - 224u8) as UInt32));
    }
    if b0 == 240u8 {
        // Bounded below at 90: 80-8F would be an overlong three-byte form.
        return Some((4u64, 144u8, 191u8, (b0 - 240u8) as UInt32));
    }
    if b0 == 244u8 {
        // Bounded above at 8F: anything higher exceeds U+10FFFF.
        return Some((4u64, 128u8, 143u8, (b0 - 240u8) as UInt32));
    }
    if b0 >= 241u8 && b0 <= 243u8 {
        return Some((4u64, 128u8, 191u8, (b0 - 240u8) as UInt32));
    }
    // C0, C1 (overlong two-byte leads), F5-FF (beyond U+10FFFF), and every bare continuation byte.
    None
}

/// **A strict UTF-8 decoder.**
///
/// Strict is the whole point, so the accepted set is written out as explicit ranges in
/// [`utf8_lead`] rather than as "leading byte, then N continuations". That shorter form accepts
/// three things it must not:
///
///   overlong forms      `C0 80` for NUL, which security checks scanning the decoded text miss
///   surrogates          `ED A0 80`..`ED BF BF`, which are not scalar values
///   out of range        anything above `U+10FFFF`
///
/// Each is a documented source of parser-differential bugs — two components disagreeing about what
/// a byte string means is how a filter gets bypassed — so the ranges encode RFC 3629's table
/// directly.
pub fn decode_utf8(bytes: &[UInt8]) -> Result<String, TextDecodeError> {
    let mut out = String::new();
    let n = bytes.len();
    let mut i: UInt64 = 0u64;
    while i < n {
        let lead: (UInt64, UInt8, UInt8, UInt32);
        match utf8_lead(bytes[i]) {
            Some(value) => {
                lead = value;
            }
            None => {
                return Err(TextDecodeError::InvalidUtf8(i));
            }
        }
        let width = lead.0;
        let lo = lead.1;
        let hi = lead.2;
        let mut code = lead.3;

        if i + width > n {
            return Err(TextDecodeError::InvalidUtf8(i));
        }
        let mut k: UInt64 = 1u64;
        while k < width {
            let b = bytes[i + k];
            // The FIRST continuation carries the range restriction that excludes overlongs and
            // surrogates; the rest are plain continuations.
            let ok = if k == 1u64 {
                b >= lo && b <= hi
            } else {
                is_continuation(b)
            };
            if !ok {
                return Err(TextDecodeError::InvalidUtf8(i));
            }
            code = code << 6u32 | (b - 128u8) as UInt32;
            k = k + 1u64;
        }

        match Char::from_u32(code) {
            Some(ch) => {
                out.push(ch);
            }
            None => {
                // Unreachable: the ranges above already exclude every non-scalar value. Reported
                // rather than asserted, because a decoder that traps on its own bug is worse to
                // operate than one that says the input was bad.
                return Err(TextDecodeError::InvalidUtf8(i));
            }
        }
        i = i + width;
    }
    Ok(out)
}

fn u64_decimal(value: UInt64) -> String {
    if value == 0u64 {
        return String::from("0");
    }
    let mut digits: [UInt8; 20] = [0u8; 20];
    let mut count: UInt64 = 0u64;
    let mut n = value;
    while n > 0u64 {
        digits[count] = (n % 10u64) as UInt8;
        n = n / 10u64;
        count = count + 1u64;
    }
    let mut out = String::new();
    let mut i = count;
    while i > 0u64 {
        i = i - 1u64;
        match Char::from_u32((48u8 + digits[i]) as UInt32) {
            Some(ch) => {
                out.push(ch);
            }
            None => {}
        }
    }
    out
}

impl HttpResponse {
    pub fn body_text(&self) -> Result<String, TextDecodeError> {
        /// The body decoded as UTF-8 text.
        ///
        /// Strict: an invalid sequence is an ERROR, not a replacement character. A client that
        /// substitutes silently hands its caller a body that differs from what the server sent, and
        /// nothing downstream can detect it.

        decode_utf8(&self.body[0u64..self.body.len()])
    }
}

mod tests;
