// CD-348 — the EXECUTED LIFECYCLE for `stark-net`'s `TcpStream` resource.
//
// The qualification script starts a loopback echo listener on 127.0.0.1:39187 before running this
// binary, so every step below is DETERMINISTIC RUNTIME EVIDENCE rather than a compiled-but-untaken
// branch. That distinction is the whole point of this file: CD-347's first version connected to a
// port expected to refuse, which proved the surface lowered, linked and started — but never
// acquired a stream, so `write`, `read`, `close` and drop-release were compiled and never run.
//
// Two lifecycles are exercised, because the two release paths are different machinery:
//
//   acquire -> write -> read -> EXPLICIT close      the affine release the package exposes
//   acquire -> write -> IMPLICIT drop release       MIR drop elaboration emitting the close
//
// If the peer is not there, this FAILS. It does not fall back to a negative path — a gate that
// silently degrades to "the error branch ran" is the gate CD-345 already caught.

use stark_net::close;
use stark_net::connect_no_timeout;
use stark_net::ipv4;
use stark_net::read;
use stark_net::socket_address;
use stark_net::default_resolve_limits;
use stark_time::duration_seconds;
use stark_net::resolve;
use stark_net::write_all;
use stark_net::SocketAddress;
use stark_net::TcpStream;

fn peer() -> SocketAddress {
    socket_address(ipv4(127u8, 0u8, 0u8, 1u8), 39187u16)
}

// ACQUIRE -> USE (write + read) -> EXPLICIT CLOSE.
//
// `write_all` and `read` take `&mut TcpStream` and forward to raw bindings whose derived
// signatures take a SHARED borrow. That coercion is DEV-146: before CD-346 this did not build.
fn acquire_use_and_close_explicitly() {
    match connect_no_timeout(peer()) {
        Ok(stream) => {
            let mut owned = stream;
            match write_all(&mut owned, "PING\n".bytes()) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: write_all to the echo peer failed");
                }
            }
            let mut buffer: [UInt8; 32] = [0u8; 32];
            let echoed: UInt64;
            {
                let output = &mut buffer[0u64..32u64];
                match read(&mut owned, output) {
                    Ok(count) => {
                        echoed = count;
                    }
                    Err(_error) => {
                        panic("resource consumer: read from the echo peer failed");
                    }
                }
            }
            if echoed != 5u64 {
                panic("resource consumer: echo length mismatch");
            }
            match close(owned) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: explicit close failed");
                }
            }
        }
        Err(_error) => {
            panic("resource consumer: the echo peer must be listening; see CD-348");
        }
    }
}

// ACQUIRE -> USE -> IMPLICIT RELEASE BY DROP.
//
// No `close` call. The stream goes out of scope holding a live handle, and MIR drop elaboration
// must emit `stark_tcp_stream_close` exactly once. A second close, or none, is observable: the
// provider aborts on a handle it did not expect, so a non-zero exit here IS the failure signal.
fn acquire_use_and_let_drop_release() {
    match connect_no_timeout(peer()) {
        Ok(stream) => {
            let mut owned = stream;
            match write_all(&mut owned, "DROP\n".bytes()) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: write_all before drop release failed");
                }
            }
        }
        Err(_error) => {
            panic("resource consumer: the echo peer must be listening; see CD-348");
        }
    }
}

// HC3 — the `dns` capability, which is FUNCTION-SHAPED rather than resource-shaped: there is no
// handle to acquire or release, so the bar (CD-348) is a SUCCESSFUL invocation of the capability
// family, not a lifecycle.
//
// `localhost` is the one name every CI host resolves without a network. A failure here is a real
// failure: it means the provider call did not reach the resolver, which is exactly the "lowered
// and linked but never executed" gap this consumer exists to close.
fn resolve_localhost() {
    match resolve(&String::from("localhost"), 80u16, default_resolve_limits()) {
        Ok(addresses) => {
            if addresses.len() == 0u64 {
                panic("resource consumer: localhost resolved to no addresses");
            }
        }
        Err(_error) => {
            panic("resource consumer: localhost must resolve; see CD-348");
        }
    }
}

// CD-355 — the METHOD surface, which nothing had ever called.
//
// `impl TcpStream` wraps the free functions above. Every one of its seven methods was declared,
// qualified and (after DEV-152) documented, and NOT ONE was called by anything in the tree. That is
// precisely where DEV-151 hid: `set_read_timeout` could not be BUILT at a call site for as long as
// no call site existed. A wrapper nobody calls is not a thinner API — it is a second
// implementation nobody has run.
//
// Each method here is required to behave like the free function it delegates to.
fn exercise_the_method_surface() {
    // `TcpStream::connect` is an ASSOCIATED function, and until DEV-148 was fixed it could not be
    // called from another package at all — which is why it stayed uncalled while every receiver
    // method around it was reachable.
    //
    // DEV-165 REPAIRED (2026-08-10). This assertion used to require FAILURE, because
    // `connect(address, timeout)` refused every non-zero timeout with `Unsupported` — so the
    // natural connect API, the one that takes a deadline, had never connected to anything. The
    // note left here said "when a connect timeout lands, this assertion fails and forces this
    // consumer to be updated". It landed, it fired, and this is that update.
    //
    // The polarity is now the right way round: a real deadline CONNECTS.
    match TcpStream::connect(peer(), duration_seconds(5u64)) {
        Ok(stream) => {
            match close(stream) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: closing a timed connect's stream failed");
                }
            }
        }
        Err(_error) => {
            panic("resource consumer: connect-with-timeout failed against a live peer");
        }
    }

    // NEGATIVE CONTROL. A ZERO duration is rejected rather than silently meaning "unbounded" —
    // zero is the one value where the caller's intent is ambiguous, and reading it as "no bound"
    // turns a deadline into its opposite. That is the same rule the read/write setters apply, and
    // a caller that wants no bound says so by name with `connect_no_timeout`.
    //
    // Without this, a repair that ignored the duration entirely would pass the case above.
    match TcpStream::connect(peer(), duration_seconds(0u64)) {
        Ok(_stream) => {
            panic("resource consumer: a zero connect timeout must be refused, not read as unbounded");
        }
        Err(_error) => {}
    }
    match connect_no_timeout(peer()) {
        Ok(stream) => {
            let mut owned = stream;

            // The two timeout setters — DEV-151's reproducer, now a call site.
            match owned.set_read_timeout(Some(duration_seconds(5u64))) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: set_read_timeout failed on a live socket");
                }
            }
            match owned.set_write_timeout(Some(duration_seconds(5u64))) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: set_write_timeout failed on a live socket");
                }
            }

            // A zero timeout is REFUSED rather than silently meaning "unbounded" — the one value
            // where guessing wrong turns a bound into its opposite.
            match owned.set_read_timeout(Some(duration_seconds(0u64))) {
                Ok(_unit) => {
                    panic("resource consumer: a zero read timeout must be refused");
                }
                Err(_error) => {}
            }

            // write / write_all / read as methods.
            match owned.write_all("PING\n".bytes()) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: TcpStream::write_all failed");
                }
            }
            let mut buffer: [UInt8; 32] = [0u8; 32];
            {
                let output = &mut buffer[0u64..32u64];
                match owned.read(output) {
                    Ok(count) => {
                        if count == 0u64 {
                            panic("resource consumer: TcpStream::read returned nothing");
                        }
                    }
                    Err(_error) => {
                        panic("resource consumer: TcpStream::read failed");
                    }
                }
            }

            // `write` (the partial-write form) on a second connection, since the echo peer reads
            // one message per connection.
            match connect_no_timeout(peer()) {
                Ok(second) => {
                    let mut other = second;
                    match other.write(" ".bytes()) {
                        Ok(count) => {
                            if count == 0u64 {
                                panic("resource consumer: TcpStream::write wrote nothing");
                            }
                        }
                        Err(_error) => {
                            panic("resource consumer: TcpStream::write failed");
                        }
                    }

                    // `shutdown_write` is declared and returns `Unsupported` — a STUB. Calling it
                    // is what makes that visible: an API that always fails is a promise the
                    // package does not keep, and it should either be implemented or removed.
                    match other.shutdown_write() {
                        Ok(_unit) => {
                            panic(
                                "resource consumer: shutdown_write claims to work now — it was a stub, so implement it or drop it",
                            );
                        }
                        Err(_error) => {}
                    }
                    match close(other) {
                        Ok(_unit) => {}
                        Err(_error) => {
                            panic("resource consumer: close of the second stream failed");
                        }
                    }
                }
                Err(_error) => {
                    panic("resource consumer: second connect to the echo peer failed");
                }
            }

            match close(owned) {
                Ok(_unit) => {}
                Err(_error) => {
                    panic("resource consumer: close after the method surface failed");
                }
            }
        }
        Err(_error) => {
            panic("resource consumer: connect for the method surface failed");
        }
    }
}

fn main() {
    acquire_use_and_close_explicitly();
    acquire_use_and_let_drop_release();
    exercise_the_method_surface();
    resolve_localhost();
    println("STARK_NET_RESOURCE_OK");
}
