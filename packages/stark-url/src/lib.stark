use stark_ascii::char_from_ascii as ascii_char_from_byte;
use stark_percent::decode as percent_decode_bytes;
use stark_percent::encode as percent_encode_bytes;
use stark_percent::PercentEncodeSet;
use stark_percent::PercentError;

pub enum UrlErrorKind {
    InvalidPercentEscape,
    InvalidUtf8,
    InvalidQueryPair,
    TooManyQueryParameters,
    InputTooLarge,
    PositionOverflow,
    InvalidScheme,
    MalformedAuthority,
    MissingHost,
    UserInfoUnsupported,
    InvalidPort,
}

pub struct UrlError { pub kind: UrlErrorKind, pub offset: UInt64 }

pub struct UrlLimits { pub max_input_bytes: UInt64, pub max_query_parameters: UInt64 }

pub struct QueryParameter { pub name: String, pub value: String }

pub struct RequestTarget { pub path: String, pub query: Vec<QueryParameter> }

pub enum UrlScheme {
    Http,
    Https,
}

pub struct Authority { pub host: String, pub port: Option<UInt16> }

pub struct Url {
    pub scheme: UrlScheme,
    pub authority: Authority,
    pub path: String,
    pub query: Option<String>,
    pub fragment: Option<String>,
}

const PERCENT: UInt8 = 37u8;
const AMPERSAND: UInt8 = 38u8;
const HASH: UInt8 = 35u8;
const SLASH: UInt8 = 47u8;
const COLON: UInt8 = 58u8;
const ZERO: UInt8 = 48u8;
const NINE: UInt8 = 57u8;
const EQUALS: UInt8 = 61u8;
const QUESTION: UInt8 = 63u8;
const AT: UInt8 = 64u8;
const OPEN_BRACKET: UInt8 = 91u8;
const CLOSE_BRACKET: UInt8 = 93u8;
const A_UPPER: UInt8 = 65u8;
const F_UPPER: UInt8 = 70u8;
const Z_UPPER: UInt8 = 90u8;
const A_LOWER: UInt8 = 97u8;
const F_LOWER: UInt8 = 102u8;
const Z_LOWER: UInt8 = 122u8;
const HYPHEN: UInt8 = 45u8;
const DOT: UInt8 = 46u8;
const UNDERSCORE: UInt8 = 95u8;
const TILDE: UInt8 = 126u8;
const U64_MAX: UInt64 = 18446744073709551615u64;

pub fn default_limits() -> UrlLimits {
    UrlLimits { max_input_bytes: 8192u64, max_query_parameters: 1024u64 }
}

pub fn percent_encode_component(input: &str) -> String {
    // `PathSegment` encodes every byte outside the unreserved set, which is exactly the
    // unreserved-only output this component encoder has always produced.
    percent_encode_bytes(input.bytes(), PercentEncodeSet::PathSegment)
}

pub fn percent_decode(input: &str) -> Result<String, UrlError> {
    decode_component_at(input, 0u64)
}

pub fn parse_request_target(input: &str) -> Result<RequestTarget, UrlError> {
    parse_request_target_with_limits(input, &default_limits())
}

impl Url {
    pub fn parse(input: &String) -> Result<Url, UrlError> {
        parse_url(input.as_str(), &default_limits())
    }
    pub fn effective_port(&self) -> UInt16 {
        match self.authority.port {
            Some(port) => port,
            None => default_port(self.scheme),
        }
    }
    pub fn origin_form_target(&self) -> String {
        let mut out = String::new();
        if self.path.len() == 0u64 {
            out.push('/');
        } else {
            out.push_str(self.path.as_str());
        }
        match self.query {
            Some(value) => {
                out.push('?');
                out.push_str(value.as_str());
            }
            None => {}
        }
        out
    }
    pub fn host_header_value(&self) -> String {
        let mut out = String::new();
        out.push_str(self.authority.host.as_str());
        match self.authority.port {
            Some(port) => {
                if port != default_port(self.scheme) {
                    out.push(':');
                    out.push_str(u16_decimal(port).as_str());
                }
            }
            None => {}
        }
        out
    }
}

pub fn parse_url(input: &str, limits: &UrlLimits) -> Result<Url, UrlError> {
    if input.len() > limits.max_input_bytes {
        return Err(error_at(UrlErrorKind::InputTooLarge, 0u64));
    }

    let bytes = input.bytes();
    let len = bytes.len();
    let mut scheme_end = len;
    let mut i: UInt64 = 0u64;
    while i < len {
        if bytes[i] == COLON {
            scheme_end = i;
            i = len;
        } else {
            i = i + 1u64;
        }
    }

    if scheme_end == len {
        return Err(error_at(UrlErrorKind::InvalidScheme, 0u64));
    }

    let scheme_text = input.substring(0u64, scheme_end);
    let mut scheme = UrlScheme::Http;
    if scheme_text == "http" {
        scheme = UrlScheme::Http;
    } else if scheme_text == "https" {
        scheme = UrlScheme::Https;
    } else {
        return Err(error_at(UrlErrorKind::InvalidScheme, 0u64));
    }

    if scheme_end + 2u64 >= len || bytes[scheme_end + 1u64] != SLASH || bytes[scheme_end + 2u64] != SLASH {
        return Err(error_at(UrlErrorKind::MalformedAuthority, scheme_end));
    }

    let authority_start = scheme_end + 3u64;
    let mut authority_end = len;
    i = authority_start;
    while i < len {
        if bytes[i] == SLASH || bytes[i] == QUESTION || bytes[i] == HASH {
            authority_end = i;
            i = len;
        } else {
            i = i + 1u64;
        }
    }

    let authority = parse_authority(input, authority_start, authority_end)?;

    let mut path_start = authority_end;
    let mut path_end = len;
    let mut query_start = len;
    let mut query_end = len;
    let mut fragment_start = len;

    i = authority_end;
    while i < len {
        if bytes[i] == HASH {
            path_end = i;
            fragment_start = i + 1u64;
            i = len;
        } else if bytes[i] == QUESTION {
            path_end = i;
            query_start = i + 1u64;
            query_end = len;
            let mut j = query_start;
            while j < len {
                if bytes[j] == HASH {
                    query_end = j;
                    fragment_start = j + 1u64;
                    j = len;
                } else {
                    j = j + 1u64;
                }
            }
            i = len;
        } else {
            i = i + 1u64;
        }
    }

    if path_start < len && bytes[path_start] != SLASH {
        path_start = path_end;
    }

    let path = String::from(input.substring(path_start, path_end));
    let query = if query_start < len {
        Some(String::from(input.substring(query_start, query_end)))
    } else {
        None
    };
    let fragment = if fragment_start < len {
        Some(String::from(input.substring(fragment_start, len)))
    } else {
        None
    };

    Ok(Url { scheme: scheme, authority: authority, path: path, query: query, fragment: fragment })
}

pub fn parse_request_target_with_limits(input: &str, limits: &UrlLimits) -> Result<RequestTarget, UrlError> {
    if input.len() > limits.max_input_bytes {
        return Err(error_at(UrlErrorKind::InputTooLarge, 0u64));
    }

    let bytes = input.bytes();
    let len = bytes.len();
    let mut query_start: UInt64 = len;
    let mut i: UInt64 = 0u64;

    while i < len {
        if bytes[i] == QUESTION {
            query_start = i;
            i = len;
        } else {
            i = i + 1u64;
        }
    }

    let path_raw = input.substring(0u64, query_start);
    let path = decode_component_at(path_raw, 0u64)?;
    let mut query: Vec<QueryParameter> = Vec::new();

    if query_start < len {
        if query_start == U64_MAX {
            return Err(error_at(UrlErrorKind::PositionOverflow, query_start));
        }
        let start = query_start + 1u64;
        query = parse_query(input, start, len, limits)?;
    }

    Ok(RequestTarget { path: path, query: query })
}

pub fn encode_query(parameters: &Vec<QueryParameter>) -> String {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;

    while i < parameters.len() {
        if i > 0u64 {
            out.push('&');
        }
        match parameters.get(i) {
            Some(parameter) => {
                out.push_str(percent_encode_component(parameter.name.as_str()).as_str());
                out.push('=');
                out.push_str(percent_encode_component(parameter.value.as_str()).as_str());
            }
            None => {
                panic("query parameter index out of bounds");
            }
        }
        i = i + 1u64;
    }

    out
}

fn parse_authority(input: &str, start: UInt64, end: UInt64) -> Result<Authority, UrlError> {
    if start >= end {
        return Err(error_at(UrlErrorKind::MissingHost, start));
    }

    let bytes = input.bytes();
    let mut i = start;
    while i < end {
        if bytes[i] == AT {
            return Err(error_at(UrlErrorKind::UserInfoUnsupported, i));
        }
        i = i + 1u64;
    }

    if bytes[start] == OPEN_BRACKET {
        return parse_ipv6_authority(input, start, end);
    }

    let mut colon_at = end;
    i = start;
    while i < end {
        if bytes[i] == COLON {
            if colon_at != end {
                return Err(error_at(UrlErrorKind::MalformedAuthority, i));
            }
            colon_at = i;
        }
        i = i + 1u64;
    }

    if colon_at == start {
        return Err(error_at(UrlErrorKind::MissingHost, start));
    }

    let host_end = colon_at;
    let host = String::from(input.substring(start, host_end));
    if host.len() == 0u64 {
        return Err(error_at(UrlErrorKind::MissingHost, start));
    }

    let port = if colon_at < end {
        Some(parse_port(input, colon_at + 1u64, end)?)
    } else {
        None
    };

    Ok(Authority { host: host, port: port })
}

fn parse_ipv6_authority(input: &str, start: UInt64, end: UInt64) -> Result<Authority, UrlError> {
    let bytes = input.bytes();
    let mut close_at = end;
    let mut i = start + 1u64;
    while i < end {
        if bytes[i] == CLOSE_BRACKET {
            close_at = i;
            i = end;
        } else {
            i = i + 1u64;
        }
    }

    if close_at == end || close_at == start + 1u64 {
        return Err(error_at(UrlErrorKind::MalformedAuthority, start));
    }

    let host = String::from(input.substring(start, close_at + 1u64));
    let mut port: Option<UInt16> = None;
    if close_at + 1u64 == end {
        port = None;
    } else if bytes[close_at + 1u64] == COLON {
        port = Some(parse_port(input, close_at + 2u64, end)?);
    } else {
        return Err(error_at(UrlErrorKind::MalformedAuthority, close_at + 1u64));
    }

    Ok(Authority { host: host, port: port })
}

fn parse_port(input: &str, start: UInt64, end: UInt64) -> Result<UInt16, UrlError> {
    if start >= end {
        return Err(error_at(UrlErrorKind::InvalidPort, start));
    }

    let bytes = input.bytes();
    let mut value: UInt64 = 0u64;
    let mut i = start;
    while i < end {
        let b = bytes[i];
        if b < ZERO || b > NINE {
            return Err(error_at(UrlErrorKind::InvalidPort, i));
        }
        value = value * 10u64 + (b - ZERO) as UInt64;
        if value > 65535u64 {
            return Err(error_at(UrlErrorKind::InvalidPort, start));
        }
        i = i + 1u64;
    }

    Ok(value as UInt16)
}

fn default_port(scheme: UrlScheme) -> UInt16 {
    match scheme {
        UrlScheme::Http => 80u16,
        UrlScheme::Https => 443u16,
    }
}

fn u16_decimal(value: UInt16) -> String {
    let mut out = String::new();
    let n = value as UInt64;
    if n >= 10000u64 {
        out.push(char_from_ascii(ZERO + (n / 10000u64) as UInt8));
    }
    if n >= 1000u64 {
        out.push(char_from_ascii(ZERO + (n / 1000u64 % 10u64) as UInt8));
    }
    if n >= 100u64 {
        out.push(char_from_ascii(ZERO + (n / 100u64 % 10u64) as UInt8));
    }
    if n >= 10u64 {
        out.push(char_from_ascii(ZERO + (n / 10u64 % 10u64) as UInt8));
    }
    out.push(char_from_ascii(ZERO + (n % 10u64) as UInt8));
    out
}

fn parse_query(input: &str, start: UInt64, end: UInt64, limits: &UrlLimits) -> Result<Vec<QueryParameter>, UrlError> {
    let bytes = input.bytes();
    let mut out: Vec<QueryParameter> = Vec::new();
    let mut pair_start = start;
    let mut i = start;
    let mut count: UInt64 = 0u64;

    while i <= end {
        if i == end || bytes[i] == AMPERSAND {
            if count >= limits.max_query_parameters {
                return Err(error_at(UrlErrorKind::TooManyQueryParameters, pair_start));
            }
            let parameter = parse_query_pair(input, pair_start, i)?;
            out.push(parameter);
            count = count + 1u64;
            if i == U64_MAX {
                return Err(error_at(UrlErrorKind::PositionOverflow, i));
            }
            pair_start = i + 1u64;
        }
        if i == U64_MAX {
            return Err(error_at(UrlErrorKind::PositionOverflow, i));
        }
        i = i + 1u64;
    }

    Ok(out)
}

fn parse_query_pair(input: &str, start: UInt64, end: UInt64) -> Result<QueryParameter, UrlError> {
    let bytes = input.bytes();
    let mut equals_at = end;
    let mut i = start;

    while i < end {
        if bytes[i] == EQUALS {
            equals_at = i;
            i = end;
        } else {
            i = i + 1u64;
        }
    }

    if equals_at == end {
        return Err(error_at(UrlErrorKind::InvalidQueryPair, start));
    }

    if equals_at == U64_MAX {
        return Err(error_at(UrlErrorKind::PositionOverflow, equals_at));
    }

    let name_raw = input.substring(start, equals_at);
    let value_raw = input.substring(equals_at + 1u64, end);
    let name = decode_component_at(name_raw, start)?;
    let value = decode_component_at(value_raw, equals_at + 1u64)?;
    Ok(QueryParameter { name: name, value: value })
}

fn decode_component_at(input: &str, base_offset: UInt64) -> Result<String, UrlError> {
    match percent_decode_bytes(input) {
        Ok(decoded) => decode_valid_utf8(&decoded, base_offset),
        Err(error) => Err(map_percent_error(error, input, base_offset)?),
    }
}

/// `Ok` carries the mapped `UrlError`; `Err` is the offset arithmetic itself overflowing.
fn map_percent_error(error: PercentError, input: &str, base_offset: UInt64) -> Result<UrlError, UrlError> {
    match error {
        PercentError::IncompleteEscape(offset) => Ok(
            error_at(UrlErrorKind::InvalidPercentEscape, checked_add(base_offset, offset)?),
        ),
        PercentError::InvalidHexDigit(offset, _byte) => {
            Ok(
                error_at(
                    UrlErrorKind::InvalidPercentEscape,
                    checked_add(base_offset, percent_escape_start(input, offset))?,
                ),
            )
        }
        PercentError::OutputTooLarge => Ok(error_at(UrlErrorKind::InputTooLarge, base_offset)),
    }
}

/// `stark-percent` reports the offset of the offending hex digit; `UrlError` reports the offset of
/// the `%` that opened the escape. The digit is the first or second byte after that `%`, so the
/// escape starts one or two bytes back.
///
/// A backwards *scan* for the nearest `%` is wrong, and was: when the invalid digit is itself a
/// `%` — `"%%41"`, `"%4%41"` — the nearest `%` behind the digit IS the digit, and the reported
/// offset named the wrong escape.
fn percent_escape_start(input: &str, digit_offset: UInt64) -> UInt64 {
    if digit_offset < 2u64 {
        return 0u64;
    }
    let bytes = input.bytes();
    if bytes[digit_offset - 1u64] == PERCENT {
        digit_offset - 1u64
    } else {
        digit_offset - 2u64
    }
}

fn decode_valid_utf8(bytes: &Vec<UInt8>, base_offset: UInt64) -> Result<String, UrlError> {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        let b0 = bytes[i];
        if b0 <= 0x7Fu8 {
            out.push(char_from_ascii(b0));
            i = i + 1u64;
        } else if b0 >= 0xC2u8 && b0 <= 0xDFu8 {
            if i + 1u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = codepoint_char(
                u32_from_u8(b0 & 0x1Fu8) << 6u32 | u32_from_u8(bytes[i + 1u64] & 0x3Fu8),
                base_offset,
                i,
            )?;
            out.push(ch);
            i = i + 2u64;
        } else if b0 == 0xE0u8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0xA0u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(
                bytes[i + 2u64],
            ) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = three_byte_char(bytes, i, base_offset)?;
            out.push(ch);
            i = i + 3u64;
        } else if b0 >= 0xE1u8 && b0 <= 0xECu8 || b0 >= 0xEEu8 && b0 <= 0xEFu8 {
            if i + 2u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(
                bytes[i + 2u64],
            ) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = three_byte_char(bytes, i, base_offset)?;
            out.push(ch);
            i = i + 3u64;
        } else if b0 == 0xEDu8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x9Fu8 || !is_continuation(
                bytes[i + 2u64],
            ) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = three_byte_char(bytes, i, base_offset)?;
            out.push(ch);
            i = i + 3u64;
        } else if b0 == 0xF0u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x90u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(
                bytes[i + 2u64],
            ) || !is_continuation(bytes[i + 3u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = four_byte_char(bytes, i, base_offset)?;
            out.push(ch);
            i = i + 4u64;
        } else if b0 >= 0xF1u8 && b0 <= 0xF3u8 {
            if i + 3u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(
                bytes[i + 2u64],
            ) || !is_continuation(bytes[i + 3u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = four_byte_char(bytes, i, base_offset)?;
            out.push(ch);
            i = i + 4u64;
        } else if b0 == 0xF4u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x8Fu8 || !is_continuation(
                bytes[i + 2u64],
            ) || !is_continuation(bytes[i + 3u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            let ch = four_byte_char(bytes, i, base_offset)?;
            out.push(ch);
            i = i + 4u64;
        } else {
            return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
        }
    }

    Ok(out)
}

fn three_byte_char(bytes: &Vec<UInt8>, i: UInt64, base_offset: UInt64) -> Result<Char, UrlError> {
    codepoint_char(
        u32_from_u8(bytes[i] & 0x0Fu8) << 12u32 | u32_from_u8(bytes[i + 1u64] & 0x3Fu8) << 6u32 | u32_from_u8(
            bytes[i + 2u64] & 0x3Fu8,
        ),
        base_offset,
        i,
    )
}

fn four_byte_char(bytes: &Vec<UInt8>, i: UInt64, base_offset: UInt64) -> Result<Char, UrlError> {
    codepoint_char(
        u32_from_u8(bytes[i] & 0x07u8) << 18u32 | u32_from_u8(bytes[i + 1u64] & 0x3Fu8) << 12u32 | u32_from_u8(
            bytes[i + 2u64] & 0x3Fu8,
        ) << 6u32 | u32_from_u8(bytes[i + 3u64] & 0x3Fu8),
        base_offset,
        i,
    )
}

fn codepoint_char(codepoint: UInt32, base_offset: UInt64, i: UInt64) -> Result<Char, UrlError> {
    match Char::from_u32(codepoint) {
        Some(ch) => Ok(ch),
        None => Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?)),
    }
}

fn u32_from_u8(value: UInt8) -> UInt32 {
    value as UInt32
}

fn checked_add(a: UInt64, b: UInt64) -> Result<UInt64, UrlError> {
    if U64_MAX - a < b {
        Err(error_at(UrlErrorKind::PositionOverflow, a))
    } else {
        Ok(a + b)
    }
}

fn error_at(kind: UrlErrorKind, offset: UInt64) -> UrlError {
    UrlError { kind: kind, offset: offset }
}

fn is_continuation(b: UInt8) -> Bool {
    b >= 0x80u8 && b <= 0xBFu8
}

fn char_from_ascii(byte: UInt8) -> Char {
    match ascii_char_from_byte(byte) {
        Some(ch) => ch,
        None => '\0',
    }
}

mod tests;
