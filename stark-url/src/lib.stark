pub enum UrlErrorKind {
    InvalidPercentEscape,
    InvalidUtf8,
    PercentDecodedNonAsciiBlocked,
    InvalidQueryPair,
    TooManyQueryParameters,
    InputTooLarge,
    PositionOverflow,
}

pub struct UrlError {
    pub kind: UrlErrorKind,
    pub offset: UInt64,
}

pub struct UrlLimits {
    pub max_input_bytes: UInt64,
    pub max_query_parameters: UInt64,
}

pub struct QueryParameter {
    pub name: String,
    pub value: String,
}

pub struct RequestTarget {
    pub path: String,
    pub query: Vec<QueryParameter>,
}

const PERCENT: UInt8 = 37u8;
const AMPERSAND: UInt8 = 38u8;
const SLASH: UInt8 = 47u8;
const ZERO: UInt8 = 48u8;
const NINE: UInt8 = 57u8;
const EQUALS: UInt8 = 61u8;
const QUESTION: UInt8 = 63u8;
const A_UPPER: UInt8 = 65u8;
const F_UPPER: UInt8 = 70u8;
const Z_UPPER: UInt8 = 90u8;
const A_LOWER: UInt8 = 97u8;
const F_LOWER: UInt8 = 102u8;
const Z_LOWER: UInt8 = 122u8;
const HYPHEN: UInt8 = 45u8;
const DOT: UInt8 = 46u8;
const UNDERSCORE: UInt8 = 95u8;
const TILDE: UInt8 = 126u8;
const U64_MAX: UInt64 = 18446744073709551615u64;

pub fn default_limits() -> UrlLimits {
    UrlLimits {
        max_input_bytes: 8192u64,
        max_query_parameters: 1024u64,
    }
}

pub fn percent_encode_component(input: &str) -> String {
    let mut out = String::new();
    let bytes = input.bytes();
    let mut i: UInt64 = 0u64;

    while i < bytes.len() {
        let b = bytes[i];
        if is_unreserved(b) {
            out.push(char_from_ascii(b));
        } else {
            out.push('%');
            out.push(hex_char((b >> 4u8) & 0x0Fu8));
            out.push(hex_char(b & 0x0Fu8));
        }
        i = i + 1u64;
    }

    out
}

pub fn percent_decode(input: &str) -> Result<String, UrlError> {
    decode_component_at(input, 0u64)
}

pub fn parse_request_target(input: &str) -> Result<RequestTarget, UrlError> {
    parse_request_target_with_limits(input, &default_limits())
}

pub fn parse_request_target_with_limits(input: &str, limits: &UrlLimits) -> Result<RequestTarget, UrlError> {
    if input.len() > limits.max_input_bytes {
        return Err(error_at(UrlErrorKind::InputTooLarge, 0u64));
    }

    let bytes = input.bytes();
    let len = bytes.len();
    let mut query_start: UInt64 = len;
    let mut i: UInt64 = 0u64;

    while i < len {
        if bytes[i] == QUESTION {
            query_start = i;
            i = len;
        } else {
            i = i + 1u64;
        }
    }

    let path_raw = input.substring(0u64, query_start);
    let path = decode_component_at(path_raw, 0u64)?;
    let mut query: Vec<QueryParameter> = Vec::new();

    if query_start < len {
        if query_start == U64_MAX {
            return Err(error_at(UrlErrorKind::PositionOverflow, query_start));
        }
        let start = query_start + 1u64;
        parse_query_into(input, start, len, limits, &mut query)?;
    }

    Ok(RequestTarget { path: path, query: query.clone() })
}

pub fn encode_query(parameters: &Vec<QueryParameter>) -> String {
    let mut out = String::new();
    let mut i: UInt64 = 0u64;

    while i < parameters.len() {
        if i > 0u64 {
            out.push('&');
        }
        out.push_str(percent_encode_component(parameters[i].name.as_str()).as_str());
        out.push('=');
        out.push_str(percent_encode_component(parameters[i].value.as_str()).as_str());
        i = i + 1u64;
    }

    out
}

fn parse_query_into(
    input: &str,
    start: UInt64,
    end: UInt64,
    limits: &UrlLimits,
    out: &mut Vec<QueryParameter>,
) -> Result<(), UrlError> {
    let bytes = input.bytes();
    let mut pair_start = start;
    let mut i = start;

    while i <= end {
        if i == end || bytes[i] == AMPERSAND {
            if out.len() >= limits.max_query_parameters {
                return Err(error_at(UrlErrorKind::TooManyQueryParameters, pair_start));
            }
            parse_query_pair(input, pair_start, i, out)?;
            if i == U64_MAX {
                return Err(error_at(UrlErrorKind::PositionOverflow, i));
            }
            pair_start = i + 1u64;
        }
        if i == U64_MAX {
            return Err(error_at(UrlErrorKind::PositionOverflow, i));
        }
        i = i + 1u64;
    }

    Ok(())
}

fn parse_query_pair(input: &str, start: UInt64, end: UInt64, out: &mut Vec<QueryParameter>) -> Result<(), UrlError> {
    let bytes = input.bytes();
    let mut equals_at = end;
    let mut i = start;

    while i < end {
        if bytes[i] == EQUALS {
            equals_at = i;
            i = end;
        } else {
            i = i + 1u64;
        }
    }

    if equals_at == end {
        return Err(error_at(UrlErrorKind::InvalidQueryPair, start));
    }

    if equals_at == U64_MAX {
        return Err(error_at(UrlErrorKind::PositionOverflow, equals_at));
    }

    let name_raw = input.substring(start, equals_at);
    let value_raw = input.substring(equals_at + 1u64, end);
    let name = decode_component_at(name_raw, start)?;
    let value = decode_component_at(value_raw, equals_at + 1u64)?;
    out.push(QueryParameter { name: name, value: value });
    Ok(())
}

fn decode_component_at(input: &str, base_offset: UInt64) -> Result<String, UrlError> {
    let bytes = input.bytes();
    let mut decoded: Vec<UInt8> = Vec::new();
    let mut out = String::new();
    let mut i: UInt64 = 0u64;

    while i < bytes.len() {
        let b = bytes[i];
        if b == PERCENT {
            if i + 2u64 >= bytes.len() {
                return Err(error_at(UrlErrorKind::InvalidPercentEscape, checked_add(base_offset, i)?));
            }
            let hi = hex_value(bytes[i + 1u64]);
            let lo = hex_value(bytes[i + 2u64]);
            match hi {
                None => {
                    return Err(error_at(UrlErrorKind::InvalidPercentEscape, checked_add(base_offset, i)?));
                }
                Some(hi_value) => {
                    match lo {
                        None => {
                            return Err(error_at(UrlErrorKind::InvalidPercentEscape, checked_add(base_offset, i)?));
                        }
                        Some(lo_value) => {
                            let decoded_byte = (hi_value << 4u8) | lo_value;
                            decoded.push(decoded_byte);
                        }
                    }
                }
            }
            i = i + 3u64;
        } else {
            decoded.push(b);
            i = i + 1u64;
        }
    }

    validate_utf8(&decoded, base_offset)?;
    let mut j: UInt64 = 0u64;
    while j < decoded.len() {
        if decoded[j] > 0x7Fu8 {
            return Err(error_at(UrlErrorKind::PercentDecodedNonAsciiBlocked, checked_add(base_offset, j)?));
        }
        out.push(char_from_ascii(decoded[j]));
        j = j + 1u64;
    }

    Ok(out)
}

fn validate_utf8(bytes: &Vec<UInt8>, base_offset: UInt64) -> Result<(), UrlError> {
    let mut i: UInt64 = 0u64;
    while i < bytes.len() {
        let b0 = bytes[i];
        if b0 <= 0x7Fu8 {
            i = i + 1u64;
        } else if b0 >= 0xC2u8 && b0 <= 0xDFu8 {
            if i + 1u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 2u64;
        } else if b0 == 0xE0u8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0xA0u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(bytes[i + 2u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 3u64;
        } else if b0 >= 0xE1u8 && b0 <= 0xECu8 || b0 >= 0xEEu8 && b0 <= 0xEFu8 {
            if i + 2u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 3u64;
        } else if b0 == 0xEDu8 {
            if i + 2u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x9Fu8 || !is_continuation(bytes[i + 2u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 3u64;
        } else if b0 == 0xF0u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x90u8 || bytes[i + 1u64] > 0xBFu8 || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 4u64;
        } else if b0 >= 0xF1u8 && b0 <= 0xF3u8 {
            if i + 3u64 >= bytes.len() || !is_continuation(bytes[i + 1u64]) || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 4u64;
        } else if b0 == 0xF4u8 {
            if i + 3u64 >= bytes.len() || bytes[i + 1u64] < 0x80u8 || bytes[i + 1u64] > 0x8Fu8 || !is_continuation(bytes[i + 2u64]) || !is_continuation(bytes[i + 3u64]) {
                return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
            }
            i = i + 4u64;
        } else {
            return Err(error_at(UrlErrorKind::InvalidUtf8, checked_add(base_offset, i)?));
        }
    }

    Ok(())
}

fn checked_add(a: UInt64, b: UInt64) -> Result<UInt64, UrlError> {
    if U64_MAX - a < b {
        Err(error_at(UrlErrorKind::PositionOverflow, a))
    } else {
        Ok(a + b)
    }
}

fn error_at(kind: UrlErrorKind, offset: UInt64) -> UrlError {
    UrlError { kind: kind, offset: offset }
}

fn is_unreserved(b: UInt8) -> Bool {
    b >= A_UPPER && b <= Z_UPPER ||
        b >= A_LOWER && b <= Z_LOWER ||
        b >= ZERO && b <= NINE ||
        b == HYPHEN ||
        b == DOT ||
        b == UNDERSCORE ||
        b == TILDE
}

fn is_continuation(b: UInt8) -> Bool {
    b >= 0x80u8 && b <= 0xBFu8
}

fn hex_value(b: UInt8) -> Option<UInt8> {
    if b >= ZERO && b <= NINE {
        Some(b - ZERO)
    } else if b >= A_UPPER && b <= F_UPPER {
        Some(b - A_UPPER + 10u8)
    } else if b >= A_LOWER && b <= F_LOWER {
        Some(b - A_LOWER + 10u8)
    } else {
        None
    }
}

fn hex_char(value: UInt8) -> Char {
    if value < 10u8 {
        char_from_ascii(ZERO + value)
    } else {
        char_from_ascii(A_UPPER + value - 10u8)
    }
}

fn char_from_ascii(byte: UInt8) -> Char {
    if byte == 0u8 {
        '\0'
    } else if byte == 9u8 {
        '\t'
    } else if byte == 10u8 {
        '\n'
    } else if byte == 13u8 {
        '\r'
    } else if byte == 32u8 {
        ' '
    } else if byte == 33u8 {
        '!'
    } else if byte == 34u8 {
        '"'
    } else if byte == 35u8 {
        '#'
    } else if byte == 36u8 {
        '$'
    } else if byte == 37u8 {
        '%'
    } else if byte == 38u8 {
        '&'
    } else if byte == 39u8 {
        '\''
    } else if byte == 40u8 {
        '('
    } else if byte == 41u8 {
        ')'
    } else if byte == 42u8 {
        '*'
    } else if byte == 43u8 {
        '+'
    } else if byte == 44u8 {
        ','
    } else if byte == 45u8 {
        '-'
    } else if byte == 46u8 {
        '.'
    } else if byte == 47u8 {
        '/'
    } else if byte >= 48u8 && byte <= 57u8 {
        if byte == 48u8 {
            '0'
        } else if byte == 49u8 {
            '1'
        } else if byte == 50u8 {
            '2'
        } else if byte == 51u8 {
            '3'
        } else if byte == 52u8 {
            '4'
        } else if byte == 53u8 {
            '5'
        } else if byte == 54u8 {
            '6'
        } else if byte == 55u8 {
            '7'
        } else if byte == 56u8 {
            '8'
        } else {
            '9'
        }
    } else if byte == 58u8 {
        ':'
    } else if byte == 59u8 {
        ';'
    } else if byte == 60u8 {
        '<'
    } else if byte == 61u8 {
        '='
    } else if byte == 62u8 {
        '>'
    } else if byte == 63u8 {
        '?'
    } else if byte == 64u8 {
        '@'
    } else if byte >= 65u8 && byte <= 90u8 {
        if byte == 65u8 {
            'A'
        } else if byte == 66u8 {
            'B'
        } else if byte == 67u8 {
            'C'
        } else if byte == 68u8 {
            'D'
        } else if byte == 69u8 {
            'E'
        } else if byte == 70u8 {
            'F'
        } else if byte == 71u8 {
            'G'
        } else if byte == 72u8 {
            'H'
        } else if byte == 73u8 {
            'I'
        } else if byte == 74u8 {
            'J'
        } else if byte == 75u8 {
            'K'
        } else if byte == 76u8 {
            'L'
        } else if byte == 77u8 {
            'M'
        } else if byte == 78u8 {
            'N'
        } else if byte == 79u8 {
            'O'
        } else if byte == 80u8 {
            'P'
        } else if byte == 81u8 {
            'Q'
        } else if byte == 82u8 {
            'R'
        } else if byte == 83u8 {
            'S'
        } else if byte == 84u8 {
            'T'
        } else if byte == 85u8 {
            'U'
        } else if byte == 86u8 {
            'V'
        } else if byte == 87u8 {
            'W'
        } else if byte == 88u8 {
            'X'
        } else if byte == 89u8 {
            'Y'
        } else {
            'Z'
        }
    } else if byte >= 97u8 && byte <= 122u8 {
        if byte == 97u8 {
            'a'
        } else if byte == 98u8 {
            'b'
        } else if byte == 99u8 {
            'c'
        } else if byte == 100u8 {
            'd'
        } else if byte == 101u8 {
            'e'
        } else if byte == 102u8 {
            'f'
        } else if byte == 103u8 {
            'g'
        } else if byte == 104u8 {
            'h'
        } else if byte == 105u8 {
            'i'
        } else if byte == 106u8 {
            'j'
        } else if byte == 107u8 {
            'k'
        } else if byte == 108u8 {
            'l'
        } else if byte == 109u8 {
            'm'
        } else if byte == 110u8 {
            'n'
        } else if byte == 111u8 {
            'o'
        } else if byte == 112u8 {
            'p'
        } else if byte == 113u8 {
            'q'
        } else if byte == 114u8 {
            'r'
        } else if byte == 115u8 {
            's'
        } else if byte == 116u8 {
            't'
        } else if byte == 117u8 {
            'u'
        } else if byte == 118u8 {
            'v'
        } else if byte == 119u8 {
            'w'
        } else if byte == 120u8 {
            'x'
        } else if byte == 121u8 {
            'y'
        } else {
            'z'
        }
    } else if byte == 91u8 {
        '['
    } else if byte == 92u8 {
        '\\'
    } else if byte == 93u8 {
        ']'
    } else if byte == 94u8 {
        '^'
    } else if byte == 95u8 {
        '_'
    } else if byte == 96u8 {
        '`'
    } else if byte == 123u8 {
        '{'
    } else if byte == 124u8 {
        '|'
    } else if byte == 125u8 {
        '}'
    } else if byte == 126u8 {
        '~'
    } else {
        '\0'
    }
}

