use super::default_limits;
use super::encode_query;
use super::parse_request_target;
use super::parse_request_target_with_limits;
use super::parse_url;
use super::percent_decode;
use super::percent_encode_component;
use super::QueryParameter;
use super::RequestTarget;
use super::UrlErrorKind;
use super::UrlLimits;

fn assert_decode(input: &str, expected: &str) {
    match percent_decode(input) {
        Ok(value) => {
            if value.as_str() != expected {
                panic("decoded value mismatch");
            }
        }
        Err(_) => {
            panic("expected percent decode success");
        }
    }
}

fn assert_decode_error(input: &str, offset: UInt64) {
    match percent_decode(input) {
        Ok(_) => {
            panic("expected percent decode error");
        }
        Err(err) => {
            if err.offset != offset {
                panic("percent decode error offset mismatch");
            }
        }
    }
}

fn assert_decode_error_kind(input: &str, kind: UrlErrorKind, offset: UInt64) {
    match percent_decode(input) {
        Ok(_) => {
            panic("expected percent decode error");
        }
        Err(err) => {
            if err.offset != offset {
                panic("percent decode error offset mismatch");
            }
            if kind_code(err.kind) != kind_code(kind) {
                panic("percent decode error kind mismatch");
            }
        }
    }
}

fn assert_target_error(input: &str, kind: UrlErrorKind, offset: UInt64) {
    match parse_request_target(input) {
        Ok(_) => {
            panic("expected request target error");
        }
        Err(err) => {
            if err.offset != offset {
                panic("request target error offset mismatch");
            }
            if kind_code(err.kind) != kind_code(kind) {
                panic("request target error kind mismatch");
            }
        }
    }
}

fn kind_code(kind: UrlErrorKind) -> UInt8 {
    match kind {
        UrlErrorKind::InvalidPercentEscape => 1u8,
        UrlErrorKind::InvalidUtf8 => 2u8,
        UrlErrorKind::InvalidQueryPair => 3u8,
        UrlErrorKind::TooManyQueryParameters => 4u8,
        UrlErrorKind::InputTooLarge => 5u8,
        UrlErrorKind::PositionOverflow => 6u8,
        UrlErrorKind::InvalidScheme => 7u8,
        UrlErrorKind::MalformedAuthority => 8u8,
        UrlErrorKind::MissingHost => 9u8,
        UrlErrorKind::UserInfoUnsupported => 10u8,
        UrlErrorKind::InvalidPort => 11u8,
    }
}

fn assert_target(input: &str, path: &str, query_len: UInt64) {
    match parse_request_target(input) {
        Ok(target) => {
            if target.path.as_str() != path {
                panic("path mismatch");
            }
            if target.query.len() != query_len {
                panic("query length mismatch");
            }
        }
        Err(_) => {
            panic("expected request target parse success");
        }
    }
}

fn test_percent_encode_component() {
    if percent_encode_component("abcXYZ012-._~").as_str() != "abcXYZ012-._~" {
        panic("unreserved characters should not be encoded");
    }
    if percent_encode_component("a b/c?x=y&z").as_str() != "a%20b%2Fc%3Fx%3Dy%26z" {
        panic("reserved component characters should be encoded");
    }
    if percent_encode_component("%").as_str() != "%25" {
        panic("percent should be encoded");
    }
    if percent_encode_component("!*'();:@,/?#[]&=+$").as_str() != "%21%2A%27%28%29%3B%3A%40%2C%2F%3F%23%5B%5D%26%3D%2B%24" {
        panic("reserved character encoding mismatch");
    }
    if percent_encode_component("\n\t").as_str() != "%0A%09" {
        panic("control character encoding mismatch");
    }
}

fn test_percent_decode_strict_escapes() {
    assert_decode("a%20b", "a b");
    assert_decode("%2f%2F", "//");
    assert_decode("plain", "plain");
    assert_decode_error("%", 0u64);
    assert_decode_error("%A", 0u64);
    assert_decode_error("%GG", 0u64);
    assert_decode_error("a%0X", 1u64);
    assert_decode_error_kind("%G0", UrlErrorKind::InvalidPercentEscape, 0u64);
    assert_decode_error_kind("%0G", UrlErrorKind::InvalidPercentEscape, 0u64);
    assert_decode_error_kind("abc%", UrlErrorKind::InvalidPercentEscape, 3u64);
    assert_decode_error_kind("abc%A", UrlErrorKind::InvalidPercentEscape, 3u64);
}

fn test_percent_decode_utf8() {
    assert_decode("caf%C3%A9", "café");
    assert_decode("%E2%82%AC", "€");
    assert_decode("%F0%9F%98%80", "😀");
    assert_decode_error_kind("%C0%AF", UrlErrorKind::InvalidUtf8, 0u64);
    assert_decode_error_kind("%E0%80%80", UrlErrorKind::InvalidUtf8, 0u64);
    assert_decode_error_kind("%ED%A0%80", UrlErrorKind::InvalidUtf8, 0u64);
    assert_decode_error_kind("%F4%90%80%80", UrlErrorKind::InvalidUtf8, 0u64);
}

fn test_percent_decode_ascii_controls() {
    assert_decode("%00", "\0");
    assert_decode("%09", "\t");
    assert_decode("%0A", "\n");
    assert_decode("%0D", "\r");
    assert_decode("%1F", "\u{1f}");
    assert_decode("%7F", "\u{7f}");
}

fn test_parse_request_target_examples() {
    assert_target("/health", "/health", 0u64);
    assert_target("/users/123", "/users/123", 0u64);
    assert_target("/files/a%20b.txt", "/files/a b.txt", 0u64);
}

fn assert_query_param(target: &RequestTarget, index: UInt64, name: &str, value: &str) {
    match target.query.get(index) {
        Some(parameter) => {
            if parameter.name.as_str() != name || parameter.value.as_str() != value {
                panic("query parameter mismatch");
            }
        }
        None => {
            panic("query parameter missing");
        }
    }
}

fn test_parse_query_order_repeated_and_empty_values() {
    match parse_request_target("/search?q=stark&page=2&tag=compiler&tag=language&empty=") {
        Ok(target) => {
            if target.path.as_str() != "/search" {
                panic("query target path mismatch");
            }
            if target.query.len() != 5u64 {
                panic("query count mismatch");
            }
            assert_query_param(&target, 0u64, "q", "stark");
            assert_query_param(&target, 2u64, "tag", "compiler");
            assert_query_param(&target, 3u64, "tag", "language");
            assert_query_param(&target, 4u64, "empty", "");
        }
        Err(_) => {
            panic("expected query target parse success");
        }
    }
}

fn test_encoded_separators_are_data_after_splitting() {
    match parse_request_target("/users/a%2Fb?q=x%2Fy&eq=a%3Db&and=a%26b") {
        Ok(target) => {
            if target.path.as_str() != "/users/a/b" {
                panic("encoded slash in path data mismatch");
            }
            assert_query_param(&target, 0u64, "q", "x/y");
            assert_query_param(&target, 1u64, "eq", "a=b");
            assert_query_param(&target, 2u64, "and", "a&b");
        }
        Err(_) => {
            panic("expected encoded separator parse success");
        }
    }
}

fn test_query_splits_only_on_structural_separators() {
    match parse_request_target("/path?name=a%3Db%26c&next=x%3Fy") {
        Ok(target) => {
            if target.path.as_str() != "/path" {
                panic("path mismatch");
            }
            if target.query.len() != 2u64 {
                panic("query length mismatch");
            }
            assert_query_param(&target, 0u64, "name", "a=b&c");
            assert_query_param(&target, 1u64, "next", "x?y");
        }
        Err(_) => {
            panic("expected query separator parse success");
        }
    }
}

fn test_request_target_error_offsets() {
    assert_target_error("/a/%", UrlErrorKind::InvalidPercentEscape, 3u64);
    assert_target_error("/?a%G=1", UrlErrorKind::InvalidPercentEscape, 3u64);
    assert_target_error("/?a=x%G", UrlErrorKind::InvalidPercentEscape, 5u64);
    assert_target_error("/?missing", UrlErrorKind::InvalidQueryPair, 2u64);
    assert_target_error("/?a=%C0%AF", UrlErrorKind::InvalidUtf8, 4u64);
}

fn test_percent_decoded_utf8_in_target() {
    match parse_request_target("/caf%C3%A9?emoji=%F0%9F%98%80&currency=%E2%82%AC") {
        Ok(target) => {
            if target.path.as_str() != "/café" {
                panic("decoded unicode path mismatch");
            }
            assert_query_param(&target, 0u64, "emoji", "😀");
            assert_query_param(&target, 1u64, "currency", "€");
        }
        Err(_) => {
            panic("expected unicode target parse success");
        }
    }
}

fn test_invalid_query_pair_and_limits() {
    match parse_request_target("/search?q") {
        Err(err) => {
            if err.offset != 8u64 {
                panic("invalid query pair offset mismatch");
            }
        }
        Ok(_) => {
            panic("expected invalid query pair");
        }
    }

    let limits = UrlLimits { max_input_bytes: 4u64, max_query_parameters: 1u64 };
    match parse_request_target_with_limits("/abcd", &limits) {
        Err(_) => {}
        Ok(_) => {
            panic("expected input limit error");
        }
    }

    let larger = UrlLimits { max_input_bytes: 100u64, max_query_parameters: 1u64 };
    match parse_request_target_with_limits("/?a=1&b=2", &larger) {
        Err(err) => {
            if err.offset != 6u64 {
                panic("query parameter limit offset mismatch");
            }
        }
        Ok(_) => {
            panic("expected query parameter limit error");
        }
    }
}

fn test_encode_query() {
    let mut parameters: Vec<QueryParameter> = Vec::new();
    parameters.push(QueryParameter { name: String::from("q"), value: String::from("stark lang") });
    parameters.push(QueryParameter { name: String::from("tag"), value: String::from("compiler") });
    parameters.push(QueryParameter { name: String::from("tag"), value: String::from("ml/runtime") });
    parameters.push(QueryParameter { name: String::from("empty"), value: String::from("") });

    if encode_query(&parameters).as_str() != "q=stark%20lang&tag=compiler&tag=ml%2Fruntime&empty=" {
        panic("encoded query mismatch");
    }
}

fn test_encode_query_canonicality_and_order() {
    let mut parameters: Vec<QueryParameter> = Vec::new();
    parameters.push(QueryParameter { name: String::from(""), value: String::from("blank") });
    parameters.push(QueryParameter { name: String::from("a b"), value: String::from("x/y") });
    parameters.push(QueryParameter { name: String::from("a b"), value: String::from("x&y=z") });

    if encode_query(&parameters).as_str() != "=blank&a%20b=x%2Fy&a%20b=x%26y%3Dz" {
        panic("canonical query encoding mismatch");
    }
}

fn test_default_limits_are_available() {
    let limits = default_limits();
    if limits.max_input_bytes == 0u64 || limits.max_query_parameters == 0u64 {
        panic("default limits should be nonzero");
    }
}

fn assert_url(input: &str, host: &str, port: UInt16, target: &str, host_header: &str) {
    match parse_url(input, &default_limits()) {
        Ok(url) => {
            if url.authority.host.as_str() != host {
                panic("url host mismatch");
            }
            if url.effective_port() != port {
                panic("url effective port mismatch");
            }
            if url.origin_form_target().as_str() != target {
                panic("url origin-form target mismatch");
            }
            if url.host_header_value().as_str() != host_header {
                panic("url host header mismatch");
            }
        }
        Err(_) => {
            panic("expected url parse success");
        }
    }
}

fn assert_url_error(input: &str, kind: UrlErrorKind) {
    match parse_url(input, &default_limits()) {
        Ok(_) => {
            panic("expected url parse error");
        }
        Err(err) => {
            if kind_code(err.kind) != kind_code(kind) {
                panic("url error kind mismatch");
            }
        }
    }
}

fn test_parse_absolute_url_hostname_path_and_query() {
    assert_url("http://example.com/users/123", "example.com", 80u16, "/users/123", "example.com");
    assert_url(
        "https://api.example.com/v1/items?q=stark&limit=10",
        "api.example.com",
        443u16,
        "/v1/items?q=stark&limit=10",
        "api.example.com",
    );
}

fn test_parse_absolute_url_default_and_explicit_ports() {
    assert_url("http://example.com", "example.com", 80u16, "/", "example.com");
    assert_url("https://example.com:443/path", "example.com", 443u16, "/path", "example.com");
    assert_url("http://example.com:8080/path", "example.com", 8080u16, "/path", "example.com:8080");
}

fn test_parse_absolute_url_ipv4_ipv6_and_fragment() {
    assert_url(
        "http://127.0.0.1:8080/health#debug",
        "127.0.0.1",
        8080u16,
        "/health",
        "127.0.0.1:8080",
    );
    assert_url(
        "https://[2001:db8::1]/v1?q=x#frag",
        "[2001:db8::1]",
        443u16,
        "/v1?q=x",
        "[2001:db8::1]",
    );
    assert_url("http://[::1]:8000", "[::1]", 8000u16, "/", "[::1]:8000");
}

fn test_parse_absolute_url_entry_point() {
    match parse_url("https://example.com/path?x=1#ignored", &default_limits()) {
        Ok(url) => {
            if url.origin_form_target().as_str() != "/path?x=1" {
                panic("url parse target mismatch");
            }
        }
        Err(_) => {
            panic("expected url parse success");
        }
    }
}

fn test_absolute_url_rejections() {
    assert_url_error("ftp://example.com/", UrlErrorKind::InvalidScheme);
    assert_url_error("http:/example.com/", UrlErrorKind::MalformedAuthority);
    assert_url_error("http:///path", UrlErrorKind::MissingHost);
    assert_url_error("http://user@example.com/", UrlErrorKind::UserInfoUnsupported);
    assert_url_error("http://example.com:", UrlErrorKind::InvalidPort);
    assert_url_error("http://example.com:abc/", UrlErrorKind::InvalidPort);
    assert_url_error("http://example.com:70000/", UrlErrorKind::InvalidPort);
    assert_url_error("http://[::1", UrlErrorKind::MalformedAuthority);

    let limits = UrlLimits { max_input_bytes: 8u64, max_query_parameters: 1u64 };
    match parse_url("http://example.com", &limits) {
        Err(err) => {
            if kind_code(err.kind) != kind_code(UrlErrorKind::InputTooLarge) {
                panic("oversized url error kind mismatch");
            }
        }
        Ok(_) => {
            panic("expected oversized url error");
        }
    }
}

// CD-355: `Url::parse` CANNOT be exercised here. DEV-148 makes an associated function unresolvable
// across any module boundary, and `tests` is a submodule — so `Url::parse(&input)` does not compile
// even inside its own package. It is recorded as `surface_blocked` in the qualification gate, which
// refuses that record the moment the item becomes callable. Write the test then, not before: a test
// that cannot compile is worse than an absent one.
