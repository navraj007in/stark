{
  "name": "stark-net",
  "version": "0.1.0",
  "entry": "src/lib.stark",
  "capabilities": [
    "tcp"
  ],
  "dependencies": {
    "stark_time": { "package": "stark-time", "path": "../stark-time", "version": "0.1.0" }
  },
  "provider_api": {
    "errors": {
      "tcp": "RawNetworkError"
    },
    "resources": {
      "TcpStream": {
        "capability": "tcp",
        "resource": "tcp_stream"
      }
    },
    "functions": {
      "tcp_stream_connect_raw": {
        "capability": "tcp",
        "symbol": "stark_tcp_stream_connect"
      },
      "tcp_stream_read_raw": {
        "capability": "tcp",
        "symbol": "stark_tcp_stream_read"
      },
      "tcp_stream_write_raw": {
        "capability": "tcp",
        "symbol": "stark_tcp_stream_write"
      },
      "tcp_stream_close_raw": {
        "capability": "tcp",
        "symbol": "stark_tcp_stream_close"
      }
    }
  }
}
